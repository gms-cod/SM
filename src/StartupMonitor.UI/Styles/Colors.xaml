<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Базовые цвета (совместимость) -->
    <Color x:Key="BackgroundDark">#101721</Color>
    <Color x:Key="CardBackgroundDark">#16202E</Color>
    <Color x:Key="SidebarDark">#0D131C</Color>
    <Color x:Key="TextPrimaryDark">#F8FAFC</Color>
    <Color x:Key="TextSecondaryDark">#94A3B8</Color>
    <Color x:Key="AccentDark">#00D2D3</Color>
    <Color x:Key="EnabledGreen">#10B981</Color>
    <Color x:Key="DisabledGray">#64748B</Color>
    <Color x:Key="BlockedRed">#EF4444</Color>

    <Color x:Key="BackgroundLight">#F3F6FA</Color>
    <Color x:Key="CardBackgroundLight">#FFFFFF</Color>
    <Color x:Key="SidebarLight">#FFFFFF</Color>
    <Color x:Key="TextPrimaryLight">#0F172A</Color>
    <Color x:Key="TextSecondaryLight">#64748B</Color>
    <Color x:Key="AccentLight">#0078D4</Color>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- Fluent Win11 Gradients & Glass Brushes                             -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <!-- Фоновая кисть окна (полупрозрачный тёмный графитово-синий #D00E141E под Mica) -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#D00E141E" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#800D131C" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="#800D131C" />
    <SolidColorBrush x:Key="SidebarBorderBrush" Color="#28FFFFFF" />

    <!-- Градиент логотипа-щита (Cyan -> Blue) -->
    <LinearGradientBrush x:Key="ShieldGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#00D2D3" Offset="0.0" />
        <GradientStop Color="#0078D4" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Неоновый нижний кант первой карточки (Cyan -> Azure) -->
    <LinearGradientBrush x:Key="CardNeonAccentBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00F2FE" Offset="0.0" />
        <GradientStop Color="#4FACFE" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Активная кнопка фильтра (Неоновый градиент) -->
    <LinearGradientBrush x:Key="FilterPillActiveBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00D2D3" Offset="0.0" />
        <GradientStop Color="#0284C7" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Маркер активного пункта бокового меню -->
    <LinearGradientBrush x:Key="NavActiveMarkerBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00F2FE" Offset="0.0" />
        <GradientStop Color="#00D2D3" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Фоновые переливы Aurora Glow для тёмной темы (насыщенный красивый перелив) -->
    <RadialGradientBrush x:Key="AuroraGlowBottomLeftBrush" Center="0.12,0.88" RadiusX="0.75" RadiusY="0.75">
        <GradientStop Color="#4D00D2D3" Offset="0.0" />
        <GradientStop Color="#2A0078D4" Offset="0.4" />
        <GradientStop Color="#10002545" Offset="0.7" />
        <GradientStop Color="#00000000" Offset="1.0" />
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="AuroraGlowTopRightBrush" Center="0.88,0.12" RadiusX="0.65" RadiusY="0.65">
        <GradientStop Color="#3D0078D4" Offset="0.0" />
        <GradientStop Color="#2000D2D3" Offset="0.45" />
        <GradientStop Color="#0A002040" Offset="0.75" />
        <GradientStop Color="#00000000" Offset="1.0" />
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="AuroraGlowCenterBrush" Center="0.5,0.2" RadiusX="0.6" RadiusY="0.6">
        <GradientStop Color="#250078D4" Offset="0.0" />
        <GradientStop Color="#1200D2D3" Offset="0.5" />
        <GradientStop Color="#00000000" Offset="1.0" />
    </RadialGradientBrush>

    <!-- Стеклянные карточки (Glassmorphism с повышенной контрастностью) -->
    <LinearGradientBrush x:Key="GlassCardBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#24FFFFFF" Offset="0.0" />
        <GradientStop Color="#0EFFFFFF" Offset="1.0" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="GlassCardBorderBrush" Color="#40FFFFFF" />

    <!-- Бейджи (Pills) -->
    <!-- Зеленый бейдж (+3, Stable) -->
    <SolidColorBrush x:Key="BadgeGreenBackgroundBrush" Color="#2610B981" />
    <SolidColorBrush x:Key="BadgeGreenBorderBrush" Color="#4D10B981" />
    <SolidColorBrush x:Key="BadgeGreenTextBrush" Color="#34D399" />

    <!-- Синий бейдж (Verified Publisher, Stable) -->
    <SolidColorBrush x:Key="BadgeBlueBackgroundBrush" Color="#263B82F6" />
    <SolidColorBrush x:Key="BadgeBlueBorderBrush" Color="#4D3B82F6" />
    <SolidColorBrush x:Key="BadgeBlueTextBrush" Color="#60A5FA" />

    <!-- Оранжевый/Желтый бейдж (Med, Low) -->
    <SolidColorBrush x:Key="BadgeOrangeBackgroundBrush" Color="#26F59E0B" />
    <SolidColorBrush x:Key="BadgeOrangeBorderBrush" Color="#4DF59E0B" />
    <SolidColorBrush x:Key="BadgeOrangeTextBrush" Color="#FBBF24" />

    <!-- Красный бейдж (+1, High, Blocked) -->
    <SolidColorBrush x:Key="BadgeRedBackgroundBrush" Color="#26EF4444" />
    <SolidColorBrush x:Key="BadgeRedBorderBrush" Color="#4DEF4444" />
    <SolidColorBrush x:Key="BadgeRedTextBrush" Color="#F87171" />

    <!-- Таблица и элементы строк (высокий контраст разделителей и фокуса) -->
    <LinearGradientBrush x:Key="TableContainerBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1CFFFFFF" Offset="0.0" />
        <GradientStop Color="#0AFFFFFF" Offset="1.0" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="TableContainerBorderBrush" Color="#38FFFFFF" />
    <SolidColorBrush x:Key="TableRowBorderBrush" Color="#20FFFFFF" />
    <SolidColorBrush x:Key="TableRowHoverBrush" Color="#32FFFFFF" />

    <!-- Кнопки действий строк ("Подробнее" / "Блок") -->
    <SolidColorBrush x:Key="ActionMoreBackgroundBrush" Color="#18FFFFFF" />
    <SolidColorBrush x:Key="ActionMoreBorderBrush" Color="#3AFFFFFF" />
    <SolidColorBrush x:Key="ActionMoreTextBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="ActionMoreHoverBrush" Color="#2EFFFFFF" />

    <SolidColorBrush x:Key="ActionBlockBackgroundBrush" Color="#2EEF4444" />
    <SolidColorBrush x:Key="ActionBlockBorderBrush" Color="#66EF4444" />
    <SolidColorBrush x:Key="ActionBlockTextBrush" Color="#F87171" />
    <SolidColorBrush x:Key="ActionBlockHoverBrush" Color="#48EF4444" />

    <!-- Неактивные кнопки фильтров -->
    <SolidColorBrush x:Key="FilterPillInactiveBackgroundBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="FilterPillInactiveBorderBrush" Color="#28FFFFFF" />
    <SolidColorBrush x:Key="FilterPillInactiveTextBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="FilterPillInactiveHoverBrush" Color="#24FFFFFF" />

    <SolidColorBrush x:Key="FilterButtonInactiveBackgroundBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="FilterButtonInactiveBorderBrush" Color="#28FFFFFF" />
    <SolidColorBrush x:Key="FilterButtonInactiveForegroundBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="FilterButtonInactiveHoverBrush" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="FilterButtonInactiveHoverBorderBrush" Color="#40FFFFFF" />

    <!-- Контрастные вторичные тексты -->
    <SolidColorBrush x:Key="MutedTextBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#94A3B8" />
</ResourceDictionary>
