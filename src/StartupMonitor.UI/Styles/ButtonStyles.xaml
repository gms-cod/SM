<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Padding" Value="16 8" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Padding" Value="16 8" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style x:Key="SubtleButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8" />
    </Style>

    <Style x:Key="DangerButton" TargetType="Button">
        <Setter Property="Padding" Value="16 8" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="Background" Value="#E81123" />
    </Style>

    <!-- Кнопка "Подробнее" (More) в строке таблицы -->
    <Style x:Key="ActionMoreButton" TargetType="Button">
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="10 2" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="500" />
        <Setter Property="Foreground" Value="{DynamicResource ActionMoreTextBrush}" />
        <Setter Property="Background" Value="{DynamicResource ActionMoreBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ActionMoreBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ActionMoreHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Кнопка "Блок" (Block) в строке таблицы -->
    <Style x:Key="ActionBlockButton" TargetType="Button">
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="10 2" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="500" />
        <Setter Property="Foreground" Value="{DynamicResource ActionBlockTextBrush}" />
        <Setter Property="Background" Value="{DynamicResource ActionBlockBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ActionBlockBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ActionBlockHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Стиль кнопок фильтров таблицы (Все, Реестр, Папки, Службы, Планировщик, За 24ч, Другие) -->
    <Style x:Key="FilterTabButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="10 4" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="500" />
        <Setter Property="CornerRadius" Value="6" />
        <Style.Triggers>
            <Trigger Property="Appearance" Value="Secondary">
                <Setter Property="Background" Value="{DynamicResource FilterButtonInactiveBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource FilterButtonInactiveBorderBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource FilterButtonInactiveForegroundBrush}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Appearance" Value="Secondary" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource FilterButtonInactiveHoverBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource FilterButtonInactiveHoverBorderBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource FilterButtonInactiveForegroundBrush}" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <!-- Стиль кнопок сортировки заголовков таблицы (по левому краю) -->
    <Style x:Key="HeaderSortButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4 2" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="#94A3B8" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="600" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#15FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Стиль кнопок сортировки заголовков таблицы (по правому краю) -->
    <Style x:Key="HeaderSortButtonRightStyle" TargetType="Button" BasedOn="{StaticResource HeaderSortButtonStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Right" />
    </Style>

    <!-- Стиль компактной кнопки экспандера дерева процессов -->
    <Style x:Key="TreeExpandButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#25FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
