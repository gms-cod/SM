<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource GlassCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GlassCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- Стеклянная карточка в стиле Win11 Fluent -->
    <Style x:Key="FluentGlassCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource GlassCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GlassCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14 10" />
    </Style>

    <!-- Стили бейджей-таблеток -->
    <Style x:Key="BadgeGreenPill" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BadgeGreenBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BadgeGreenBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="6 2" />
    </Style>

    <Style x:Key="BadgeBluePill" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BadgeBlueBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BadgeBlueBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="6 2" />
    </Style>

    <Style x:Key="BadgeRedPill" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BadgeRedBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BadgeRedBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="6 2" />
    </Style>

    <Style x:Key="BadgeOrangePill" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BadgeOrangeBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BadgeOrangeBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="6 2" />
    </Style>
</ResourceDictionary>
