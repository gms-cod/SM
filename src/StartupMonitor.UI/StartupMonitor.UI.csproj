<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>StartupMonitor.UI</RootNamespace>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SupportedCultures>ru;en</SupportedCultures>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.0" />
    <PackageReference Include="SharpVectors.Reloaded" Version="1.8.6" />
    <PackageReference Include="WPF-UI" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="StartupMonitor.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StartupMonitor.Shared\StartupMonitor.Shared.csproj" />
    <Content Include="..\..\assets\icon.svg" Link="icon.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\app.ico" Link="app.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Обычная сборка не останавливает приложение; развёртывание выполняется только по явному запросу. -->
  <Target Name="PublishToSMon" AfterTargets="Build" Condition="'$(DeployToInstalledCopy)'=='true' AND '$(ExcludePublishToSMon)'!='true' AND !$(MSBuildProjectFile.Contains('_wpftmp'))">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\publish.ps1&quot; -Configuration $(Configuration)" />
  </Target>

</Project>
