<Application 
    x:Class="StartupMonitor.UI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:Wpf.Ui.Controls;assembly=Wpf.Ui"
    xmlns:converters="clr-namespace:StartupMonitor.UI.Converters"
    xmlns:services="clr-namespace:StartupMonitor.UI.Services"
    ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <!-- Крестик скрывает главное окно в трей; явный Shutdown завершает UI, сохраняя системную службу. -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="Styles/Colors.xaml" />
                <ResourceDictionary Source="Styles/Typography.xaml" />
                <ResourceDictionary Source="Styles/CardStyles.xaml" />
                <ResourceDictionary Source="Styles/ButtonStyles.xaml" />
                <ResourceDictionary Source="Styles/DataGridStyles.xaml" />
                <ResourceDictionary Source="Styles/VectorIcons.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Контраст вычисляется по фактическим кистям WPF-UI и обновляется вместе с системным акцентом. -->
            <converters:AccentButtonContrastConverter x:Key="AccentButtonContrastConverter" />
            <Style TargetType="{x:Type controls:Button}" BasedOn="{StaticResource DefaultUiButtonStyle}">
                <Style.Triggers>
                    <Trigger Property="Appearance" Value="Primary">
                        <Setter Property="Foreground">
                            <Setter.Value>
                                <MultiBinding Converter="{StaticResource AccentButtonContrastConverter}">
                                    <Binding Path="Background" RelativeSource="{RelativeSource Self}" />
                                    <Binding Path="MouseOverBackground" RelativeSource="{RelativeSource Self}" />
                                </MultiBinding>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="PressedForeground">
                            <Setter.Value>
                                <MultiBinding Converter="{StaticResource AccentButtonContrastConverter}">
                                    <Binding Path="PressedBackground" RelativeSource="{RelativeSource Self}" />
                                </MultiBinding>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Стиль навигационных элементов боковой панели -->
            <Style x:Key="NavItemStyle" TargetType="Border">
                <Setter Property="Height" Value="36" />
                <Setter Property="Margin" Value="0 2" />
                <Setter Property="Padding" Value="8 0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Background" Value="Transparent" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{ui:ThemeResource ControlFillColorSecondaryBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Настоящая кнопка сохраняет навигационный вид и предоставляет клавиатуру и UI Automation Invoke. -->
            <Style x:Key="NavButtonStyle" TargetType="Button">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Style="{StaticResource NavItemStyle}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="NavTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:StatusToBoolConverter x:Key="StatusToBoolConverter" />
            <converters:StatusToColorConverter x:Key="StatusToColorConverter" />
            <converters:LocationToIconConverter x:Key="LocationToIconConverter" />
            <converters:LocationToDisplayConverter x:Key="LocationToDisplayConverter" />
            <converters:LocationToIconStringConverter x:Key="LocationToIconStringConverter" />
            <converters:LocationToFilterLabelConverter x:Key="LocationToFilterLabelConverter" />
            <converters:StatusToDisplayConverter x:Key="StatusToDisplayConverter" />
            <converters:StatusToToggleTextConverter x:Key="StatusToToggleTextConverter" />
            <converters:FilterToAppearanceConverter x:Key="FilterToAppearanceConverter" />
            <converters:RatingToStarsConverter x:Key="RatingToStarsConverter" />
            <converters:RatingToColorConverter x:Key="RatingToColorConverter" />
            <converters:RatingToTooltipConverter x:Key="RatingToTooltipConverter" />
            <converters:TruncateConverter x:Key="TruncateConverter" />
            <converters:KasperskyIndicatorConverter x:Key="KasperskyIndicatorConverter" />
            <converters:KasperskyColorConverter x:Key="KasperskyColorConverter" />
            <converters:StatusToVisibilityConverter x:Key="StatusToVisibilityConverter" />
            <converters:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter" />
            <converters:FilePathToIconConverter x:Key="FilePathToIconConverter" />
            <converters:PublisherBadgeConverter x:Key="PublisherBadgeConverter" />
            <converters:LocationToImpactTextConverter x:Key="LocationToImpactTextConverter" />
            <converters:LocationToImpactBackgroundConverter x:Key="LocationToImpactBackgroundConverter" />
            <converters:LocationToImpactForegroundConverter x:Key="LocationToImpactForegroundConverter" />
            <converters:LocationToImpactBorderConverter x:Key="LocationToImpactBorderConverter" />
            <converters:CpuUsageToColorConverter x:Key="CpuUsageToColorConverter" />
            <converters:StartupStatusBackgroundConverter x:Key="StartupStatusBackgroundConverter" />
            <converters:StartupStatusBorderConverter x:Key="StartupStatusBorderConverter" />
            <converters:StartupStatusForegroundConverter x:Key="StartupStatusForegroundConverter" />
            <converters:ThreatLevelToBackgroundConverter x:Key="ThreatLevelToBackgroundConverter" />
            <converters:ThreatLevelToBorderConverter x:Key="ThreatLevelToBorderConverter" />
            <converters:ThreatLevelToForegroundConverter x:Key="ThreatLevelToForegroundConverter" />
            <converters:HexToBrushConverter x:Key="HexToBrushConverter" />
            <converters:ProcessStartupOriginConverter x:Key="ProcessStartupOriginConverter" />
            <converters:TreeIndentConverter x:Key="TreeIndentConverter" />
            <converters:SignatureStatusToSymbolConverter x:Key="SignatureStatusToSymbolConverter" />
            <converters:SignatureStatusToColorConverter x:Key="SignatureStatusToColorConverter" />
            <converters:SignatureStatusToBackgroundConverter x:Key="SignatureStatusToBackgroundConverter" />
            <converters:SignatureStatusToBorderConverter x:Key="SignatureStatusToBorderConverter" />
            <converters:SignatureStatusToTooltipConverter x:Key="SignatureStatusToTooltipConverter" />
            <x:Static Member="services:LocalizationService.Instance" x:Key="Loc" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
