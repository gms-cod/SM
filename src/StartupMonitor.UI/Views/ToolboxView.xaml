<UserControl
    x:Class="StartupMonitor.UI.Views.ToolboxView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Background="{ui:ThemeResource ApplicationBackgroundBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Верхняя карточка: заголовок и краткое описание ===== -->
        <ui:Card Grid.Row="0" Margin="0,0,0,12" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Иконка инструментов -->
                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10"
                        Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                        Margin="0,0,14,0" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Wrench24" FontSize="22"
                                   Foreground="{ui:ThemeResource AccentTextFillColorPrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!-- Заголовок и подзаголовок -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ToolboxTitle, Source={StaticResource Loc}}"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="{Binding ToolboxSubtitle, Source={StaticResource Loc}}"
                               FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                               Margin="0,2,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </ui:Card>

        <!-- ===== Вкладки инструментов ===== -->
        <TabControl Grid.Row="1" x:Name="ToolboxTabs">

            <!-- Вкладка 1: Разблокировщик файлов (File Locksmith) -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="LockClosed24" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding ToolboxTabLocksmith, Source={StaticResource Loc}}" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Панель выбора целевого файла/папки -->
                    <ui:Card Grid.Row="0" Margin="0,0,0,10" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ui:TextBox x:Name="TxtLocksmithPath" Grid.Column="0"
                                         PlaceholderText="Введите путь к файлу или папке для поиска блокирующих процессов..."
                                         Margin="0,0,8,0" />
                            <ui:Button x:Name="BtnBrowseLocksmith" Grid.Column="1"
                                       Content="Обзор..." Icon="{ui:SymbolIcon FolderOpen24}"
                                       Click="OnBrowseLocksmithClick" Margin="0,0,8,0" />
                            <ui:Button x:Name="BtnFindLocks" Grid.Column="2"
                                       Content="Найти блокировки" Appearance="Primary" Icon="{ui:SymbolIcon Search24}"
                                       Click="OnFindLocksClick" />
                        </Grid>
                    </ui:Card>

                    <!-- Список процессов, удерживающих файл -->
                    <ui:Card Grid.Row="1" Margin="0,0,0,10" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Статусная строка блокировок -->
                            <Border Grid.Row="0" Background="{ui:ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    BorderThickness="0,0,0,1" BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                                    Padding="12,8">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border x:Name="BadgeLockStatus" CornerRadius="4" Padding="6,2" Margin="0,0,8,0"
                                            Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}">
                                        <TextBlock x:Name="TxtLockStatusBadge" Text="Ожидание пути" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                    <TextBlock x:Name="TxtLocksmithDetails" Text="Укажите файл и нажмите «Найти блокировки»"
                                               FontSize="12" Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Таблица процессов -->
                            <DataGrid Grid.Row="1" x:Name="DgLockingProcesses" AutoGenerateColumns="False"
                                      CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal" SelectionMode="Single"
                                      Background="Transparent" BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="80" />
                                    <DataGridTextColumn Header="Имя процесса" Binding="{Binding ProcessName}" Width="160" />
                                    <DataGridTextColumn Header="Тип приложения" Binding="{Binding ApplicationType}" Width="140" />
                                    <DataGridTextColumn Header="Путь к исполняемому файлу" Binding="{Binding ProcessPath}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </ui:Card>

                    <!-- Кнопки управления процессами -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button x:Name="BtnKillLockingProcess" Content="Завершить выбранный процесс"
                                   Appearance="Danger" Icon="{ui:SymbolIcon DismissCircle24}"
                                   Click="OnKillLockingProcessClick" Margin="0,0,8,0" />
                        <ui:Button x:Name="BtnKillAllLocks" Content="Завершить ВСЕ процессы"
                                   Appearance="Danger" Icon="{ui:SymbolIcon Delete24}"
                                   Click="OnKillAllLocksClick" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Вкладка 2: Режим бодрствования (Keep-Awake) -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="WeatherMoon24" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding ToolboxTabAwake, Source={StaticResource Loc}}" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <StackPanel>
                        <!-- Статус бодрствования -->
                        <ui:Card Padding="16" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="52" Height="52" CornerRadius="12"
                                        Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        Margin="0,0,16,0" VerticalAlignment="Center">
                                    <ui:SymbolIcon x:Name="IconAwake" Symbol="WeatherSunny24" FontSize="26"
                                                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Режим бодрствования:" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" Margin="0,0,8,0" />
                                        <Border x:Name="BadgeAwakeState" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtAwakeBadge" Text="Отключен" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtAwakeDescription"
                                               Text="ПК переходит в спящий режим по стандартному плану электропитания Windows."
                                               FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                                </StackPanel>

                                <CheckBox x:Name="ChkKeepDisplayOn" Grid.Column="2" Content="Держать экран включенным"
                                          IsChecked="True" VerticalAlignment="Center" />
                            </Grid>
                        </ui:Card>

                        <!-- Быстрые действия -->
                        <ui:Card Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Активация режима бодрствования" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" Margin="0,0,0,10" />
                                <WrapPanel Orientation="Horizontal">
                                    <ui:Button Content="Не выключать (бессрочно)" Appearance="Primary" Icon="{ui:SymbolIcon Play24}"
                                               Click="OnAwakeIndefiniteClick" Margin="0,0,8,8" />
                                    <ui:Button Content="На 30 минут" Appearance="Secondary" Icon="{ui:SymbolIcon Clock24}"
                                               Click="OnAwake30MinClick" Margin="0,0,8,8" />
                                    <ui:Button Content="На 1 час" Appearance="Secondary" Icon="{ui:SymbolIcon Clock24}"
                                               Click="OnAwake1HourClick" Margin="0,0,8,8" />
                                    <ui:Button Content="На 2 часа" Appearance="Secondary" Icon="{ui:SymbolIcon Clock24}"
                                               Click="OnAwake2HoursClick" Margin="0,0,8,8" />
                                    <ui:Button Content="Отключить" Appearance="Danger" Icon="{ui:SymbolIcon Stop24}"
                                               Click="OnAwakeDeactivateClick" Margin="0,0,8,8" />
                                </WrapPanel>
                            </StackPanel>
                        </ui:Card>

                        <!-- Информационная плашка -->
                        <ui:Card Padding="12" Background="{ui:ThemeResource CardBackgroundFillColorSecondaryBrush}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Info24" FontSize="16" Foreground="{ui:ThemeResource AccentTextFillColorPrimaryBrush}"
                                               VerticalAlignment="Top" Margin="0,2,10,0" />
                                <TextBlock Text="Режим бодрствования временно блокирует переход в спящий режим и спящий режим монитора без изменения настроек электропитания Windows. Полезно при загрузке больших архивов, рендеринге видео или компиляции."
                                           FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Вкладка 3: Очистка дискового мусора (Junk Cleaner) -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Broom24" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding ToolboxTabCleaner, Source={StaticResource Loc}}" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Статус сканирования -->
                    <ui:Card Grid.Row="0" Margin="0,0,0,10" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Экспресс-очистка дискового пространства" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock x:Name="TxtJunkScanSummary" Text="Нажмите «Анализировать диск» для оценки объема временных файлов."
                                           FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:Button x:Name="BtnScanJunk" Content="Анализировать диск" Icon="{ui:SymbolIcon Search24}"
                                           Appearance="Secondary" Click="OnScanJunkClick" Margin="0,0,8,0" />
                                <ui:Button x:Name="BtnCleanJunk" Content="Очистить выбранное" Icon="{ui:SymbolIcon Delete24}"
                                           Appearance="Primary" Click="OnCleanJunkClick" />
                            </StackPanel>
                        </Grid>
                    </ui:Card>

                    <!-- Категории мусора -->
                    <ui:Card Grid.Row="1" Margin="0,0,0,10" Padding="0">
                        <DataGrid x:Name="DgJunkCategories" AutoGenerateColumns="False" CanUserAddRows="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  Background="Transparent" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Выбор" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                                <DataGridTextColumn Header="Категория" Binding="{Binding Name}" Width="260" IsReadOnly="True" />
                                <DataGridTextColumn Header="Размер" Binding="{Binding SizeFormatted}" Width="110" IsReadOnly="True" />
                                <DataGridTextColumn Header="Файлов" Binding="{Binding FileCount}" Width="90" IsReadOnly="True" />
                                <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </ui:Card>

                    <!-- Итоги очистки -->
                    <Border Grid.Row="2" Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8" Padding="12,8">
                        <TextBlock x:Name="TxtCleanerResultStatus" Text="Готово к сканированию" FontSize="12"
                                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </TabItem>

            <!-- Вкладка 4: Сканер устройств сети (LAN Scanner) -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Network24" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding ToolboxTabLanScanner, Source={StaticResource Loc}}" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Панель запуска сканирования сети -->
                    <ui:Card Grid.Row="0" Margin="0,0,0,10" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Сканер устройств локальной сети (LAN &amp; Wi-Fi)" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock x:Name="TxtLanScannerStatus"
                                           Text="Мгновенное обнаружение подключенных ПК, смартфонов, роутеров и принтеров."
                                           FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>

                            <ui:Button x:Name="BtnScanLan" Grid.Column="1" Content="Сканировать сеть"
                                       Icon="{ui:SymbolIcon Play24}" Appearance="Primary"
                                       Click="OnScanLanClick" VerticalAlignment="Center" />
                        </Grid>
                    </ui:Card>

                    <!-- Таблица обнаруженных устройств -->
                    <ui:Card Grid.Row="1" Margin="0,0,0,10" Padding="0">
                        <DataGrid x:Name="DgLanDevices" AutoGenerateColumns="False" CanUserAddRows="False"
                                  IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  Background="Transparent" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="IP-адрес" Binding="{Binding IpAddress}" Width="130" />
                                <DataGridTextColumn Header="MAC-адрес" Binding="{Binding MacAddress}" Width="150" />
                                <DataGridTextColumn Header="Имя узла (Hostname)" Binding="{Binding HostName}" Width="180" />
                                <DataGridTextColumn Header="Производитель (OUI)" Binding="{Binding Vendor}" Width="180" />
                                <DataGridTemplateColumn Header="Роль / Статус" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Visibility="{Binding IsCurrentDevice, Converter={StaticResource BoolToVisibility}}"
                                                        Background="{ui:ThemeResource AccentFillColorDefaultBrush}"
                                                        CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                    <TextBlock Text="Этот компьютер" FontSize="10" Foreground="White" FontWeight="SemiBold" />
                                                </Border>
                                                <Border Visibility="{Binding IsGateway, Converter={StaticResource BoolToVisibility}}"
                                                        Background="#10B981" CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="Шлюз / Роутер" FontSize="10" Foreground="White" FontWeight="SemiBold" />
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </ui:Card>

                    <!-- Счетчик устройств -->
                    <Border Grid.Row="2" Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8" Padding="12,8">
                        <TextBlock x:Name="TxtLanDevicesCount" Text="Устройств обнаружено: 0" FontSize="12"
                                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </TabItem>

            <!-- Вкладка 5: Хеши и безопасность паролей -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Key24" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding ToolboxTabSecurity, Source={StaticResource Loc}}" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Левая колонка: Хеш-калькулятор (HashTab) -->
                        <ui:Card Grid.Column="0" Padding="14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                                    <ui:SymbolIcon Symbol="DocumentCheckmark24" FontSize="18"
                                                   Foreground="{ui:ThemeResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0" />
                                    <TextBlock Text="Хеш-калькулятор файлов" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" />
                                </StackPanel>

                                <!-- Выбор файла -->
                                <TextBlock Text="Выберите файл для расчета контрольных сумм:" FontSize="12"
                                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBox x:Name="TxtHashFilePath" Grid.Column="0" PlaceholderText="Путь к файлу..." Margin="0,0,8,0" />
                                    <ui:Button x:Name="BtnBrowseHashFile" Grid.Column="1" Content="Обзор..."
                                               Icon="{ui:SymbolIcon FolderOpen24}" Click="OnBrowseHashFileClick" />
                                </Grid>

                                <!-- Результаты хешей -->
                                <TextBlock Text="SHA-256:" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0,6,0,0" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBox x:Name="TxtHashSha256" Grid.Column="0" IsReadOnly="True" Margin="0,0,8,0" />
                                    <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Copy24}" Click="OnCopySha256Click" ToolTip="Копировать SHA-256" />
                                </Grid>

                                <TextBlock Text="SHA-1:" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBox x:Name="TxtHashSha1" Grid.Column="0" IsReadOnly="True" Margin="0,0,8,0" />
                                    <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Copy24}" Click="OnCopySha1Click" ToolTip="Копировать SHA-1" />
                                </Grid>

                                <TextBlock Text="MD5:" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBox x:Name="TxtHashMd5" Grid.Column="0" IsReadOnly="True" Margin="0,0,8,0" />
                                    <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Copy24}" Click="OnCopyMd5Click" ToolTip="Копировать MD5" />
                                </Grid>

                                <!-- Сверка хеша -->
                                <TextBlock Text="Сверка с эталоном (вставьте контрольный хеш):" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0,8,0,0" />
                                <ui:TextBox x:Name="TxtHashCompare" PlaceholderText="Вставьте хеш для сравнения..." TextChanged="OnHashCompareChanged" />
                                <Border x:Name="BadgeHashMatch" CornerRadius="4" Padding="8,4" Visibility="Collapsed">
                                    <TextBlock x:Name="TxtHashMatchStatus" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </ui:Card>

                        <!-- Правая колонка: Генератор стойких паролей -->
                        <ui:Card Grid.Column="2" Padding="14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                                    <ui:SymbolIcon Symbol="ShieldKeyhole24" FontSize="18"
                                                   Foreground="{ui:ThemeResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0" />
                                    <TextBlock Text="Генератор стойких паролей" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" />
                                </StackPanel>

                                <!-- Длина пароля -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="SpaceBetween">
                                    <TextBlock Text="Длина пароля:" FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TxtPasswordLengthVal" Text="16 символов" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                                <Slider x:Name="SliderPasswordLength" Minimum="8" Maximum="64" Value="16" SmallChange="1"
                                        ValueChanged="OnPasswordLengthChanged" />

                                <!-- Опции символов -->
                                <CheckBox x:Name="ChkUpper" Content="Заглавные буквы (A-Z)" IsChecked="True" />
                                <CheckBox x:Name="ChkDigits" Content="Цифры (0-9)" IsChecked="True" />
                                <CheckBox x:Name="ChkSymbols" Content="Спецсимволы (!@#$%^&amp;*)" IsChecked="True" />

                                <ui:Button x:Name="BtnGeneratePassword" Content="Сгенерировать пароль"
                                           Icon="{ui:SymbolIcon ArrowSync24}" Appearance="Primary"
                                           Click="OnGeneratePasswordClick" Margin="0,6,0,0" />

                                <!-- Поле пароля -->
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBox x:Name="TxtGeneratedPassword" Grid.Column="0" IsReadOnly="True" FontSize="13"
                                                 FontFamily="Consolas" Margin="0,0,8,0" />
                                    <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Copy24}" Click="OnCopyPasswordClick" ToolTip="Копировать пароль" />
                                </Grid>

                                <!-- Индикатор стойкости -->
                                <Border x:Name="BadgePasswordStrength" CornerRadius="4" Padding="8,4"
                                        Background="{ui:ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                    <TextBlock x:Name="TxtPasswordStrength" Text="Нажмите «Сгенерировать пароль»"
                                               FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </ui:Card>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
