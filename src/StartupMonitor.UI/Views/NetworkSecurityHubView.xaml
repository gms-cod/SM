<UserControl



    x:Class="StartupMonitor.UI.Views.NetworkSecurityHubView"



    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"



    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"



    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"



    xmlns:controls="clr-namespace:StartupMonitor.UI.Controls"
    xmlns:firewall="clr-namespace:StartupMonitor.Shared.Models.Firewall;assembly=StartupMonitor.Shared"



    Background="{ui:ThemeResource ApplicationBackgroundBrush}">







    <UserControl.Resources>



        <!-- Неоновые кибер-ресурсы и градиенты высокой контрастности -->



        <SolidColorBrush x:Key="NeonCyanBrush" Color="#00D2D3" />



        <SolidColorBrush x:Key="NeonEmeraldBrush" Color="#10B981" />



        <SolidColorBrush x:Key="NeonCrimsonBrush" Color="#EF4444" />



        <SolidColorBrush x:Key="NeonAmberBrush" Color="#F59E0B" />



        <SolidColorBrush x:Key="DarkEmeraldBannerBg" Color="#122620" />



        <SolidColorBrush x:Key="DarkEmeraldBannerBorder" Color="#10B981" />



        <SolidColorBrush x:Key="DarkCrimsonBannerBg" Color="#2A1215" />



        <SolidColorBrush x:Key="DarkCrimsonBannerBorder" Color="#EF4444" />



        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />







        <!-- Стиль сегментированного переключателя матрицы доступа -->



        <Style x:Key="AccessSegmentRadioButton" TargetType="RadioButton">



            <Setter Property="FocusVisualStyle" Value="{x:Null}" />



            <Setter Property="Background" Value="Transparent" />



            <Setter Property="BorderThickness" Value="0" />



            <Setter Property="Cursor" Value="Hand" />



            <Setter Property="Padding" Value="8,3" />



            <Setter Property="FontSize" Value="11.5" />



            <Setter Property="FontWeight" Value="SemiBold" />



            <Setter Property="Template">



                <Setter.Value>



                    <ControlTemplate TargetType="RadioButton">



                        <Border x:Name="SegBorder"



                                Background="{TemplateBinding Background}"



                                CornerRadius="5"



                                Padding="{TemplateBinding Padding}"



                                SnapsToDevicePixels="True">



                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />



                        </Border>



                        <ControlTemplate.Triggers>



                            <Trigger Property="IsMouseOver" Value="True">



                                <Setter TargetName="SegBorder" Property="Background" Value="#15FFFFFF" />



                            </Trigger>



                            <MultiTrigger>



                                <MultiTrigger.Conditions>



                                    <Condition Property="IsChecked" Value="True" />



                                    <Condition Property="Tag" Value="Allow" />



                                </MultiTrigger.Conditions>



                                <Setter TargetName="SegBorder" Property="Background" Value="#2510B981" />



                                <Setter Property="Foreground" Value="#10B981" />



                            </MultiTrigger>



                            <MultiTrigger>



                                <MultiTrigger.Conditions>



                                    <Condition Property="IsChecked" Value="True" />



                                    <Condition Property="Tag" Value="Prompt" />



                                </MultiTrigger.Conditions>



                                <Setter TargetName="SegBorder" Property="Background" Value="#25F59E0B" />



                                <Setter Property="Foreground" Value="#F59E0B" />



                            </MultiTrigger>



                            <MultiTrigger>



                                <MultiTrigger.Conditions>



                                    <Condition Property="IsChecked" Value="True" />



                                    <Condition Property="Tag" Value="Block" />



                                </MultiTrigger.Conditions>



                                <Setter TargetName="SegBorder" Property="Background" Value="#30EF4444" />



                                <Setter Property="Foreground" Value="#EF4444" />



                            </MultiTrigger>



                            <Trigger Property="IsEnabled" Value="False">



                                <Setter Property="Opacity" Value="0.35" />



                                <Setter Property="Cursor" Value="No" />



                            </Trigger>



                        </ControlTemplate.Triggers>



                    </ControlTemplate>



                </Setter.Value>



            </Setter>



        </Style>







        <Style x:Key="CyberActionMiniBtn" TargetType="Button">



            <Setter Property="Background" Value="#18FFFFFF" />



            <Setter Property="BorderBrush" Value="#30FFFFFF" />



            <Setter Property="BorderThickness" Value="1" />



            <Setter Property="Padding" Value="6,3" />



            <Setter Property="Margin" Value="2,0" />



            <Setter Property="Cursor" Value="Hand" />



            <Setter Property="Template">



                <Setter.Value>



                    <ControlTemplate TargetType="Button">



                        <Border x:Name="bd" Background="{TemplateBinding Background}"



                                BorderBrush="{TemplateBinding BorderBrush}"



                                BorderThickness="{TemplateBinding BorderThickness}"



                                CornerRadius="4">



                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />



                        </Border>



                        <ControlTemplate.Triggers>



                            <Trigger Property="IsMouseOver" Value="True">



                                <Setter TargetName="bd" Property="Background" Value="#3500D2D3" />



                                <Setter TargetName="bd" Property="BorderBrush" Value="#00D2D3" />



                            </Trigger>



                        </ControlTemplate.Triggers>



                    </ControlTemplate>



                </Setter.Value>



            </Setter>



        </Style>



        <!-- Стиль радиокнопок-чипов фильтрации и временных окон -->

        <Style x:Key="FilterTabRadioButtonStyle" TargetType="RadioButton">

            <Setter Property="FocusVisualStyle" Value="{x:Null}" />

            <Setter Property="Background" Value="Transparent" />

            <Setter Property="Foreground" Value="{ui:ThemeResource TextFillColorSecondaryBrush}" />

            <Setter Property="BorderThickness" Value="1" />

            <Setter Property="BorderBrush" Value="{ui:ThemeResource CardStrokeColorDefaultBrush}" />

            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Height" Value="28" />

            <Setter Property="Padding" Value="10,2" />

            <Setter Property="FontSize" Value="12" />

            <Setter Property="FontWeight" Value="SemiBold" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="RadioButton">

                        <Border x:Name="bd"

                                Background="{TemplateBinding Background}"

                                BorderBrush="{TemplateBinding BorderBrush}"

                                BorderThickness="{TemplateBinding BorderThickness}"

                                CornerRadius="6"

                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="bd" Property="Background" Value="#15FFFFFF" />

                                <Setter TargetName="bd" Property="BorderBrush" Value="#00D2D3" />

                                <Setter Property="Foreground" Value="{ui:ThemeResource TextFillColorPrimaryBrush}" />

                            </Trigger>

                            <Trigger Property="IsChecked" Value="True">

                                <Setter TargetName="bd" Property="Background" Value="#2500D2D3" />

                                <Setter TargetName="bd" Property="BorderBrush" Value="#00D2D3" />

                                <Setter Property="Foreground" Value="#00D2D3" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </UserControl.Resources>











    <Grid Margin="16">



        <Grid.RowDefinitions>



            <RowDefinition Height="Auto" />



            <RowDefinition Height="Auto" />



            <RowDefinition Height="*" />



            <RowDefinition Height="Auto" />



        </Grid.RowDefinitions>







        <!-- ===== Верхняя карточка: статус брандмауэра + профили + режим фильтрации ===== -->



        <Border Grid.Row="0" Margin="0,0,0,14" Padding="18,14"
                Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12">
            <!-- Компактная сводка всегда видима; редкие глобальные параметры раскрываются отдельно. -->
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,12,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="12" Margin="0,0,14,0" VerticalAlignment="Top"
                            Background="{ui:ThemeResource CardBackgroundFillColorSecondaryBrush}">
                        <ui:SymbolIcon x:Name="FirewallShieldIcon" Symbol="Shield24" FontSize="24"
                                       Foreground="{ui:ThemeResource AccentTextFillColorPrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding [NetUxTitle], Source={StaticResource Loc}}" FontSize="23" FontWeight="SemiBold"
                                   Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" />
                        <WrapPanel Margin="0,6,0,0">
                            <Border x:Name="FirewallStateBadge" CornerRadius="5" Padding="8,3" Margin="0,0,8,4"
                                    Background="{ui:ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                <TextBlock x:Name="TxtFirewallState" Text="{Binding NetFwStateUnknown, Source={StaticResource Loc}}"
                                           FontSize="12" FontWeight="SemiBold" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" />
                            </Border>
                            <Border x:Name="ProfileDomainBadge" CornerRadius="5" Padding="8,3" Margin="0,0,6,4"
                                    Background="{ui:ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                <TextBlock x:Name="TxtProfileDomain" Text="{Binding NetProfileDomainDefault, Source={StaticResource Loc}}" FontSize="11"
                                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                            <Border x:Name="ProfilePrivateBadge" CornerRadius="5" Padding="8,3" Margin="0,0,6,4"
                                    Background="{ui:ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                <TextBlock x:Name="TxtProfilePrivate" Text="{Binding NetProfilePrivateDefault, Source={StaticResource Loc}}" FontSize="11"
                                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                            <Border x:Name="ProfilePublicBadge" CornerRadius="5" Padding="8,3" Margin="0,0,0,4"
                                    Background="{ui:ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                <TextBlock x:Name="TxtProfilePublic" Text="{Binding NetProfilePublicDefault, Source={StaticResource Loc}}" FontSize="11"
                                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </WrapPanel>
                        <TextBlock x:Name="TxtFirewallDetails" Text="{Binding NetStatusLoading, Source={StaticResource Loc}}"
                                   TextWrapping="Wrap" FontSize="11.5" Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Grid>
                <ui:Button x:Name="BtnRefreshStatus" Grid.Column="1" Appearance="Secondary"
                           Icon="{ui:SymbolIcon ArrowClockwise24}" Click="OnRefreshStatusClick"
                           ToolTip="{Binding NetBtnRefreshStatus, Source={StaticResource Loc}}"
                           AutomationProperties.Name="{Binding NetBtnRefreshStatus, Source={StaticResource Loc}}"
                           VerticalAlignment="Top" Padding="10" />
                <Expander Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0" IsExpanded="False"
                          Header="{Binding [NetUxSettings], Source={StaticResource Loc}}">
                    <StackPanel Margin="0,10,0,2">
                        <TextBlock Text="{Binding [NetUxModeHint], Source={StaticResource Loc}}" TextWrapping="Wrap"
                                   FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,10" />
                        <WrapPanel>
                            <RadioButton x:Name="RbModeNormal" GroupName="FilteringMode"
                                         Content="{Binding NetFilterModeNormal, Source={StaticResource Loc}}"
                                         Style="{StaticResource FilterTabRadioButtonStyle}" Checked="OnFilteringModeChecked"
                                         ToolTip="{Binding [NetUxNormalTip], Source={StaticResource Loc}}" Margin="0,0,8,6" />
                            <RadioButton x:Name="RbModeWhitelist" GroupName="FilteringMode"
                                         Content="{Binding NetFilterModeWhitelist, Source={StaticResource Loc}}"
                                         Style="{StaticResource FilterTabRadioButtonStyle}" Checked="OnFilteringModeChecked"
                                         ToolTip="{Binding [NetUxWhitelistTip], Source={StaticResource Loc}}" Margin="0,0,8,6" />
                            <RadioButton x:Name="RbModeKillswitch" GroupName="FilteringMode"
                                         Content="{Binding NetFilterModeKillswitch, Source={StaticResource Loc}}"
                                         Style="{StaticResource FilterTabRadioButtonStyle}" Checked="OnFilteringModeChecked"
                                         ToolTip="{Binding [NetUxKillswitchTip], Source={StaticResource Loc}}"
                                         Foreground="{ui:ThemeResource SystemFillColorCriticalBrush}" Margin="0,0,0,6" />
                        </WrapPanel>
                        <CheckBox x:Name="ChkInteractiveAlerts" Content="{Binding NetInteractiveAlertsCheck, Source={StaticResource Loc}}"
                                  Checked="OnInteractiveAlertsChanged" Unchecked="OnInteractiveAlertsChanged" Margin="0,8,0,0"
                                  ToolTip="{Binding NetInteractiveAlertsTip, Source={StaticResource Loc}}" />
                        <CheckBox x:Name="ChkSilentPid0" Content="{Binding FirewallSilentPid0Label, Source={StaticResource Loc}}"
                                  Checked="OnSilentPid0Changed" Unchecked="OnSilentPid0Changed" Margin="0,8,0,0"
                                  ToolTip="{Binding FirewallSilentPid0Hint, Source={StaticResource Loc}}" />
                    </StackPanel>
                </Expander>
            </Grid>
        </Border>







        <!-- ===== Навигационные вкладки брандмауэра в едином стиле страницы «Обзор» ===== -->



        <Border Grid.Row="1" Margin="0,0,0,10" Padding="0" Background="Transparent">
            <!-- Порядок кнопок отражает повседневные задачи; индексы существующих вкладок сохранены. -->
            <WrapPanel x:Name="HubNavigation" Orientation="Horizontal">
                <ui:Button x:Name="TabBtnAccessMatrix" Content="{Binding [NetUxNavApps], Source={StaticResource Loc}}"
                           Icon="{ui:SymbolIcon ShieldCheckmark24}" Margin="0,0,6,6" Padding="12,8" FontSize="12"
                           Appearance="Primary" Click="OnTabNavClick" Tag="1" />
                <ui:Button x:Name="TabBtnConnections" Content="{Binding [NetUxNavConnections], Source={StaticResource Loc}}"
                           Icon="{ui:SymbolIcon Globe24}" Margin="0,0,6,6" Padding="12,8" FontSize="12"
                           Appearance="Secondary" Click="OnTabNavClick" Tag="0" />
                <ui:Button x:Name="TabBtnPortDefender" Content="{Binding [NetUxNavPorts], Source={StaticResource Loc}}"
                           Icon="{ui:SymbolIcon LockClosed24}" Margin="0,0,6,6" Padding="12,8" FontSize="12"
                           Appearance="Secondary" Click="OnTabNavClick" Tag="3" />
                <ui:Button x:Name="TabBtnAttackLog" Content="{Binding [NetUxNavBans], Source={StaticResource Loc}}"
                           Icon="{ui:SymbolIcon Shield24}" Margin="0,0,6,6" Padding="12,8" FontSize="12"
                           Appearance="Secondary" Click="OnTabNavClick" Tag="4" />
                <ui:Button x:Name="TabBtnHistory" Content="{Binding [NetUxNavHistory], Source={StaticResource Loc}}"
                           Icon="{ui:SymbolIcon History24}" Margin="0,0,6,6" Padding="12,8" FontSize="12"
                           Appearance="Secondary" Click="OnTabNavClick" Tag="5" />
                <ui:Button x:Name="TabBtnRules" Content="{Binding [NetUxNavRules], Source={StaticResource Loc}}"
                           Icon="{ui:SymbolIcon DocumentBulletList24}" Margin="0,0,6,6" Padding="12,8" FontSize="12"
                           Appearance="Secondary" Click="OnTabNavClick" Tag="2" />
            </WrapPanel>
        </Border>







        <!-- ===== Вкладки (переключаются через навигационную панель) ===== -->



        <Grid Grid.Row="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="2,2,0,10">
                <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}">
                    <TextBlock.Style><Style TargetType="TextBlock">
                        <Setter Property="Text" Value="{Binding [NetUxConnectionsTitle], Source={StaticResource Loc}}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedIndex, ElementName=MainTabs}" Value="1"><Setter Property="Text" Value="{Binding [NetUxAppsTitle], Source={StaticResource Loc}}" /></DataTrigger>
                            <DataTrigger Binding="{Binding SelectedIndex, ElementName=MainTabs}" Value="2"><Setter Property="Text" Value="{Binding [NetUxRulesTitle], Source={StaticResource Loc}}" /></DataTrigger>
                            <DataTrigger Binding="{Binding SelectedIndex, ElementName=MainTabs}" Value="3"><Setter Property="Text" Value="{Binding [NetUxPortsTitle], Source={StaticResource Loc}}" /></DataTrigger>
                            <DataTrigger Binding="{Binding SelectedIndex, ElementName=MainTabs}" Value="4"><Setter Property="Text" Value="{Binding [NetUxBansTitle], Source={StaticResource Loc}}" /></DataTrigger>
                            <DataTrigger Binding="{Binding SelectedIndex, ElementName=MainTabs}" Value="5"><Setter Property="Text" Value="{Binding [NetUxHistoryTitle], Source={StaticResource Loc}}" /></DataTrigger>
                        </Style.Triggers>
                    </Style></TextBlock.Style>
                </TextBlock>
                <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}">
                    <TextBlock.Style><Style TargetType="TextBlock">
                        <Setter Property="Text" Value="{Binding [NetUxConnectionsHelp], Source={StaticResource Loc}}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedIndex, ElementName=MainTabs}" Value="1"><Setter Property="Text" Value="{Binding [NetUxAppsHelp], Source={StaticResource Loc}}" /></DataTrigger>
                            <DataTrigger Binding="{Binding SelectedIndex, ElementName=MainTabs}" Value="2"><Setter Property="Text" Value="{Binding [NetUxRulesHelp], Source={StaticResource Loc}}" /></DataTrigger>
                            <DataTrigger Binding="{Binding SelectedIndex, ElementName=MainTabs}" Value="3"><Setter Property="Text" Value="{Binding [NetUxPortsHelp], Source={StaticResource Loc}}" /></DataTrigger>
                            <DataTrigger Binding="{Binding SelectedIndex, ElementName=MainTabs}" Value="4"><Setter Property="Text" Value="{Binding [NetUxBansHelp], Source={StaticResource Loc}}" /></DataTrigger>
                            <DataTrigger Binding="{Binding SelectedIndex, ElementName=MainTabs}" Value="5"><Setter Property="Text" Value="{Binding [NetUxHistoryHelp], Source={StaticResource Loc}}" /></DataTrigger>
                        </Style.Triggers>
                    </Style></TextBlock.Style>
                </TextBlock>
            </StackPanel>
            <TabControl Grid.Row="1" x:Name="MainTabs" SelectedIndex="1" Background="Transparent" BorderThickness="0">



            <TabControl.ItemContainerStyle>



                <Style TargetType="TabItem">



                    <Setter Property="Visibility" Value="Collapsed" />



                </Style>



            </TabControl.ItemContainerStyle>







            <!-- Вкладка 0: Активные соединения (Live) и таймлайн-аналитика -->



            <TabItem>



                <TabItem.Header>



                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">



                        <ui:SymbolIcon Symbol="Globe24" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0" />



                        <TextBlock Text="{Binding NetLiveConnectionsHeader, Source={StaticResource Loc}}" VerticalAlignment="Center" />



                    </StackPanel>



                </TabItem.Header>



                <Grid Margin="0,8,0,0">



                    <Grid.RowDefinitions>



                        <RowDefinition Height="Auto" />



                        <RowDefinition Height="Auto" />



                        <RowDefinition Height="*" />



                    </Grid.RowDefinitions>







                    <!-- Верхняя зона: Аппаратно-ускоренный график сетевой активности (60 FPS) -->



                    <Border Grid.Row="0" Margin="0,0,0,12" Padding="12" CornerRadius="10"
                            Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="{Binding [TimelineTitle], Source={StaticResource Loc}}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="TxtTimelineActiveSlice" Text="" FontSize="11.5" Foreground="{StaticResource NeonCyanBrush}"



                                               Margin="10,0,0,0" VerticalAlignment="Center" />
                            </WrapPanel>
                            <WrapPanel Grid.Row="1" Margin="0,0,0,8"><RadioButton x:Name="RbTimeWindow1h" Content="{Binding [TimelineHour], Source={StaticResource Loc}}" IsChecked="True"



                                                 Style="{StaticResource FilterTabRadioButtonStyle}" Margin="0,0,4,0"



                                                 Click="OnTimeWindowClick" Tag="1" />
<RadioButton x:Name="RbTimeWindow24h" Content="{Binding [TimelineDay], Source={StaticResource Loc}}"



                                                 Style="{StaticResource FilterTabRadioButtonStyle}" Margin="0,0,4,0"



                                                 Click="OnTimeWindowClick" Tag="24" />
<RadioButton x:Name="RbTimeWindow7d" Content="{Binding [TimelineWeek], Source={StaticResource Loc}}"



                                                 Style="{StaticResource FilterTabRadioButtonStyle}"



                                                 Click="OnTimeWindowClick" Tag="168" />
<ui:Button x:Name="BtnResetTimelineFilter" Appearance="Secondary" Content="{Binding [TimelineReset], Source={StaticResource Loc}}"



                                               Margin="8,0,0,0" Padding="8,3" Visibility="Collapsed"



                                               Click="OnResetTimelineFilterClick" ToolTip="{Binding [TimelineResetTip], Source={StaticResource Loc}}" /></WrapPanel>
                            <controls:NetworkTimelineChartControl x:Name="TimelineChart" Grid.Row="2" Height="80"



                                                                  TimeSliceSelected="OnTimelineTimeSliceSelected" />
                        </Grid>
                    </Border>







                    <!-- Панель управления и фильтрации соединений -->



                    <StackPanel Grid.Row="1" Margin="0,0,0,10">
                        <ui:TextBox x:Name="TxtSearchConnections"



                                     PlaceholderText="{Binding NetSearchConnectionsHint, Source={StaticResource Loc}}"



                                     TextChanged="OnConnectionsSearchChanged" Margin="0,0,0,8" />
                        <WrapPanel Margin="0,0,0,10"><RadioButton x:Name="RbConnAll" GroupName="ConnFilter" Content="{Binding NetFilterAll, Source={StaticResource Loc}}"



                                         IsChecked="True" Checked="OnConnectionsFilterChanged"



                                         VerticalAlignment="Center" Margin="0,0,10,0" />
<RadioButton x:Name="RbConnWan" GroupName="ConnFilter" Content="{Binding NetFilterWan, Source={StaticResource Loc}}"



                                         Checked="OnConnectionsFilterChanged"



                                         VerticalAlignment="Center" Margin="0,0,10,0" />
<RadioButton x:Name="RbConnLan" GroupName="ConnFilter" Content="{Binding NetFilterLan, Source={StaticResource Loc}}"



                                         Checked="OnConnectionsFilterChanged"



                                         VerticalAlignment="Center" Margin="0,0,10,0" />
<RadioButton x:Name="RbConnEstablished" GroupName="ConnFilter" Content="{Binding NetFilterEstablished, Source={StaticResource Loc}}"



                                         Checked="OnConnectionsFilterChanged"



                                         VerticalAlignment="Center" Margin="0,0,10,0" />
<RadioButton x:Name="RbConnListening" GroupName="ConnFilter" Content="{Binding NetFilterListen, Source={StaticResource Loc}}"



                                         Checked="OnConnectionsFilterChanged"



                                         VerticalAlignment="Center" /></WrapPanel>
                        <WrapPanel VerticalAlignment="Center"><CheckBox x:Name="ChkAutoRefreshConn" Content="{Binding NetAutoRefresh2s, Source={StaticResource Loc}}"



                                      IsChecked="True"



                                      Checked="OnAutoRefreshConnChanged" Unchecked="OnAutoRefreshConnChanged"



                                      VerticalAlignment="Center" Margin="0,0,12,0" />
<ui:Button x:Name="BtnRefreshConn" Appearance="Secondary" Content="{Binding NetBtnRefreshNow, Source={StaticResource Loc}}"



                                       Click="OnRefreshConnClick" Margin="0,0,12,0" />
<TextBlock x:Name="TxtConnectionsSummary" Text="—"



                                       FontSize="12"



                                       Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"



                                       VerticalAlignment="Center" /></WrapPanel>
                    </StackPanel>







                    <!-- Таблица живых соединений -->



                    <Grid Grid.Row="2">



                        <DataGrid x:Name="GridLiveConnections"



                                  AutoGenerateColumns="False"



                                  CanUserAddRows="False"



                                  CanUserDeleteRows="False"



                                  CanUserReorderColumns="False"



                                  IsReadOnly="True"



                                  SelectionMode="Single"



                                  GridLinesVisibility="None"



                                  HeadersVisibility="Column"



                                  BorderThickness="1"



                                  BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"



                                  Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"



                                  RowHeight="34" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.HorizontalScrollBarVisibility="Auto">



                            <DataGrid.ContextMenu>



                                <ContextMenu>



                                    <MenuItem x:Name="CtxBlockRemoteIp" Header="{Binding NetCtxBlockRemoteIp, Source={StaticResource Loc}}" Click="OnCtxBlockRemoteIpClick" />



                                    <MenuItem x:Name="CtxCreateRuleForProcess" Header="{Binding NetCtxCreateRuleForProcess, Source={StaticResource Loc}}" Click="OnCtxCreateRuleForProcessClick" />



                                    <Separator />



                                    <MenuItem x:Name="CtxCopyRemoteIp" Header="{Binding NetCtxCopyRemoteIp, Source={StaticResource Loc}}" Click="OnCtxCopyRemoteIpClick" />



                                    <MenuItem x:Name="CtxCopyEndpoint" Header="{Binding NetCtxCopyEndpoint, Source={StaticResource Loc}}" Click="OnCtxCopyEndpointClick" />



                                    <Separator />



                                    <MenuItem x:Name="CtxWhois" Header="{Binding NetCtxWhois, Source={StaticResource Loc}}" Click="OnCtxWhoisClick" />



                                    <MenuItem x:Name="CtxVirusTotal" Header="{Binding NetCtxVirusTotal, Source={StaticResource Loc}}" Click="OnCtxVirusTotalClick" />



                                    <Separator />



                                    <MenuItem x:Name="CtxKillProcess" Header="{Binding NetCtxKillProcess, Source={StaticResource Loc}}" Click="OnCtxKillProcessClick" />



                                </ContextMenu>



                            </DataGrid.ContextMenu>



                            <DataGrid.Columns>



                                <!-- Процесс -->



                                <DataGridTemplateColumn Header="{Binding NetColProcess, Source={StaticResource Loc}}" Width="1.5*">



                                    <DataGridTemplateColumn.CellTemplate>



                                        <DataTemplate>



                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">



                                                <TextBlock Text="{Binding ProcessName}" FontSize="12" FontWeight="SemiBold"



                                                           Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"



                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />



                                                <TextBlock Text="{Binding Pid, StringFormat=' ({0})'}" FontSize="11"



                                                           Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"



                                                           VerticalAlignment="Center" />



                                            </StackPanel>



                                        </DataTemplate>



                                    </DataGridTemplateColumn.CellTemplate>



                                </DataGridTemplateColumn>







                                <!-- Протокол -->



                                <DataGridTextColumn Header="{Binding NetColProtocol, Source={StaticResource Loc}}" Binding="{Binding Protocol}" Width="60" />







                                <!-- Локальный адрес -->



                                <DataGridTextColumn Header="{Binding NetColLocalAddress, Source={StaticResource Loc}}" Binding="{Binding LocalEndPoint}" Width="150" />







                                <!-- Удаленный адрес -->



                                <DataGridTextColumn Header="{Binding NetColRemoteAddress, Source={StaticResource Loc}}" Binding="{Binding RemoteEndPoint}" Width="160" />







