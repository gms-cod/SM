                                                           VerticalAlignment="Center" Margin="0,0,4,0" />



                                                <TextBlock Text="{Binding CountryText}" FontSize="12"



                                                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"



                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />



                                            </StackPanel>



                                        </DataTemplate>



                                    </DataGridTemplateColumn.CellTemplate>



                                </DataGridTemplateColumn>







                                <!-- Брандмауэр -->



                                <DataGridTextColumn Header="{Binding NetColFirewall, Source={StaticResource Loc}}" Binding="{Binding FirewallBadge}" Width="110" />







                                <!-- Быстрые действия над активным сокетом -->



                                <DataGridTemplateColumn Header="{Binding NetAclColActions, Source={StaticResource Loc}}" Width="140">



                                    <DataGridTemplateColumn.CellTemplate>



                                        <DataTemplate>



                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">



                                                <Button Style="{StaticResource CyberActionMiniBtn}"



                                                        ToolTip="{Binding NetAclRowWhitelistTip, Source={StaticResource Loc}}"



                                                        Click="OnRowWhitelistClick">



                                                    <TextBlock Text="🛡️" FontSize="11" />



                                                </Button>



                                                <Button Style="{StaticResource CyberActionMiniBtn}"



                                                        ToolTip="{Binding NetAclRowBlacklistTip, Source={StaticResource Loc}}"



                                                        Click="OnRowBlacklistClick">



                                                    <TextBlock Text="🚫" FontSize="11" />



                                                </Button>



                                                <Button Style="{StaticResource CyberActionMiniBtn}"



                                                        ToolTip="{Binding NetAclRowKillProcessTip, Source={StaticResource Loc}}"



                                                        Click="OnRowKillProcessClick">



                                                    <TextBlock Text="❌" FontSize="11" Foreground="#EF4444" />



                                                </Button>



                                            </StackPanel>



                                        </DataTemplate>



                                    </DataGridTemplateColumn.CellTemplate>



                                </DataGridTemplateColumn>



                            </DataGrid.Columns>



                        </DataGrid>







                        <StackPanel x:Name="PanelConnEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">



                            <ui:SymbolIcon Symbol="Globe24" FontSize="32"



                                           Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"



                                           HorizontalAlignment="Center" Margin="0,0,0,8" />



                            <TextBlock Text="{Binding NetNoConnectionsTitle, Source={StaticResource Loc}}" FontSize="14" FontWeight="SemiBold"



                                       Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"



                                       HorizontalAlignment="Center" />



                            <TextBlock Text="{Binding NetNoConnectionsSubtitle, Source={StaticResource Loc}}" FontSize="12"



                                       Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"



                                       HorizontalAlignment="Center" Margin="0,4,0,0" />



                        </StackPanel>



                    </Grid>



                </Grid>



            </TabItem>











            <!-- Вкладка 1: Единая матрица контроля доступа (Application Access Control Matrix) -->



            <TabItem>



                <TabItem.Header>



                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">



                        <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="14" Foreground="{StaticResource NeonCyanBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />



                        <TextBlock Text="{Binding NetTabAclMatrix, Source={StaticResource Loc}}" VerticalAlignment="Center" FontWeight="SemiBold" />



                    </StackPanel>



                </TabItem.Header>







                <Grid Margin="0,8,0,0">



                    <Grid.RowDefinitions>



                        <RowDefinition Height="Auto" />



                        <RowDefinition Height="*" />



                    </Grid.RowDefinitions>







                    <!-- Верхний командный баннер с быстрыми чипами-фильтрами -->



                    <Border Grid.Row="0" Margin="0,0,0,10" Padding="12" CornerRadius="10"
                            Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <!-- Поиск занимает доступную ширину, фильтры переносятся независимо от кнопок действий. -->
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="TxtSearchMatrix" MinWidth="120" Margin="0,0,10,8"



                                            PlaceholderText="{Binding NetAclSearchPlaceholder, Source={StaticResource Loc}}" TextChanged="OnMatrixSearchChanged" />
                            <WrapPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                                <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Add24}"
                                           Content="{Binding [NetUxAddApp], Source={StaticResource Loc}}" Click="OnAddMatrixAppClick" Margin="0,0,6,8" />
                                <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon ArrowClockwise24}" Click="OnRefreshMatrixClick"
                                           Margin="0,0,0,8" ToolTip="{Binding NetAclRefreshTip, Source={StaticResource Loc}}"
                                           AutomationProperties.Name="{Binding NetAclRefreshTip, Source={StaticResource Loc}}" />
                            </WrapPanel>
                            <WrapPanel Grid.Row="1" Grid.ColumnSpan="2"><RadioButton x:Name="ChipFilterAll" Content="{Binding NetAclFilterAll, Source={StaticResource Loc}}" IsChecked="True"



                                             Style="{StaticResource FilterTabRadioButtonStyle}" Margin="0,0,6,4" Click="OnAclFilterChipClick" Tag="All" />
<RadioButton x:Name="ChipFilterAllow" Content="{Binding NetAclFilterAllow, Source={StaticResource Loc}}"



                                             Style="{StaticResource FilterTabRadioButtonStyle}" Margin="0,0,6,4" Click="OnAclFilterChipClick" Tag="Allow" />
<RadioButton x:Name="ChipFilterPrompt" Content="{Binding NetAclFilterPrompt, Source={StaticResource Loc}}"



                                             Style="{StaticResource FilterTabRadioButtonStyle}" Margin="0,0,6,4" Click="OnAclFilterChipClick" Tag="Prompt" />
<RadioButton x:Name="ChipFilterBlock" Content="{Binding NetAclFilterBlock, Source={StaticResource Loc}}"



                                             Style="{StaticResource FilterTabRadioButtonStyle}" Margin="0,0,6,4" Click="OnAclFilterChipClick" Tag="Block" />
<RadioButton x:Name="ChipFilterSystem" Content="{Binding NetAclFilterSystem, Source={StaticResource Loc}}"



                                             Style="{StaticResource FilterTabRadioButtonStyle}" Margin="0,0,6,4" Click="OnAclFilterChipClick" Tag="System" />
<RadioButton x:Name="ChipFilterSession" Content="{Binding NetAclFilterSession, Source={StaticResource Loc}}"



                                             Style="{StaticResource FilterTabRadioButtonStyle}" Margin="0,0,0,4" Click="OnAclFilterChipClick" Tag="Session" /></WrapPanel>
                        </Grid>
                    </Border>







                    <!-- Таблица Матрицы контроля доступа -->



                    <Grid Grid.Row="1">



                        <DataGrid x:Name="GridAccessMatrix"



                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"



                                  CanUserReorderColumns="False"



                                  IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"



                                  GridLinesVisibility="None"



                                  BorderThickness="1" BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"



                                  Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}" RowHeight="68" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.HorizontalScrollBarVisibility="Auto">



                            <DataGrid.Columns>







                                <!-- Колонка 1: Приложение (Иконка, Имя, Защитный бейдж, Путь) -->



                                <DataGridTemplateColumn Header="{Binding NetAclColApp, Source={StaticResource Loc}}" Width="2*" MinWidth="180">



                                    <DataGridTemplateColumn.CellTemplate>



                                        <DataTemplate>



                                            <Grid Margin="6,2">



                                                <Grid.ColumnDefinitions>



                                                    <ColumnDefinition Width="Auto" />



                                                    <ColumnDefinition Width="*" />



                                                </Grid.ColumnDefinitions>



                                                <ui:SymbolIcon Grid.Column="0" Symbol="AppGeneric24" FontSize="20"



                                                               Foreground="{ui:ThemeResource AccentTextFillColorPrimaryBrush}"



                                                               VerticalAlignment="Center" Margin="0,0,10,0" />



                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">



                                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>



                                                        <TextBlock Text="{Binding ProcessName}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"



                                                                   Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />







                                                        <!-- Бейдж критического ядра (Уровень 3) -->



                                                        <Border Grid.Column="1" Visibility="{Binding IsCriticalSystem, Converter={StaticResource BoolToVisConverter}}"



                                                                Background="#2500D2D3" BorderBrush="#00D2D3" BorderThickness="1" CornerRadius="4"



                                                                Padding="5,1" Margin="6,0,0,0" ToolTip="{Binding [DefenderCriticalTip], Source={StaticResource Loc}}">



                                                            <TextBlock Text="🔒" FontSize="10" FontWeight="Bold" Foreground="#00D2D3" />



                                                        </Border>







                                                        <!-- Бейдж защищенной подсистемы (Уровень 2) -->



                                                        <Border Grid.Column="2" Visibility="{Binding IsProtectedSubsystem, Converter={StaticResource BoolToVisConverter}}"



                                                                Background="#25F59E0B" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="4"



                                                                Padding="5,1" Margin="6,0,0,0" ToolTip="{Binding [DefenderHighRiskTip], Source={StaticResource Loc}}">



                                                            <TextBlock Text="⚠" FontSize="10" FontWeight="Bold" Foreground="#F59E0B" />



                                                        </Border>



                                                    </Grid>



                                                    <TextBlock Text="{Binding FullPath}" FontSize="11"



                                                               Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />



                                                </StackPanel>



                                            </Grid>



                                        </DataTemplate>



                                    </DataGridTemplateColumn.CellTemplate>



                                </DataGridTemplateColumn>







                                <!-- Колонка 2: Трехпозиционный переключатель состояния доступа -->



                                <DataGridTemplateColumn Header="{Binding NetAclColPolicy, Source={StaticResource Loc}}" Width="180" MinWidth="170" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <!-- Односторонняя привязка сохраняет подтверждённое состояние до завершения IPC-команды. -->
                                            <StackPanel Margin="6,4" VerticalAlignment="Center">
                                                <ComboBox x:Name="AccessPolicyPicker" Height="34" MinWidth="150" Padding="8,4" FontSize="12"
                                                          VerticalContentAlignment="Center" HorizontalAlignment="Stretch"
                                                          SelectedValuePath="Tag" SelectedValue="{Binding State, Mode=OneWay}"
                                                          SelectionChanged="OnMatrixPolicySelectionChanged"
                                                          AutomationProperties.Name="{Binding NetAclColPolicy, Source={StaticResource Loc}}"
                                                          ToolTip="{Binding [NetUxPolicyHelp], Source={StaticResource Loc}}">
                                                    <ComboBoxItem Content="{Binding [NetUxPolicyAllowed], Source={StaticResource Loc}}" Tag="{x:Static firewall:AccessControlState.Allowed}" />
                                                    <ComboBoxItem Content="{Binding [NetUxPolicyPrompt], Source={StaticResource Loc}}" Tag="{x:Static firewall:AccessControlState.Prompt}" />
                                                    <ComboBoxItem Content="{Binding [NetUxPolicyBlocked], Source={StaticResource Loc}}" Tag="{x:Static firewall:AccessControlState.Blocked}"
                                                                  IsEnabled="{Binding CanBlock}" />
                                                </ComboBox>
                                                <TextBlock Text="{Binding ScopeDisplay}" FontSize="10.5" Margin="2,4,0,0"
                                                           Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>







                                <!-- Колонка 3: Область действия / Таймер сессии -->



                                <!-- Срок действия показан под политикой, освобождая место для имени приложения. -->







                                <!-- Колонка 4: Источник блокировки / правила -->



                                <DataGridTemplateColumn Header="{Binding NetAclColSource, Source={StaticResource Loc}}" Width="*" MinWidth="140">



                                    <DataGridTemplateColumn.CellTemplate>



                                        <DataTemplate>



                                            <Border Background="{Binding SourceBadgeBg}" BorderBrush="{Binding SourceBadgeBorder}"



                                                    BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">



                                                <TextBlock Text="{Binding SourceBadgeText}" FontSize="11" FontWeight="SemiBold"



                                                           Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" />



                                            </Border>



                                        </DataTemplate>



                                    </DataGridTemplateColumn.CellTemplate>



                                </DataGridTemplateColumn>







                                <!-- Колонка 5: Сетевая активность сокетов -->



                                <DataGridTextColumn Header="{Binding NetAclColSockets, Source={StaticResource Loc}}" Binding="{Binding ActiveSocketsDisplay}" Width="65" />







                                <!-- Колонка 6: Действия -->



                                <DataGridTemplateColumn Header="{Binding NetAclColActions, Source={StaticResource Loc}}" Width="88" MinWidth="88" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                                            <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon DocumentBulletList24}" Padding="7"
                                                       Click="OnInspectAppRulesClick" ToolTip="{Binding [NetUxInspectRules], Source={StaticResource Loc}}"
                                                       AutomationProperties.Name="{Binding [NetUxInspectRules], Source={StaticResource Loc}}" Margin="0,0,4,0" />
                                            <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon ArrowUndo24}" Padding="7"
                                                       Click="OnResetAppPolicyClick" ToolTip="{Binding [NetUxResetPolicy], Source={StaticResource Loc}}"
                                                       AutomationProperties.Name="{Binding [NetUxResetPolicy], Source={StaticResource Loc}}" />
                                        </StackPanel>
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>







                            </DataGrid.Columns>



                        </DataGrid>







                        <TextBlock x:Name="TxtMatrixEmpty" Text="{Binding NetAclEmptyText, Source={StaticResource Loc}}"



                                   Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"



                                   FontSize="13" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />



                    </Grid>



                </Grid>



            </TabItem>







            <!-- Вкладка 1: Правила брандмауэра -->



            <TabItem Header="{Binding NetTabFirewallRules, Source={StaticResource Loc}}">



                <Grid Margin="0,8,0,0">



                    <Grid.RowDefinitions>



                        <RowDefinition Height="Auto" />



                        <RowDefinition Height="Auto" />



                        <RowDefinition Height="*" />



                    </Grid.RowDefinitions>







                    <!-- Поиск + фильтры -->



                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <ui:TextBox x:Name="TxtRuleSearch"



                                     PlaceholderText="{Binding NetSearchRulesHint, Source={StaticResource Loc}}"



                                     TextChanged="OnRuleSearchTextChanged" Margin="0,0,0,8" />
                        <WrapPanel><RadioButton x:Name="FilterAll" GroupName="RuleFilter" Content="{Binding NetRulesFilterAll, Source={StaticResource Loc}}" IsChecked="True"



                                         Checked="OnRuleFilterChecked" VerticalAlignment="Center" Margin="0,0,10,0" />
<RadioButton x:Name="FilterInbound" GroupName="RuleFilter" Content="{Binding NetRulesFilterInbound, Source={StaticResource Loc}}"



                                         Checked="OnRuleFilterChecked" VerticalAlignment="Center" Margin="0,0,10,0" />
<RadioButton x:Name="FilterOutbound" GroupName="RuleFilter" Content="{Binding NetRulesFilterOutbound, Source={StaticResource Loc}}"



                                         Checked="OnRuleFilterChecked" VerticalAlignment="Center" Margin="0,0,10,0" />
<RadioButton x:Name="FilterBlocking" GroupName="RuleFilter" Content="{Binding NetRulesFilterBlock, Source={StaticResource Loc}}"



                                         Checked="OnRuleFilterChecked" VerticalAlignment="Center" Margin="0,0,10,0" />
<RadioButton x:Name="FilterManaged" GroupName="RuleFilter" Content="StartupMonitor"



                                         Checked="OnRuleFilterChecked" VerticalAlignment="Center" /></WrapPanel>
                    </StackPanel>







                    <!-- Кнопки действий -->



                    <StackPanel Grid.Row="1" Margin="0,0,0,8">
                        <WrapPanel><ui:Button x:Name="BtnCreateRule" Appearance="Primary" Content="{Binding NetBtnCreateRule, Source={StaticResource Loc}}"



                                   Click="OnCreateRuleClick" Margin="0,0,8,4" />
<ui:Button x:Name="BtnEditRule" Appearance="Secondary" Content="{Binding NetBtnEditRule, Source={StaticResource Loc}}"



                                   Click="OnEditRuleClick" Margin="0,0,8,4" />
<ui:Button x:Name="BtnDeleteRule" Appearance="Secondary" Content="{Binding NetBtnDeleteRule, Source={StaticResource Loc}}"



                                   Click="OnDeleteRuleClick" Margin="0,0,8,4" />
<ui:Button x:Name="BtnRefreshRules" Appearance="Secondary" Content="{Binding NetBtnRefreshRules, Source={StaticResource Loc}}"



                                   Click="OnRefreshRulesClick" Margin="0,0,8,4" /></WrapPanel>
                        <Expander Header="{Binding [NetUxAdvancedActions], Source={StaticResource Loc}}" IsExpanded="False" Margin="0,4,0,4">
                            <WrapPanel Margin="0,8,0,0"><ui:Button x:Name="BtnExportRules" Appearance="Secondary"



                                   Icon="{ui:SymbolIcon Save24}"



                                   Content="{Binding NetBtnExport, Source={StaticResource Loc}}"



                                   ToolTip="{Binding NetBtnExportTip, Source={StaticResource Loc}}"



                                   Click="OnExportRulesClick" Margin="0,0,8,4" />
<ui:Button x:Name="BtnImportRules" Appearance="Secondary"



                                   Icon="{ui:SymbolIcon FolderOpen24}"



                                   Content="{Binding NetBtnImport, Source={StaticResource Loc}}"



                                   ToolTip="{Binding NetBtnImportTip, Source={StaticResource Loc}}"



                                   Click="OnImportRulesClick" Margin="0,0,8,4" />
<ui:DropDownButton x:Name="BtnSecurityPresets" Appearance="Secondary"



                                           Icon="{ui:SymbolIcon ShieldCheckmark24}"



                                           Content="{Binding NetBtnSecurityPresets, Source={StaticResource Loc}}"



                                           Margin="0,0,8,4">



                            <ui:DropDownButton.Flyout>



                                <ContextMenu>



                                    <MenuItem Header="{Binding NetPresetMaxPrivacy, Source={StaticResource Loc}}" Click="OnApplyPresetMaxPrivacyClick" />



                                    <MenuItem Header="{Binding NetPresetGaming, Source={StaticResource Loc}}" Click="OnApplyPresetGamingClick" />



                                    <MenuItem Header="{Binding NetPresetPublicWifi, Source={StaticResource Loc}}" Click="OnApplyPresetPublicWifiClick" />



                                    <Separator />



                                    <MenuItem Header="{Binding NetPresetReset, Source={StaticResource Loc}}" Click="OnApplyPresetResetClick" />



                                </ContextMenu>



                            </ui:DropDownButton.Flyout>



                        </ui:DropDownButton>
<ui:Button x:Name="BtnAntiTelemetry" Appearance="Danger" Content="{Binding NetBtnAntiTelemetry, Source={StaticResource Loc}}"



                                   Click="OnAntiTelemetryClick" Margin="0,0,0,4"



                                   ToolTip="{Binding NetBtnAntiTelemetryTip, Source={StaticResource Loc}}" /></WrapPanel>
                        </Expander>
                    </StackPanel>







                    <!-- Таблица правил -->



                    <Grid Grid.Row="2">



                        <DataGrid x:Name="GridRules"



                                  AutoGenerateColumns="False"



                                  CanUserAddRows="False"



                                  CanUserDeleteRows="False"



                                  CanUserReorderColumns="False"



                                  IsReadOnly="True"



                                  SelectionMode="Single"



                                  GridLinesVisibility="None"



                                  HeadersVisibility="Column"



                                  BorderThickness="1"



                                  BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"



                                  Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"



                                  RowHeight="34"



                                  MouseDoubleClick="OnRuleGridDoubleClick" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.HorizontalScrollBarVisibility="Auto">



                            <DataGrid.Columns>



                                <!-- Включение -->



                                <DataGridTemplateColumn Header="{Binding NetColEnabled, Source={StaticResource Loc}}" Width="52">



                                    <DataGridTemplateColumn.CellTemplate>



                                        <DataTemplate>



                                            <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}"



                                                      Checked="OnRuleToggleChecked"



                                                      Unchecked="OnRuleToggleChecked"



                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />



                                        </DataTemplate>



                                    </DataGridTemplateColumn.CellTemplate>



                                </DataGridTemplateColumn>







                                <!-- Действие -->



                                <DataGridTemplateColumn Header="{Binding NetColAction, Source={StaticResource Loc}}" Width="110">



                                    <DataGridTemplateColumn.CellTemplate>



                                        <DataTemplate>



                                            <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">



                                                <Border.Style>



                                                    <Style TargetType="Border">



                                                        <Setter Property="Background" Value="#20107C41" />



                                                        <Setter Property="BorderBrush" Value="#40107C41" />



                                                        <Setter Property="BorderThickness" Value="1" />



                                                        <Style.Triggers>



                                                            <DataTrigger Binding="{Binding Action}" Value="Block">



                                                                <Setter Property="Background" Value="#20D83B01" />



                                                                <Setter Property="BorderBrush" Value="#40D83B01" />



                                                            </DataTrigger>



                                                        </Style.Triggers>



                                                    </Style>



                                                </Border.Style>



                                                <TextBlock FontSize="11" FontWeight="SemiBold">



                                                    <TextBlock.Style>



                                                        <Style TargetType="TextBlock">



                                                            <Setter Property="Text" Value="Allow" />



                                                            <Setter Property="Foreground" Value="#107C41" />



                                                            <Style.Triggers>



                                                                <DataTrigger Binding="{Binding Action}" Value="Block">



                                                                    <Setter Property="Text" Value="Block" />



                                                                    <Setter Property="Foreground" Value="#D83B01" />



                                                                </DataTrigger>



                                                            </Style.Triggers>



                                                        </Style>



                                                    </TextBlock.Style>



                                                </TextBlock>



                                            </Border>



                                        </DataTemplate>



                                    </DataGridTemplateColumn.CellTemplate>



                                </DataGridTemplateColumn>







                                <!-- Направление -->



                                <DataGridTemplateColumn Header="{Binding NetColDirection, Source={StaticResource Loc}}" Width="80">



                                    <DataGridTemplateColumn.CellTemplate>



                                        <DataTemplate>



                                            <Border Background="{ui:ThemeResource CardBackgroundFillColorSecondaryBrush}"



                                                    CornerRadius="4" Padding="6,2"



                                                    HorizontalAlignment="Left" VerticalAlignment="Center">



                                                <TextBlock FontSize="11" FontWeight="SemiBold"



                                                           Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}">



                                                    <TextBlock.Style>



                                                        <Style TargetType="TextBlock">



                                                            <Setter Property="Text" Value="In" />



                                                            <Style.Triggers>



                                                                <DataTrigger Binding="{Binding Direction}" Value="Outbound">



                                                                    <Setter Property="Text" Value="Out" />



                                                                </DataTrigger>



                                                                <DataTrigger Binding="{Binding Direction}" Value="Both">



                                                                    <Setter Property="Text" Value="In+Out" />



                                                                </DataTrigger>



                                                            </Style.Triggers>



                                                        </Style>



                                                    </TextBlock.Style>



                                                </TextBlock>



                                            </Border>



                                        </DataTemplate>



                                    </DataGridTemplateColumn.CellTemplate>



                                </DataGridTemplateColumn>







                                <DataGridTextColumn Header="{Binding NetColName, Source={StaticResource Loc}}" Binding="{Binding Name}" Width="2*" />



                                <DataGridTextColumn Header="{Binding NetColProgram, Source={StaticResource Loc}}" Binding="{Binding ShortProgram}" Width="1.5*" />



                                <DataGridTextColumn Header="{Binding NetColProtocol, Source={StaticResource Loc}}" Binding="{Binding ProtocolDisplay}" Width="80" />



                                <DataGridTextColumn Header="{Binding NetColLocalPorts, Source={StaticResource Loc}}" Binding="{Binding LocalPorts}" Width="110" />



                                <DataGridTextColumn Header="{Binding NetColRemoteAddresses, Source={StaticResource Loc}}" Binding="{Binding RemoteAddresses}" Width="1.5*" />



                                <DataGridTextColumn Header="{Binding NetColProfiles, Source={StaticResource Loc}}" Binding="{Binding ProfilesDisplay}" Width="130" />



                            </DataGrid.Columns>



                        </DataGrid>







                        <StackPanel x:Name="PanelRulesEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">



                            <ui:SymbolIcon Symbol="Shield24" FontSize="32"



                                           Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"



                                           HorizontalAlignment="Center" Margin="0,0,0,8" />



                            <TextBlock Text="{Binding NetNoRulesTitle, Source={StaticResource Loc}}" FontSize="14" FontWeight="SemiBold"



                                       Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"



                                       HorizontalAlignment="Center" />



                            <TextBlock Text="{Binding NetNoRulesSubtitle, Source={StaticResource Loc}}" FontSize="12"



                                       Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"



                                       HorizontalAlignment="Center" Margin="0,4,0,0" />



                        </StackPanel>



                    </Grid>



                </Grid>



            </TabItem>







            <!-- Вкладка 2: Port Defender -->



            <TabItem Header="{Binding NetTabPortDefender, Source={StaticResource Loc}}">



                <Grid Margin="0,8,0,0">



                    <Grid.RowDefinitions>



                        <RowDefinition Height="Auto" />



                        <RowDefinition Height="Auto" />



                        <RowDefinition Height="*" />



                    </Grid.RowDefinitions>







                    <ui:Card Grid.Row="0" Margin="0,0,0,12" Padding="14">
                        <StackPanel>
                            <TextBlock x:Name="TxtDefenderState" Text="{Binding NetDefenderStateLoading, Source={StaticResource Loc}}"



                                           FontSize="13" FontWeight="SemiBold"



                                           Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="TxtDefenderDetails" Text="—" FontSize="12" TextWrapping="Wrap"



                                           Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}" Margin="0,2,0,0" />
                            <WrapPanel Margin="0,12,0,0"><ui:Button x:Name="BtnConfigureDefender" Appearance="Primary"



                                           Content="{Binding PortDefenderTitle, Source={StaticResource Loc}}"



                                           Click="OnConfigureDefenderClick" Margin="0,0,8,0" />
<ui:Button x:Name="BtnRefreshDefender" Appearance="Secondary"



                                           Content="{Binding NetBtnRefreshRules, Source={StaticResource Loc}}" Click="OnRefreshDefenderClick" /></WrapPanel>
                        </StackPanel>
                    </ui:Card>







                    <ui:Card Grid.Row="1" Grid.RowSpan="2" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Шапка списка портов и кнопки действий -->
                            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock x:Name="TxtDefenderPortsCountBadge" Text="{Binding [DefenderPortsEmpty], Source={StaticResource Loc}}" FontSize="11" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                                <WrapPanel Margin="0,8,0,0"><ui:Button x:Name="BtnAddDefenderPort" Appearance="Primary" Icon="{ui:SymbolIcon Add24}" Content="{Binding [DefenderAddPort], Source={StaticResource Loc}}" Click="OnAddDefenderPortClick" Margin="0,0,6,0" />
<ui:Button x:Name="BtnEditDefenderPort" Appearance="Secondary" Icon="{ui:SymbolIcon Edit24}" Content="{Binding [DefenderEdit], Source={StaticResource Loc}}" Click="OnEditDefenderPortClick" Margin="0,0,6,0" />
<ui:Button x:Name="BtnDeleteDefenderPort" Appearance="Secondary" Icon="{ui:SymbolIcon Delete24}" Content="{Binding [DefenderDelete], Source={StaticResource Loc}}" Click="OnDeleteDefenderPortClick" /></WrapPanel>
                            </StackPanel>

                            <!-- Интерактивная таблица портов -->
                            <DataGrid Grid.Row="1"
                                      x:Name="GridDefenderProtectedPorts"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserResizeRows="False"
                                      HeadersVisibility="Column"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      MinHeight="180"
                                      Background="Transparent"
                                      BorderThickness="1"
                                      BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                                      MouseDoubleClick="OnGridDefenderPortsMouseDoubleClick"
                                      PreviewKeyDown="OnGridDefenderPortsKeyDown" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <!-- Номер порта -->
                                    <DataGridTemplateColumn Header="{Binding [DefenderPortColumn], Source={StaticResource Loc}}" Width="95">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="4" Background="{ui:ThemeResource ControlFillColorDefaultBrush}" Padding="6,2" HorizontalAlignment="Left" Margin="4,2">
                                                    <TextBlock Text="{Binding FormattedPort}" FontFamily="Consolas, Segoe UI" FontWeight="Bold" FontSize="12" Foreground="{ui:ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Служба -->
                                    <DataGridTemplateColumn Header="{Binding [DefenderServiceColumn], Source={StaticResource Loc}}" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ServiceName}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="4,0" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Уровень риска -->
                                    <DataGridTemplateColumn Header="{Binding [DefenderRiskColumn], Source={StaticResource Loc}}" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="4,2">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#00897B" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding RiskLevel}" Value="Critical">
                                                                    <Setter Property="Background" Value="#D32F2F" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding RiskLevel}" Value="High">
                                                                    <Setter Property="Background" Value="#F57C00" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding RiskLevel}" Value="Medium">
                                                                    <Setter Property="Background" Value="#FBC02D" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding RiskLevel}" Value="Low">
                                                                    <Setter Property="Background" Value="#1976D2" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding RiskBadge}" FontSize="11" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding RiskLevel}" Value="Medium">
                                                                        <Setter Property="Foreground" Value="#212121" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Описание защиты -->
                                    <DataGridTextColumn Header="{Binding [DefenderDescriptionColumn], Source={StaticResource Loc}}" Binding="{Binding Description}" Width="*" MinWidth="160" />

                                    <!-- Действия в строке -->
                                    <DataGridTemplateColumn Header="{Binding NetAclColActions, Source={StaticResource Loc}}" Width="85">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <ui:Button Appearance="Transparent" Padding="4" Margin="0,0,4,0" ToolTip="{Binding [DefenderEditPortTip], Source={StaticResource Loc}}" Click="OnRowEditDefenderPortClick">
                                                        <ui:SymbolIcon Symbol="Edit20" FontSize="14" Foreground="{ui:ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                    </ui:Button>
                                                    <ui:Button Appearance="Transparent" Padding="4" ToolTip="{Binding [DefenderDeletePortTip], Source={StaticResource Loc}}" Click="OnRowDeleteDefenderPortClick">
                                                        <ui:SymbolIcon Symbol="Delete20" FontSize="14" Foreground="#FF5252" />
                                                    </ui:Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Нижняя панель подсказки и сводки -->
                            <Grid Grid.Row="2" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding [DefenderLiveHint], Source={StaticResource Loc}}" FontSize="11" Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding [DefenderActivePorts], Source={StaticResource Loc}}" FontSize="11" Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock x:Name="TxtDefenderPorts" Text="—" FontSize="11" FontFamily="Consolas, Segoe UI" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </ui:Card>



                </Grid>



            </TabItem>







            <!-- Вкладка 3: Журнал атак и банов -->



            <TabItem Header="{Binding NetTabAttackBans, Source={StaticResource Loc}}">



                <Grid Margin="0,8,0,0">



                    <Grid.RowDefinitions>



                        <RowDefinition Height="Auto" />



                        <RowDefinition Height="*" />



                    </Grid.RowDefinitions>







                    <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">



                        <ui:Button x:Name="BtnRefreshBans" Appearance="Secondary" Content="{Binding NetBtnRefreshRules, Source={StaticResource Loc}}"



                                   Click="OnRefreshBansClick" Margin="0,0,8,4" />



                        <ui:Button x:Name="BtnUnblockIp" Appearance="Secondary" Content="{Binding NetBtnUnbanSelectedIp, Source={StaticResource Loc}}"



                                   Click="OnUnblockIpClick" Margin="0,0,8,4" />



                        <ui:Button x:Name="BtnClearBans" Appearance="Danger" Content="{Binding NetBtnResetAllBans, Source={StaticResource Loc}}"



                                   Click="OnClearBansClick" Margin="0,0,0,4" />



                        <TextBlock x:Name="TxtBansCount" Text="—" FontSize="12"



                                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"



                                   VerticalAlignment="Center" Margin="12,0,0,4" />



                    </WrapPanel>







                    <Grid Grid.Row="1">



                        <DataGrid x:Name="GridBans"



                                  AutoGenerateColumns="False"



                                  CanUserAddRows="False"



                                  CanUserDeleteRows="False"



                                  CanUserReorderColumns="False"



                                  IsReadOnly="True"



                                  SelectionMode="Single"



                                  GridLinesVisibility="None"



                                  HeadersVisibility="Column"



                                  BorderThickness="1"



                                  BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"



                                  Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"



                                  RowHeight="34" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.HorizontalScrollBarVisibility="Auto">



                            <DataGrid.Columns>



                                <DataGridTextColumn Header="{Binding NetColIp, Source={StaticResource Loc}}" Binding="{Binding Ip}" Width="130" />



                                <DataGridTextColumn Header="{Binding NetColPort, Source={StaticResource Loc}}" Binding="{Binding TargetPort}" Width="70" />



                                <DataGridTextColumn Header="{Binding NetColProcess, Source={StaticResource Loc}}" Binding="{Binding TargetProcess}" Width="1.5*" />



                                <DataGridTextColumn Header="{Binding NetColAttempts, Source={StaticResource Loc}}" Binding="{Binding AttackRate}" Width="80" />



                                <DataGridTextColumn Header="{Binding NetColReason, Source={StaticResource Loc}}" Binding="{Binding Reason}" Width="2*" />



                                <DataGridTextColumn Header="{Binding NetColRemaining, Source={StaticResource Loc}}" Binding="{Binding RemainingText}" Width="110" />



                                <DataGridTextColumn Header="{Binding NetColRepeats, Source={StaticResource Loc}}" Binding="{Binding RepeatCount}" Width="80" />



                            </DataGrid.Columns>



                        </DataGrid>







                        <StackPanel x:Name="PanelBansEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">



                            <ui:SymbolIcon Symbol="Shield24" FontSize="32"



                                           Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"



                                           HorizontalAlignment="Center" Margin="0,0,0,8" />



                            <TextBlock Text="{Binding NetNoBansTitle, Source={StaticResource Loc}}" FontSize="14" FontWeight="SemiBold"



                                       Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"



                                       HorizontalAlignment="Center" />



                            <TextBlock Text="{Binding NetNoBansSubtitle, Source={StaticResource Loc}}" FontSize="12"



                                       Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"



                                       HorizontalAlignment="Center" Margin="0,4,0,0" />



                        </StackPanel>



                    </Grid>



                </Grid>



            </TabItem>



            <!-- Вкладка 6: История всех подключений -->



            <TabItem Header="{Binding [NetHistoryTitle], Source={StaticResource Loc}}">



                <Grid Margin="0,8,0,0">



                    <Grid.RowDefinitions>



                        <RowDefinition Height="Auto" />



                        <RowDefinition Height="*" />



                        <RowDefinition Height="Auto" />



                    </Grid.RowDefinitions>







                    <!-- Фильтры истории -->



                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <ui:TextBox x:Name="TxtHubHistSearch"



                                    PlaceholderText="{Binding [NetHistorySearch], Source={StaticResource Loc}}"



                                    TextChanged="OnHubHistFilterChanged" Margin="0,0,0,8" />
                        <WrapPanel><StackPanel Margin="0,0,10,8"><TextBlock Text="{Binding [NetUxHistoryVerdict], Source={StaticResource Loc}}" FontSize="11" Margin="0,0,0,4" Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}" /><ComboBox x:Name="CmbHubHistVerdict" Width="160" SelectionChanged="OnHubHistFilterChanged">



                                <ComboBoxItem Content="{Binding [NetHistoryAllVerdicts], Source={StaticResource Loc}}" IsSelected="True" />



                                <ComboBoxItem Content="{Binding [NetHistoryPending], Source={StaticResource Loc}}" />



                                <ComboBoxItem Content="{Binding [NetHistoryAllowed], Source={StaticResource Loc}}" />



                                <ComboBoxItem Content="{Binding [NetHistoryBlocked], Source={StaticResource Loc}}" />



                                <ComboBoxItem Content="{Binding [NetHistoryWhitelist], Source={StaticResource Loc}}" />



                                <ComboBoxItem Content="{Binding [NetHistoryBlacklist], Source={StaticResource Loc}}" />



                                <ComboBoxItem Content="{Binding [NetHistoryRuleCreated], Source={StaticResource Loc}}" />



                            </ComboBox></StackPanel>
<StackPanel Margin="0,0,10,8"><TextBlock Text="{Binding [NetUxHistoryPeriod], Source={StaticResource Loc}}" FontSize="11" Margin="0,0,0,4" Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}" /><ComboBox x:Name="CmbHubHistPeriod" Width="120" SelectionChanged="OnHubHistFilterChanged">



                                <ComboBoxItem Content="{Binding [NetHistoryAllTime], Source={StaticResource Loc}}" IsSelected="True" />



                                <ComboBoxItem Content="{Binding [NetHistoryLastHour], Source={StaticResource Loc}}" />



                                <ComboBoxItem Content="{Binding [NetHistoryToday], Source={StaticResource Loc}}" />



                                <ComboBoxItem Content="{Binding [NetHistoryLastDay], Source={StaticResource Loc}}" />



                            </ComboBox></StackPanel>
<StackPanel Margin="0,0,10,8"><TextBlock Text="{Binding [NetColProtocol], Source={StaticResource Loc}}" FontSize="11" Margin="0,0,0,4" Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}" /><ComboBox x:Name="CmbHubHistProtocol" Width="80" SelectionChanged="OnHubHistFilterChanged">



                                <ComboBoxItem Content="{Binding [NetHistoryAll], Source={StaticResource Loc}}" IsSelected="True" />



                                <ComboBoxItem Content="TCP" />



                                <ComboBoxItem Content="UDP" />



                            </ComboBox></StackPanel></WrapPanel>
                        <WrapPanel Margin="0,0,0,6"><ui:Button x:Name="BtnRefreshHubHist" Content="{Binding [NetHistoryRefresh], Source={StaticResource Loc}}" Icon="{ui:SymbolIcon ArrowClockwise24}"



                                       Appearance="Secondary" Click="OnRefreshHubHistClick" Margin="0,0,6,0" ToolTip="{Binding [NetHistoryRefreshTip], Source={StaticResource Loc}}" />
<ui:Button x:Name="BtnClearHubHist" Content="{Binding [NetHistoryClear], Source={StaticResource Loc}}" Icon="{ui:SymbolIcon Delete24}"



                                       Appearance="Secondary" Click="OnClearHubHistClick" Foreground="{ui:ThemeResource SystemFillColorCriticalBrush}" ToolTip="{Binding [NetHistoryClearTip], Source={StaticResource Loc}}" /></WrapPanel>
                        <TextBlock x:Name="TxtHubHistSummary" Text="—" FontSize="11"



                                   Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>







                    <!-- Таблица истории -->



                    <DataGrid x:Name="GridHubHistory" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"



                              SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal"



                              RowHeight="32" Background="Transparent" BorderThickness="1"



                              BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"



                              SelectionChanged="OnHubHistSelectionChanged" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.HorizontalScrollBarVisibility="Auto">



                        <DataGrid.Columns>



                            <DataGridTextColumn Header="{Binding [NetHistoryTimeColumn], Source={StaticResource Loc}}" Binding="{Binding LocalTimestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Width="140" />



                            <DataGridTextColumn Header="{Binding [NetHistoryProcessColumn], Source={StaticResource Loc}}" Binding="{Binding ProcessName}" Width="140" />



                            <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="65" />



                            <DataGridTextColumn Header="{Binding [NetHistoryProtocolColumn], Source={StaticResource Loc}}" Binding="{Binding Protocol}" Width="75" />



                            <DataGridTemplateColumn Header="{Binding [NetHistoryAddressColumn], Source={StaticResource Loc}}" Width="180">



                                <DataGridTemplateColumn.CellTemplate>



                                    <DataTemplate>



                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">



                                            <TextBlock Text="{Binding CountryFlag}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />



                                            <TextBlock Text="{Binding RemoteAddress}" FontWeight="SemiBold" VerticalAlignment="Center" />



                                            <TextBlock Text="{Binding RemotePort, StringFormat=':{0}'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />



                                        </StackPanel>



                                    </DataTemplate>



                                </DataGridTemplateColumn.CellTemplate>



                            </DataGridTemplateColumn>



                            <DataGridTextColumn Header="{Binding [NetHistoryCountryColumn], Source={StaticResource Loc}}" Binding="{Binding CountryName}" Width="100" />



                            <!-- Категория решения остаётся enum; подпись и её обновление зависят только от ресурсов. -->
                            <DataGridTemplateColumn Header="{Binding [NetHistoryVerdictColumn], Source={StaticResource Loc}}" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding [DefenderUnknown], Source={StaticResource Loc}}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Verdict}" Value="{x:Static firewall:NetworkConnectionVerdict.PendingAlert}"><Setter Property="Text" Value="{Binding [NetHistoryPending], Source={StaticResource Loc}}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding Verdict}" Value="{x:Static firewall:NetworkConnectionVerdict.Allowed}"><Setter Property="Text" Value="{Binding [NetHistoryAllowed], Source={StaticResource Loc}}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding Verdict}" Value="{x:Static firewall:NetworkConnectionVerdict.Blocked}"><Setter Property="Text" Value="{Binding [NetHistoryBlocked], Source={StaticResource Loc}}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding Verdict}" Value="{x:Static firewall:NetworkConnectionVerdict.AllowSession}"><Setter Property="Text" Value="{Binding [NetHistoryAllowedSession], Source={StaticResource Loc}}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding Verdict}" Value="{x:Static firewall:NetworkConnectionVerdict.BlockSession}"><Setter Property="Text" Value="{Binding [NetHistoryBlockedSession], Source={StaticResource Loc}}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding Verdict}" Value="{x:Static firewall:NetworkConnectionVerdict.Whitelisted}"><Setter Property="Text" Value="{Binding [NetHistoryWhitelist], Source={StaticResource Loc}}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding Verdict}" Value="{x:Static firewall:NetworkConnectionVerdict.Blacklisted}"><Setter Property="Text" Value="{Binding [NetHistoryBlacklist], Source={StaticResource Loc}}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding Verdict}" Value="{x:Static firewall:NetworkConnectionVerdict.RuleCreated}"><Setter Property="Text" Value="{Binding [NetHistoryRuleCreated], Source={StaticResource Loc}}" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>



                            <DataGridTextColumn Header="{Binding [NetHistoryDetailsColumn], Source={StaticResource Loc}}" Binding="{Binding Details}" Width="*" MinWidth="160" />



                        </DataGrid.Columns>



                    </DataGrid>







                    <!-- Нижняя панель действий -->



                    <Border Grid.Row="2" Margin="0,8,0,0" Padding="8,6"



                            Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"



                            BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">



                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">



                            <ui:Button x:Name="BtnHubHistAllow" Content="{Binding [NetHistoryAllow], Source={StaticResource Loc}}" Icon="{ui:SymbolIcon ShieldCheckmark24}"



                                       Appearance="Secondary" Click="OnHubHistAllowClick" Margin="0,0,8,0" IsEnabled="False" ToolTip="{Binding [NetHistoryAllowTip], Source={StaticResource Loc}}" />



                            <ui:Button x:Name="BtnHubHistBlock" Content="{Binding [NetHistoryBlock], Source={StaticResource Loc}}" Icon="{ui:SymbolIcon ShieldDismiss24}"



                                       Appearance="Secondary" Click="OnHubHistBlockClick" Margin="0,0,8,0" IsEnabled="False" ToolTip="{Binding [NetHistoryBlockTip], Source={StaticResource Loc}}" />



                            <ui:Button x:Name="BtnHubHistWhitelist" Content="{Binding [NetHistoryAddWhitelist], Source={StaticResource Loc}}" Icon="{ui:SymbolIcon CheckmarkCircle24}"



                                       Appearance="Secondary" Click="OnHubHistWhitelistClick" Margin="0,0,8,0" IsEnabled="False" ToolTip="{Binding [NetHistoryAddWhitelistTip], Source={StaticResource Loc}}" />



                            <ui:Button x:Name="BtnHubHistBlacklist" Content="{Binding [NetHistoryAddBlacklist], Source={StaticResource Loc}}" Icon="{ui:SymbolIcon DismissCircle24}"



                                       Appearance="Secondary" Click="OnHubHistBlacklistClick" Margin="0,0,8,0" IsEnabled="False" ToolTip="{Binding [NetHistoryAddBlacklistTip], Source={StaticResource Loc}}" />



                            <ui:Button x:Name="BtnHubHistOpenFile" Content="{Binding [NetHistoryOpenFolder], Source={StaticResource Loc}}" Icon="{ui:SymbolIcon FolderOpen24}"



                                       Appearance="Secondary" Click="OnHubHistOpenFileClick" Margin="0,0,8,0" IsEnabled="False" ToolTip="{Binding [NetHistoryOpenFolderTip], Source={StaticResource Loc}}" />



                            <ui:Button x:Name="BtnHubHistCopyIp" Content="{Binding [NetHistoryCopyIp], Source={StaticResource Loc}}" Icon="{ui:SymbolIcon Copy24}"



                                       Appearance="Secondary" Click="OnHubHistCopyIpClick" Margin="0,0,8,0" IsEnabled="False" ToolTip="{Binding [NetHistoryCopyIpTip], Source={StaticResource Loc}}" />



                        </WrapPanel>



                    </Border>



                </Grid>



            </TabItem>



        </TabControl>
        </Grid>







        <!-- ===== Статусная строка ===== -->



        <Border Grid.Row="3" Margin="0,10,0,0" Padding="4,8,4,0"
                BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="TxtStatus" Text="{Binding NetStatusReady, Source={StaticResource Loc}}" FontSize="12"



                       Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"



                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </Border>



    </Grid>



</UserControl>


