<ui:FluentWindow 
    x:Class="StartupMonitor.UI.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:models="clr-namespace:StartupMonitor.Shared.Models;assembly=StartupMonitor.Shared"
    Title="{Binding AppName, Source={StaticResource Loc}}"
    Height="800" Width="1200" MinHeight="680" MinWidth="1080"
    WindowStartupLocation="CenterScreen"
    Background="{DynamicResource WindowBackgroundBrush}"
    WindowBackdropType="Mica"
    ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!-- Фоновые эффекты переливов Aurora Glow (Mica / Acrylic depth) -->
        <Grid Grid.RowSpan="3" IsHitTestVisible="False" Opacity="1.0">
            <Ellipse Width="1050" Height="1050" Margin="-260 0 0 -260"
                     VerticalAlignment="Bottom" HorizontalAlignment="Left"
                     Fill="{DynamicResource AuroraGlowBottomLeftBrush}" />
            <Ellipse Width="950" Height="950" Margin="0 -220 -220 0"
                     VerticalAlignment="Top" HorizontalAlignment="Right"
                     Fill="{DynamicResource AuroraGlowTopRightBrush}" />
            <Ellipse Width="800" Height="800" Margin="180 -180 0 0"
                     VerticalAlignment="Top" HorizontalAlignment="Left"
                     Fill="{DynamicResource AuroraGlowCenterBrush}" />
        </Grid>

        <ui:TitleBar Grid.Row="0"
                     ShowMinimize="True" ShowMaximize="True" ShowClose="False" />
 
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Фоновая подложка для контентной области (синхронизирована по цвету с боковым меню) -->
            <Border Grid.Column="1" Background="{DynamicResource ContentBackgroundBrush}" />

            <!-- Боковая панель (полупрозрачное матовое стекло) -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}"
                BorderThickness="0 0 1 0" BorderBrush="{DynamicResource SidebarBorderBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Светящийся неоновый щит-логотип -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="18 20 18 24">
                    <Grid Width="38" Height="38">
                        <Viewbox Width="32" Height="32" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconShieldCheckmark}"
                                  Fill="{StaticResource ShieldGradientBrush}" Stretch="Uniform">
                                <Path.Effect>
                                    <DropShadowEffect Color="#00D2D3" BlurRadius="18" Opacity="0.65" Direction="0" ShadowDepth="0" />
                                </Path.Effect>
                            </Path>
                        </Viewbox>
                    </Grid>
                    <StackPanel Margin="12 0 0 0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AppName, Source={StaticResource Loc}}" FontSize="15" FontWeight="700" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="Real-time Guard" FontSize="10.5" FontWeight="500"
                                   Foreground="#64748B" Margin="0 1 0 0" />
                    </StackPanel>
                </StackPanel>

                <!-- Навигация -->
                <StackPanel Grid.Row="1" Margin="8 0">
                     <Border x:Name="NavItem0" Tag="0" MouseLeftButtonDown="OnNavClick" Style="{StaticResource NavItemStyle}">
                         <Grid>
                             <Rectangle x:Name="NavBar0" Width="3.5" Height="22" HorizontalAlignment="Left" RadiusX="1.75" RadiusY="1.75"
                                        Fill="{StaticResource NavActiveMarkerBrush}" Visibility="Collapsed" />
                             <StackPanel Orientation="Horizontal" Margin="6 0 0 0">
                                 <Viewbox Width="16" Height="16">
                                     <Path Data="{StaticResource IconHome}" Fill="{ui:ThemeResource TextFillColorPrimaryBrush}" Stretch="Uniform" />
                                 </Viewbox>
                                 <TextBlock Text="{Binding NavOverview, Source={StaticResource Loc}}" Style="{StaticResource NavTextStyle}" Margin="10 0 0 0" />
                             </StackPanel>
                         </Grid>
                     </Border>
                     <Border x:Name="NavItem6" Tag="6" MouseLeftButtonDown="OnNavClick" Style="{StaticResource NavItemStyle}">
                         <Grid>
                             <Rectangle x:Name="NavBar6" Width="3.5" Height="22" HorizontalAlignment="Left" RadiusX="1.75" RadiusY="1.75"
                                        Fill="{StaticResource NavActiveMarkerBrush}" Visibility="Collapsed" />
                             <StackPanel Orientation="Horizontal" Margin="6 0 0 0">
                                 <Viewbox Width="16" Height="16">
                                     <Path Data="{StaticResource IconPulse}" Fill="{ui:ThemeResource TextFillColorPrimaryBrush}" Stretch="Uniform" />
                                 </Viewbox>
                                 <TextBlock Text="{Binding NavTaskManager, Source={StaticResource Loc}}" Style="{StaticResource NavTextStyle}" Margin="10 0 0 0" />
                             </StackPanel>
                         </Grid>
                     </Border>
                     <Border x:Name="NavItem7" Tag="7" MouseLeftButtonDown="OnNavClick" Style="{StaticResource NavItemStyle}">
                         <Grid>
                             <Rectangle x:Name="NavBar7" Width="3.5" Height="22" HorizontalAlignment="Left" RadiusX="1.75" RadiusY="1.75"
                                        Fill="{StaticResource NavActiveMarkerBrush}" Visibility="Collapsed" />
                             <StackPanel Orientation="Horizontal" Margin="6 0 0 0">
                                 <Viewbox Width="16" Height="16">
                                     <Path Data="{StaticResource IconBootTime}" Fill="{ui:ThemeResource TextFillColorPrimaryBrush}" Stretch="Uniform" />
                                 </Viewbox>
                                 <TextBlock Text="{Binding NavBootTime, Source={StaticResource Loc}}" Style="{StaticResource NavTextStyle}" Margin="10 0 0 0" />
                             </StackPanel>
                         </Grid>
                     </Border>
                     <Border x:Name="NavItem1" Tag="1" MouseLeftButtonDown="OnNavClick" Style="{StaticResource NavItemStyle}">
                         <Grid>
                             <Rectangle x:Name="NavBar1" Width="3.5" Height="22" HorizontalAlignment="Left" RadiusX="1.75" RadiusY="1.75"
                                        Fill="{StaticResource NavActiveMarkerBrush}" Visibility="Collapsed" />
                             <StackPanel Orientation="Horizontal" Margin="6 0 0 0">
                                 <Viewbox Width="16" Height="16">
                                     <Path Data="{StaticResource IconShieldDismiss}" Fill="{ui:ThemeResource TextFillColorPrimaryBrush}" Stretch="Uniform" />
                                 </Viewbox>
                                 <TextBlock Text="{Binding NavBlacklist, Source={StaticResource Loc}}" Style="{StaticResource NavTextStyle}" Margin="10 0 0 0" />
                             </StackPanel>
                         </Grid>
                     </Border>
                     <Border x:Name="NavItem3" Tag="3" MouseLeftButtonDown="OnNavClick" Style="{StaticResource NavItemStyle}">
                         <Grid>
                             <Rectangle x:Name="NavBar3" Width="3.5" Height="22" HorizontalAlignment="Left" RadiusX="1.75" RadiusY="1.75"
                                        Fill="{StaticResource NavActiveMarkerBrush}" Visibility="Collapsed" />
                             <StackPanel Orientation="Horizontal" Margin="6 0 0 0">
                                 <Viewbox Width="16" Height="16">
                                     <Path Data="{StaticResource IconDelete}" Fill="{ui:ThemeResource TextFillColorPrimaryBrush}" Stretch="Uniform" />
                                 </Viewbox>
                                 <TextBlock Text="{Binding NavRemoved, Source={StaticResource Loc}}" Style="{StaticResource NavTextStyle}" Margin="10 0 0 0" />
                             </StackPanel>
                         </Grid>
                     </Border>
                     <Border x:Name="NavItem4" Tag="4" MouseLeftButtonDown="OnNavClick" Style="{StaticResource NavItemStyle}">
                         <Grid>
                             <Rectangle x:Name="NavBar4" Width="3.5" Height="22" HorizontalAlignment="Left" RadiusX="1.75" RadiusY="1.75"
                                        Fill="{StaticResource NavActiveMarkerBrush}" Visibility="Collapsed" />
                             <StackPanel Orientation="Horizontal" Margin="6 0 0 0">
                                 <Viewbox Width="16" Height="16">
                                     <Path Data="{StaticResource IconHistory}" Fill="{ui:ThemeResource TextFillColorPrimaryBrush}" Stretch="Uniform" />
                                 </Viewbox>
                                 <TextBlock Text="{Binding NavHistory, Source={StaticResource Loc}}" Style="{StaticResource NavTextStyle}" Margin="10 0 0 0" />
                             </StackPanel>
                         </Grid>
                     </Border>
                     <Border x:Name="NavItem5" Tag="5" MouseLeftButtonDown="OnNavClick" Style="{StaticResource NavItemStyle}">
                         <Grid>
                             <Rectangle x:Name="NavBar5" Width="3.5" Height="22" HorizontalAlignment="Left" RadiusX="1.75" RadiusY="1.75"
                                        Fill="{StaticResource NavActiveMarkerBrush}" Visibility="Collapsed" />
                             <StackPanel Orientation="Horizontal" Margin="6 0 0 0">
                                 <Viewbox Width="16" Height="16">
                                     <Path Data="{StaticResource IconDocumentList}" Fill="{ui:ThemeResource TextFillColorPrimaryBrush}" Stretch="Uniform" />
                                 </Viewbox>
                                 <TextBlock Text="{Binding NavLogs, Source={StaticResource Loc}}" Style="{StaticResource NavTextStyle}" Margin="10 0 0 0" />
                             </StackPanel>
                         </Grid>
                     </Border>
                </StackPanel>

                <!-- Настройки и выход -->
                <StackPanel Grid.Row="2" Margin="8 0 8 12">
                     <Border x:Name="NavItem2" Tag="2" MouseLeftButtonDown="OnNavClick" Style="{StaticResource NavItemStyle}">
                         <Grid>
                             <Rectangle x:Name="NavBar2" Width="3.5" Height="22" HorizontalAlignment="Left" RadiusX="1.75" RadiusY="1.75"
                                        Fill="{StaticResource NavActiveMarkerBrush}" Visibility="Collapsed" />
                             <StackPanel Orientation="Horizontal" Margin="6 0 0 0">
                                 <Viewbox Width="16" Height="16">
                                     <Path Data="{StaticResource IconSettings}" Fill="{ui:ThemeResource TextFillColorPrimaryBrush}" Stretch="Uniform" />
                                 </Viewbox>
                                 <TextBlock Text="{Binding NavSettings, Source={StaticResource Loc}}" Style="{StaticResource NavTextStyle}" Margin="10 0 0 0" />
                             </StackPanel>
                         </Grid>
                     </Border>
                     <Border Tag="Exit" MouseLeftButtonDown="OnExitClick" Style="{StaticResource NavItemStyle}">
                         <StackPanel Orientation="Horizontal" Margin="6 0 0 0">
                             <Viewbox Width="16" Height="16">
                                 <Path Data="{StaticResource IconArrowExit}" Fill="{ui:ThemeResource TextFillColorSecondaryBrush}" Stretch="Uniform" />
                             </Viewbox>
                             <TextBlock Text="{Binding NavExit, Source={StaticResource Loc}}" Style="{StaticResource NavTextStyle}" Margin="10 0 0 0"
                                        Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                         </StackPanel>
                     </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Контент -->
        <Grid Grid.Column="1" x:Name="OverviewPage" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Disabled">
                <StackPanel Margin="32 0 32 14">
                    <!-- Заголовок и статус здоровья системы с кнопкой экспорта -->
                    <Grid Margin="0 0 0 20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding NavOverview, Source={StaticResource Loc}}" FontSize="28" FontWeight="700" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" Margin="0 0 0 4" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SystemHealthPrefix, Source={StaticResource Loc}}" FontSize="13" Foreground="#94A3B8" VerticalAlignment="Center" />
                                <Border Background="{StaticResource BadgeGreenBackgroundBrush}" BorderBrush="{StaticResource BadgeGreenBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8 2" Margin="6 0 0 0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="#10B981" Margin="0 0 6 0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding SystemHealthStatus}" FontSize="11.5" FontWeight="600" Foreground="{StaticResource BadgeGreenTextBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- Кнопки управления: Пауза мониторинга, Снимки системы и экспорт отчета -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <ui:Button Margin="0 0 8 0"
                                       Content="{Binding PauseMonitoringButtonText}"
                                       Appearance="{Binding PauseMonitoringButtonAppearance}"
                                       Command="{Binding TogglePauseMonitoringCommand}"
                                       ToolTip="{Binding PauseMonitoringButtonTooltip}"
                                       Padding="14 8" CornerRadius="8">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon>
                                        <ui:SymbolIcon.Style>
                                            <Style TargetType="ui:SymbolIcon">
                                                <Setter Property="Symbol" Value="Pause24" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMonitoringPaused}" Value="True">
                                                        <Setter Property="Symbol" Value="Play24" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:SymbolIcon.Style>
                                    </ui:SymbolIcon>
                                </ui:Button.Icon>
                            </ui:Button>

                            <ui:Button Margin="0 0 8 0"
                                       Content="{Binding SnapshotsBtn, Source={StaticResource Loc}}"
                                       Icon="{ui:SymbolIcon Camera24}"
                                       Appearance="Secondary"
                                       Command="{Binding OpenSnapshotsCommand}"
                                       ToolTip="{Binding SnapshotsSubtitle, Source={StaticResource Loc}}"
                                       Padding="14 8" CornerRadius="8" />

                            <ui:Button Margin="0 0 8 0"
                                       Content="{Binding SysInfoBtn, Source={StaticResource Loc}}"
                                       Icon="{ui:SymbolIcon Desktop24}"
                                       Appearance="Secondary"
                                       Command="{Binding OpenSystemInfoCommand}"
                                       ToolTip="{Binding SysInfoTooltip, Source={StaticResource Loc}}"
                                       Padding="14 8" CornerRadius="8" />

                            <ui:Button Content="{Binding BtnExportReport, Source={StaticResource Loc}}"
                                       Icon="{ui:SymbolIcon ArrowDownload24}"
                                       Appearance="Secondary"
                                       Command="{Binding ExportReportCommand}"
                                       ToolTip="{Binding TooltipExportReport, Source={StaticResource Loc}}"
                                       Padding="14 8" CornerRadius="8" />
                        </StackPanel>
                    </Grid>

                    <!-- 4 Стеклянные карточки метрик -->
                    <Grid Margin="0 0 0 16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Карточка 1: Всего записей с неоновым кантом и бейджем +3 -->
                        <Border Grid.Column="0" Margin="0 0 6 0" Style="{StaticResource FluentGlassCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <TextBlock Text="{Binding CardTotal, Source={StaticResource Loc}}" FontSize="12" FontWeight="500" Foreground="#94A3B8" VerticalAlignment="Center" />
                                    <Border HorizontalAlignment="Right" Style="{StaticResource BadgeGreenPill}">
                                        <TextBlock Text="{Binding TotalBadgeText}" FontSize="10.5" FontWeight="700" Foreground="{StaticResource BadgeGreenTextBrush}" />
                                    </Border>
                                </Grid>
                                <TextBlock Grid.Row="1" Text="{Binding TotalCount}" FontSize="32" FontWeight="700" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" Margin="0 2 0 4" VerticalAlignment="Center" />
                                <!-- Нижний неоновый кант -->
                                <Border Grid.Row="2" Height="2.5" CornerRadius="1.25" Background="{StaticResource CardNeonAccentBrush}">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#00F2FE" BlurRadius="8" Opacity="0.75" Direction="0" ShadowDepth="0" />
                                    </Border.Effect>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Карточка 2: Активные программы с бейджем Стабильно -->
                        <Border Grid.Column="1" Margin="6 0" Style="{StaticResource FluentGlassCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <TextBlock Text="{Binding CardEnabled, Source={StaticResource Loc}}" FontSize="12" FontWeight="500" Foreground="#94A3B8" VerticalAlignment="Center" />
                                    <Border HorizontalAlignment="Right" Style="{StaticResource BadgeBluePill}">
                                        <TextBlock Text="{Binding EnabledBadgeText}" FontSize="10.5" FontWeight="600" Foreground="{StaticResource BadgeBlueTextBrush}" />
                                    </Border>
                                </Grid>
                                <TextBlock Grid.Row="1" Text="{Binding EnabledCount}" FontSize="32" FontWeight="700" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" Margin="0 2 0 0" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Карточка 3: Заблокировано с бейджем +1 -->
                        <Border Grid.Column="2" Margin="6 0" Style="{StaticResource FluentGlassCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <TextBlock Text="{Binding CardBlocked, Source={StaticResource Loc}}" FontSize="12" FontWeight="500" Foreground="#94A3B8" VerticalAlignment="Center" />
                                    <Border HorizontalAlignment="Right" Style="{StaticResource BadgeRedPill}">
                                        <TextBlock Text="{Binding BlockedBadgeText}" FontSize="10.5" FontWeight="700" Foreground="{StaticResource BadgeRedTextBrush}" />
                                    </Border>
                                </Grid>
                                <TextBlock Grid.Row="1" Text="{Binding BlockedCount}" FontSize="32" FontWeight="700" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" Margin="0 2 0 0" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Карточка 4: Загрузка CPU со спидометром -->
                        <Border Grid.Column="3" Margin="6 0 0 0" Style="{StaticResource FluentGlassCard}" ToolTip="{Binding CurrentCpuUsageText}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <TextBlock Text="{Binding CpuThrottleLabel, Source={StaticResource Loc}}" FontSize="12" FontWeight="500" Foreground="#94A3B8" VerticalAlignment="Center" />
                                    <Border HorizontalAlignment="Right" Style="{StaticResource BadgeBluePill}">
                                        <TextBlock Text="CPU" FontSize="10.5" FontWeight="700" Foreground="{StaticResource BadgeBlueTextBrush}" />
                                    </Border>
                                </Grid>
                                <Grid Grid.Row="1" Margin="0 2 0 0" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CpuUsagePercentText}" FontSize="24" FontWeight="700" Foreground="#00D2D3" />
                                        <TextBlock Text="{Binding CpuUsageDetailText}" FontSize="10.5" Foreground="#64748B" Margin="0 1 0 0" />
                                    </StackPanel>
                                    <ui:SymbolIcon Grid.Column="1" Symbol="TopSpeed24" FontSize="26" 
                                                   VerticalAlignment="Center" Margin="0 0 4 0"
                                                   Foreground="#00D2D3" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Поиск и фильтры -->
                    <StackPanel>
                        <Grid Margin="0 0 0 10">
                            <ui:TextBox PlaceholderText="{Binding SearchPlaceholder, Source={StaticResource Loc}}"
                                        Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Margin="0 0 4 0" Padding="4"
                                       Icon="{ui:SymbolIcon Dismiss24}"
                                       ToolTip="{Binding ClearSearch, Source={StaticResource Loc}}"
                                       Command="{Binding ClearSearchCommand}"
                                       Visibility="{Binding SearchText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding TableHeaderStartupApps, Source={StaticResource Loc}}" 
                                       FontSize="16" FontWeight="700" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />

                            <WrapPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
                                <ui:Button Content="{Binding FilterAll, Source={StaticResource Loc}}" Margin="0 0 4 0"
                                           Icon="{ui:SymbolIcon Filter24}"
                                           Style="{DynamicResource FilterTabButtonStyle}"
                                           Appearance="{Binding CurrentFilter, Converter={StaticResource FilterToAppearanceConverter}, ConverterParameter=all}"
                                           Command="{Binding FilterAllCommand}" />
                                <ui:Button Content="{Binding FilterRegistry, Source={StaticResource Loc}}" Margin="0 0 4 0"
                                           Icon="{ui:SymbolIcon Database24}"
                                           Style="{DynamicResource FilterTabButtonStyle}"
                                           Appearance="{Binding CurrentFilter, Converter={StaticResource FilterToAppearanceConverter}, ConverterParameter=registry}"
                                           Command="{Binding FilterRegistryCommand}" />
                                <ui:Button Content="{Binding FilterFolder, Source={StaticResource Loc}}" Margin="0 0 4 0"
                                           Icon="{ui:SymbolIcon Folder24}"
                                           Style="{DynamicResource FilterTabButtonStyle}"
                                           Appearance="{Binding CurrentFilter, Converter={StaticResource FilterToAppearanceConverter}, ConverterParameter=folder}"
                                           Command="{Binding FilterFolderCommand}" />
                                <ui:Button Content="{Binding FilterServices, Source={StaticResource Loc}}" Margin="0 0 4 0"
                                           Icon="{ui:SymbolIcon ServiceBell24}"
                                           Style="{DynamicResource FilterTabButtonStyle}"
                                           Appearance="{Binding CurrentFilter, Converter={StaticResource FilterToAppearanceConverter}, ConverterParameter=services}"
                                           Command="{Binding FilterServicesCommand}" />
                                <ui:Button Content="{Binding FilterTasks, Source={StaticResource Loc}}" Margin="0 0 4 0"
                                           Icon="{ui:SymbolIcon TaskListLtr24}"
                                           Style="{DynamicResource FilterTabButtonStyle}"
                                           Appearance="{Binding CurrentFilter, Converter={StaticResource FilterToAppearanceConverter}, ConverterParameter=tasks}"
                                           Command="{Binding FilterTasksCommand}" />
                                <ui:Button Content="{Binding FilterRecent, Source={StaticResource Loc}}" Margin="0 0 4 0"
                                           Icon="{ui:SymbolIcon Clock24}"
                                           Style="{DynamicResource FilterTabButtonStyle}"
                                           Appearance="{Binding CurrentFilter, Converter={StaticResource FilterToAppearanceConverter}, ConverterParameter=recent}"
                                           Command="{Binding FilterRecentCommand}" />
                                <ui:Button Content="{Binding FilterOther, Source={StaticResource Loc}}" Margin="0 0 4 0"
                                           Icon="{ui:SymbolIcon Grid24}"
                                           Style="{DynamicResource FilterTabButtonStyle}"
                                           Appearance="{Binding CurrentFilter, Converter={StaticResource FilterToAppearanceConverter}, ConverterParameter=other}"
                                           Command="{Binding FilterOtherCommand}" />
                                <ui:Button Icon="{ui:SymbolIcon ArrowSync24}" Appearance="Transparent" 
                                           Command="{Binding LoadDataCommand}" ToolTip="{Binding RefreshTooltip, Source={StaticResource Loc}}" />
                                <ui:Button Icon="{ui:SymbolIcon ArrowDownload24}" Appearance="Transparent" 
                                           Command="{Binding ExportReportCommand}" ToolTip="{Binding TooltipExportReport, Source={StaticResource Loc}}"
                                           Margin="2 0 0 0" />
                                <ui:Button Icon="{ui:SymbolIcon Camera24}" Appearance="Transparent" 
                                           Command="{Binding OpenSnapshotsCommand}" ToolTip="{Binding SnapshotsTitle, Source={StaticResource Loc}}"
                                           Margin="2 0 0 0" />
                            </WrapPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Карточка-баннер активного сравнения со снимком («Было — Стало») -->
                    <Border Visibility="{Binding IsSnapshotComparisonActive, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Margin="0 10 0 0" Padding="12 8" CornerRadius="8"
                            Background="#1A3B82F6" BorderBrush="#603B82F6" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ui:SymbolIcon Grid.Column="0" Symbol="Camera24" Foreground="#3B82F6" FontSize="16" Margin="0 0 10 0" VerticalAlignment="Center" />

                            <TextBlock Grid.Column="1" Text="{Binding ActiveSnapshotComparisonText}"
                                       FontSize="12.5" FontWeight="600" Foreground="#60A5FA"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                            <ui:Button Grid.Column="2" Appearance="Transparent"
                                       Content="{Binding SnapshotResetFilter, Source={StaticResource Loc}}"
                                       Command="{Binding ResetSnapshotComparisonCommand}"
                                       Icon="{ui:SymbolIcon Dismiss24}"
                                       Foreground="#94A3B8" Padding="10 4" Margin="8 0 0 0" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="1" Margin="32 0 32 16"
                    Background="{DynamicResource TableContainerBackgroundBrush}"
                    BorderBrush="{DynamicResource TableContainerBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Заголовки колонок таблицы -->
                    <Border Grid.Row="0" BorderThickness="0 0 0 1"
                            BorderBrush="{DynamicResource TableRowBorderBrush}"
                            Padding="12 8 12 8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="135" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="95" />
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="65" />
                                <ColumnDefinition Width="175" />
                            </Grid.ColumnDefinitions>

                            <!-- Колонка 0: Иконка (без надписи в шапке для чистоты верстки) -->

                            <TextBlock Grid.Column="1" FontSize="11.5" FontWeight="600"
                                       Foreground="#94A3B8" Cursor="Hand" VerticalAlignment="Center" Margin="6 0 0 0">
                                <Hyperlink Command="{Binding SortByNameCommand}" TextDecorations="None">
                                    <Run Text="{Binding ColumnName, Source={StaticResource Loc}, Mode=OneWay}" /><Run Text="{Binding SortNameIndicator, Mode=OneWay}" />
                                </Hyperlink>
                                <Run Text=" / " Foreground="#64748B" />
                                <Hyperlink Command="{Binding SortByDateCommand}" TextDecorations="None">
                                    <Run Text="{Binding ColumnDate, Source={StaticResource Loc}, Mode=OneWay}" /><Run Text="{Binding SortDateIndicator, Mode=OneWay}" />
                                </Hyperlink>
                            </TextBlock>

                            <TextBlock Grid.Column="2" FontSize="11.5" FontWeight="600"
                                       Foreground="#94A3B8" Cursor="Hand" VerticalAlignment="Center">
                                <Hyperlink Command="{Binding SortByPublisherCommand}" TextDecorations="None">
                                    <Run Text="{Binding ColumnPublisher, Source={StaticResource Loc}, Mode=OneWay}" /><Run Text="{Binding SortPublisherIndicator, Mode=OneWay}" />
                                </Hyperlink>
                            </TextBlock>

                            <TextBlock Grid.Column="3" FontSize="11.5" FontWeight="600"
                                       Foreground="#94A3B8" TextAlignment="Center" Cursor="Hand" VerticalAlignment="Center">
                                <Hyperlink Command="{Binding SortByImpactCommand}" TextDecorations="None">
                                    <Run Text="{Binding ColumnBootImpact, Source={StaticResource Loc}, Mode=OneWay}" /><Run Text="{Binding SortImpactIndicator, Mode=OneWay}" />
                                </Hyperlink>
                            </TextBlock>

                            <TextBlock Grid.Column="4" FontSize="11.5" FontWeight="600"
                                       Foreground="#94A3B8" TextAlignment="Center" Cursor="Hand" VerticalAlignment="Center">
                                <Hyperlink Command="{Binding SortByRatingCommand}" TextDecorations="None">
                                    <Run Text="{Binding ColumnRating, Source={StaticResource Loc}, Mode=OneWay}" /><Run Text="{Binding SortRatingIndicator, Mode=OneWay}" />
                                </Hyperlink>
                            </TextBlock>

                            <!-- Колонка 5: Безопасность / CIRCL (компактная иконка щита вместо обрезанного текста) -->
                            <TextBlock Grid.Column="5" FontSize="11" FontWeight="600"
                                       Foreground="#94A3B8" TextAlignment="Center" Cursor="Hand" VerticalAlignment="Center"
                                       ToolTip="{Binding ColumnSecurity, Source={StaticResource Loc}}">
                                <Hyperlink Command="{Binding SortByKasperskyCommand}" TextDecorations="None">
                                    <ui:SymbolIcon Symbol="Shield24" FontSize="14" Foreground="#94A3B8" />
                                    <Run Text="{Binding SortKasperskyIndicator, Mode=OneWay}" />
                                </Hyperlink>
                            </TextBlock>

                            <TextBlock Grid.Column="6" FontSize="11.5" FontWeight="600"
                                       Foreground="#94A3B8" TextAlignment="Center" Cursor="Hand" VerticalAlignment="Center">
                                <Hyperlink Command="{Binding SortByStatusCommand}" TextDecorations="None">
                                    <Run Text="{Binding ColumnStatus, Source={StaticResource Loc}, Mode=OneWay}" /><Run Text="{Binding SortStatusIndicator, Mode=OneWay}" />
                                </Hyperlink>
                            </TextBlock>

                            <TextBlock Grid.Column="7" Text="{Binding ColumnActions, Source={StaticResource Loc}}"
                                       FontSize="11.5" FontWeight="600" Foreground="#94A3B8"
                                       TextAlignment="Right" VerticalAlignment="Center" Margin="0 0 8 0" />
                        </Grid>
                    </Border>

                    <!-- Список записей автозапуска -->
                    <ListBox Grid.Row="1" x:Name="EntryList"
                             ItemsSource="{Binding FilteredEntries}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling"
                             ContextMenuOpening="OnContextMenuOpening">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="12 7" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="BorderThickness" Value="0 0 0 1" />
                                <Setter Property="BorderBrush" Value="{DynamicResource TableRowBorderBrush}" />

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:EntryStatus.Disabled}">
                                        <Setter Property="Opacity" Value="0.65" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:EntryStatus.Blocked}">
                                        <Setter Property="Background" Value="#12EF4444" />
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource TableRowHoverBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource TableRowHoverBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource TableRowBorderBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="135" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="95" />
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="65" />
                                        <ColumnDefinition Width="175" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Колонка 0: Иконка программы со скруглением -->
                                    <Grid Grid.Column="0" Width="30" Height="30" VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <Border CornerRadius="6" Background="#14FFFFFF" />
                                        <ui:SymbolIcon Symbol="AppGeneric24" FontSize="18"
                                                       Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        <Image Source="{Binding FilePath, Converter={StaticResource FilePathToIconConverter}}"
                                               Width="28" Height="28"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Grid>

                                    <!-- Колонка 1: Название программы и путь -->
                                    <Grid Grid.Column="1" VerticalAlignment="Center" Margin="6 0 10 0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="600" FontSize="13"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{Binding Status, Converter={StaticResource StatusToColorConverter}}" />

                                            <!-- Эвристический бейдж подозрительной команды -->
                                            <Border Visibility="{Binding HasThreat, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    Margin="8 0 0 0" Padding="6 1" CornerRadius="4" VerticalAlignment="Center"
                                                    Background="{Binding ThreatInfo.ThreatLevel, Converter={StaticResource ThreatLevelToBackgroundConverter}}"
                                                    BorderBrush="{Binding ThreatInfo.ThreatLevel, Converter={StaticResource ThreatLevelToBorderConverter}}"
                                                    BorderThickness="1">
                                                <Border.ToolTip>
                                                    <ToolTip Placement="Top" MaxWidth="450">
                                                        <Border Background="#F0101721" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="8" Padding="10">
                                                            <StackPanel>
                                                                <StackPanel Orientation="Horizontal" Margin="0 0 0 4">
                                                                    <ui:SymbolIcon Symbol="Warning24" 
                                                                                   Foreground="{Binding ThreatInfo.ThreatLevel, Converter={StaticResource ThreatLevelToForegroundConverter}}" 
                                                                                   Margin="0 0 6 0" />
                                                                    <TextBlock Text="{Binding ThreatInfo.BadgeText}" FontWeight="Bold" FontSize="12.5" Foreground="#F8FAFC" />
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding ThreatInfo.Description}" TextWrapping="Wrap" Margin="0 2 0 6" FontSize="11" Foreground="#CBD5E1" />
                                                                <TextBlock Text="Индикаторы эвристики:" FontWeight="SemiBold" FontSize="10.5" Foreground="#94A3B8" Margin="0 0 0 2" />
                                                                <ItemsControl ItemsSource="{Binding ThreatInfo.Indicators}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <TextBlock Text="{Binding StringFormat='• {0}'}" FontSize="10" Foreground="#F87171" Margin="4 1" TextWrapping="Wrap" />
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </Border>
                                                    </ToolTip>
                                                </Border.ToolTip>
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Warning24" FontSize="10" Margin="0 0 3 0" VerticalAlignment="Center"
                                                                   Foreground="{Binding ThreatInfo.ThreatLevel, Converter={StaticResource ThreatLevelToForegroundConverter}}" />
                                                    <TextBlock Text="{Binding ThreatInfo.BadgeText}" FontSize="10" FontWeight="600"
                                                               Foreground="{Binding ThreatInfo.ThreatLevel, Converter={StaticResource ThreatLevelToForegroundConverter}}" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Бейдж отложенного запуска -->
                                            <Border Visibility="{Binding Status, Converter={StaticResource StatusToVisibilityConverter}, ConverterParameter=Delayed}"
                                                    Margin="8 0 0 0" Padding="6 1" CornerRadius="4" VerticalAlignment="Center"
                                                    Background="#26F59E0B" BorderBrush="#80F59E0B" BorderThickness="1">
                                                <Border.ToolTip>
                                                    <ToolTip Content="Отложенный запуск: программа стартует через заданный интервал после входа в систему" />
                                                </Border.ToolTip>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="⏱ " FontSize="10" VerticalAlignment="Center" Foreground="#F59E0B" />
                                                    <TextBlock Text="{Binding DelaySeconds, StringFormat='{}{0}с'}" FontSize="10" FontWeight="600"
                                                               Foreground="#F59E0B" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Дифференциальный бейдж контрольного снимка («Было — Стало») -->
                                            <Border Visibility="{Binding SnapshotDiffBadge, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"
                                                    Margin="8 0 0 0" Padding="6 1" CornerRadius="4" VerticalAlignment="Center"
                                                    Background="{Binding SnapshotDiffColor, Converter={StaticResource HexToBrushConverter}, ConverterParameter=0.15}"
                                                    BorderBrush="{Binding SnapshotDiffColor, Converter={StaticResource HexToBrushConverter}}"
                                                    BorderThickness="1">
                                                <Border.ToolTip>
                                                    <ToolTip Content="{Binding SnapshotDiffTooltip}" />
                                                </Border.ToolTip>
                                                <TextBlock Text="{Binding SnapshotDiffBadge}" FontSize="10" FontWeight="600"
                                                           Foreground="{Binding SnapshotDiffColor, Converter={StaticResource HexToBrushConverter}}"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" Text="{Binding DisplayPath}"
                                                   TextTrimming="CharacterEllipsis"
                                                   FontSize="10.5" Margin="0 1 0 0"
                                                   Foreground="#64748B" />
                                    </Grid>

                                    <!-- Колонка 2: Издатель (Authenticode бейдж) -->
                                    <Border Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left"
                                            Background="{Binding SignatureStatus, Converter={StaticResource SignatureStatusToBackgroundConverter}}"
                                            BorderBrush="{Binding SignatureStatus, Converter={StaticResource SignatureStatusToBorderConverter}}"
                                            BorderThickness="1" CornerRadius="10" Padding="6 2" MaxWidth="135"
                                            ToolTip="{Binding Converter={StaticResource SignatureStatusToTooltipConverter}}">
                                        <DockPanel LastChildFill="True">
                                            <ui:SymbolIcon Symbol="{Binding SignatureStatus, Converter={StaticResource SignatureStatusToSymbolConverter}}"
                                                           Foreground="{Binding SignatureStatus, Converter={StaticResource SignatureStatusToColorConverter}}"
                                                           FontSize="11" Margin="0 0 4 0" VerticalAlignment="Center" DockPanel.Dock="Left" />
                                            <TextBlock Text="{Binding Publisher, Converter={StaticResource PublisherBadgeConverter}}"
                                                       FontSize="10" FontWeight="500"
                                                       Foreground="{Binding SignatureStatus, Converter={StaticResource SignatureStatusToColorConverter}}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>

                                    <!-- Колонка 3: Влияние на запуск (Цветная таблетка Low/Med/High) -->
                                    <Border Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Background="{Binding Location, Converter={StaticResource LocationToImpactBackgroundConverter}}"
                                            BorderBrush="{Binding Location, Converter={StaticResource LocationToImpactBorderConverter}}"
                                            BorderThickness="1" CornerRadius="10" Padding="8 2" MinWidth="65">
                                        <TextBlock Text="{Binding Location, Converter={StaticResource LocationToImpactTextConverter}}"
                                                   Foreground="{Binding Location, Converter={StaticResource LocationToImpactForegroundConverter}}"
                                                   FontSize="10.5" FontWeight="600"
                                                   TextAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Колонка 4: AI-Рейтинг (Звезды) с подробным тултипом -->
                                    <TextBlock Grid.Column="4"
                                               Text="{Binding AiRating, Converter={StaticResource RatingToStarsConverter}}"
                                               Foreground="{Binding AiRating, Converter={StaticResource RatingToColorConverter}}"
                                               FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock.ToolTip>
                                            <ToolTip Placement="Right" MaxWidth="920" MaxHeight="800">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="780">
                                                    <Border Background="#F0101721" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="8" Padding="12">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="#F8FAFC" TextWrapping="Wrap" />
                                                            <Separator Margin="0,6" Background="#1FFFFFFF" />
                                                             <TextBlock Foreground="#CBD5E1" TextWrapping="Wrap">
                                                                 <Run Text="{Binding DetailPath, Source={StaticResource Loc}, Mode=OneWay}" /> <Run Text="{Binding FilePath, Mode=OneWay}" />
                                                             </TextBlock>
                                                             <TextBlock Foreground="#CBD5E1" TextWrapping="Wrap">
                                                                 <Run Text="{Binding DetailCommand, Source={StaticResource Loc}, Mode=OneWay}" /> <Run Text="{Binding CommandLine, Mode=OneWay}" />
                                                             </TextBlock>
                                                             <TextBlock Foreground="#CBD5E1" TextWrapping="Wrap">
                                                                 <Run Text="{Binding ColumnPublisher, Source={StaticResource Loc}, Mode=OneWay}" /><Run Text=": " /><Run Text="{Binding Publisher, Mode=OneWay}" />
                                                             </TextBlock>
                                                             <TextBlock Foreground="#CBD5E1" TextWrapping="Wrap">
                                                                 <Run Text="{Binding LocLocationLabel, Source={StaticResource Loc}, Mode=OneWay}" /><Run Text=": " /><Run Text="{Binding Location, Converter={StaticResource LocationToDisplayConverter}, Mode=OneWay}" />
                                                             </TextBlock>
                                                             <TextBlock Foreground="#CBD5E1" TextWrapping="Wrap">
                                                                 <Run Text="{Binding ColumnStatus, Source={StaticResource Loc}, Mode=OneWay}" /><Run Text=": " /><Run Text="{Binding Status, Converter={StaticResource StatusToDisplayConverter}, Mode=OneWay}" />
                                                             </TextBlock>
                                                             <TextBlock Text="{Binding SHA256, StringFormat='SHA256: {0}'}" FontSize="10" Foreground="#64748B" TextWrapping="Wrap" />
                                                             <Separator Margin="0,6" Background="#1FFFFFFF" />
                                                             <TextBlock Text="{Binding ColumnRating, Source={StaticResource Loc}, StringFormat='{}{0}:'}" FontWeight="SemiBold" Foreground="#34D399" />
                                                             <TextBlock Text="{Binding AiRating, Converter={StaticResource RatingToStarsConverter}}" Foreground="{Binding AiRating, Converter={StaticResource RatingToColorConverter}}" TextWrapping="Wrap" />
                                                             <TextBlock Text="{Binding AiCategory, StringFormat='  {0}'}" Foreground="#CBD5E1" TextWrapping="Wrap" />
                                                             <TextBlock Text="{Binding AiRecommendation, StringFormat='  {0}'}" Foreground="#CBD5E1" TextWrapping="Wrap" />
                                                             <TextBlock Text="{Binding AiRisk, StringFormat='  {0}'}" Foreground="#CBD5E1" TextWrapping="Wrap" />
                                                            <Separator Margin="0,6" Background="#1FFFFFFF" />
                                                            <TextBlock Text="Kaspersky OpenTIP:" FontWeight="SemiBold" Foreground="#60A5FA" />
                                                            <TextBlock Text="{Binding KasperskyZone, Converter={StaticResource KasperskyIndicatorConverter}}" Foreground="{Binding KasperskyZone, Converter={StaticResource KasperskyColorConverter}}" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding KasperskyDetection, StringFormat='  Детект: {0}'}" Foreground="#CBD5E1" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding KasperskyFileStatus, StringFormat='  Статус: {0}'}" Foreground="#CBD5E1" TextWrapping="Wrap" />
                                                            <Separator Margin="0,6" Background="#1FFFFFFF" Visibility="{Binding HasThreat, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                            <TextBlock Text="CLI Эвристика:" FontWeight="SemiBold" Foreground="{Binding ThreatInfo.ThreatLevel, Converter={StaticResource ThreatLevelToForegroundConverter}}" Visibility="{Binding HasThreat, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                            <TextBlock Text="{Binding ThreatInfo.BadgeText, StringFormat='  Угроза: {0}'}" Foreground="{Binding ThreatInfo.ThreatLevel, Converter={StaticResource ThreatLevelToForegroundConverter}}" TextWrapping="Wrap" Visibility="{Binding HasThreat, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                            <TextBlock Text="{Binding ThreatInfo.Description, StringFormat='  Описание: {0}'}" Foreground="#CBD5E1" TextWrapping="Wrap" Visibility="{Binding HasThreat, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                        </StackPanel>
                                                    </Border>
                                                </ScrollViewer>
                                            </ToolTip>
                                        </TextBlock.ToolTip>
                                    </TextBlock>

                                    <!-- Колонка 5: Kaspersky OpenTIP Индикатор -->
                                    <Ellipse Grid.Column="5" Width="10" Height="10"
                                             Fill="{Binding KasperskyZone, Converter={StaticResource KasperskyColorConverter}}"
                                             VerticalAlignment="Center" HorizontalAlignment="Center"
                                             ToolTip="{Binding KasperskyFileStatus, StringFormat='Kaspersky: {0}'}">
                                        <Ellipse.Effect>
                                            <DropShadowEffect Color="#00D2D3" BlurRadius="6" Opacity="0.4" Direction="0" ShadowDepth="0" />
                                        </Ellipse.Effect>
                                    </Ellipse>

                                    <!-- Колонка 6: Статус / переключатель автозагрузки (без надписи рядом, по центру под заголовком) -->
                                    <ui:ToggleSwitch Grid.Column="6"
                                                     IsChecked="{Binding Status, Converter={StaticResource StatusToBoolConverter}, Mode=OneWay}"
                                                     Tag="{Binding Id}"
                                                     Click="OnToggleEntryClick"
                                                     MinWidth="0" Padding="0"
                                                     ToolTip="Включить / отключить автозагрузку"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />

                                    <!-- Колонка 7: Действия (Подробнее, Блок) -->
                                    <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0 0 4 0">
                                        <Button Content="{Binding ActionMore, Source={StaticResource Loc}}"
                                                Style="{StaticResource ActionMoreButton}"
                                                ToolTip="Подробные свойства, подпись и анализ"
                                                Click="OnMoreClick" Margin="0 0 6 0" />
                                        <Button Content="{Binding ActionBlock, Source={StaticResource Loc}}"
                                                Style="{StaticResource ActionBlockButton}"
                                                ToolTip="Заблокировать и запретить автозапуск"
                                                Command="{Binding DataContext.BlockEntryByIdCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding Id}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- Страница чёрного списка -->
        <Grid Grid.Column="1" x:Name="BlacklistPage" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="32 0 32 0">
                <TextBlock Text="{Binding BlacklistTitle, Source={StaticResource Loc}}" FontSize="28" FontWeight="600" Margin="0 0 0 8" />
                <TextBlock Text="{Binding BlacklistSubtitle, Source={StaticResource Loc}}" FontSize="18"
                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0 0 0 24" />

                <ui:Card Margin="0 0 0 16">
                    <StackPanel>
                        <TextBlock Text="{Binding AddRuleTitle, Source={StaticResource Loc}}" FontSize="18" FontWeight="600" Margin="0 0 0 12" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ui:TextBox Grid.Column="0" 
                                        PlaceholderText="{Binding RulePlaceholder, Source={StaticResource Loc}}"
                                        Text="{Binding NewRuleValue, Mode=TwoWay}" 
                                        Margin="0 0 8 0" />

                            <ComboBox Grid.Column="1" 
                                         ItemsSource="{Binding MatchTypes}"
                                         SelectedItem="{Binding NewRuleMatchType}"
                                         Margin="0 0 8 0" />

                            <ComboBox Grid.Column="2" 
                                         ItemsSource="{Binding Actions}"
                                         SelectedItem="{Binding NewRuleAction}"
                                         Margin="0 0 8 0" />

                            <ui:Button Grid.Column="3" Content="{Binding AddRuleButton, Source={StaticResource Loc}}" 
                                       Appearance="Primary"
                                       Command="{Binding AddRuleCommand}" />
                        </Grid>
                    </StackPanel>
                </ui:Card>
            </StackPanel>

            <ScrollViewer Grid.Row="1" Margin="32 0 32 16" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Blacklist}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:BlacklistRule}">
                            <ui:Card Margin="0 4" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Value}" FontFamily="Consolas" FontWeight="600" />
                                        <TextBlock Text="{Binding Comment}" FontSize="12"
                                                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding MatchType}" FontSize="12" />
                                        <TextBlock Text="{Binding Action}" FontSize="12"
                                                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>

                                    <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Delete24}"
                                               Appearance="Transparent" Foreground="#E81123"
                                               ToolTip="{Binding DeleteRuleTooltip, Source={StaticResource Loc}}"
                                               Command="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=DataContext.RemoveFromBlacklistCommand}"
                                               CommandParameter="{Binding Id}" />
                                </Grid>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Страница настроек -->
        <ScrollViewer Grid.Column="1" x:Name="SettingsPage" Visibility="Collapsed">
            <StackPanel Margin="32 0 32 0">
                <TextBlock Text="{Binding SettingsTitle, Source={StaticResource Loc}}" FontSize="28" FontWeight="600" Margin="0 0 0 24" />

                <ui:Card>
                    <StackPanel>
                        <TextBlock Text="{Binding GeneralSection, Source={StaticResource Loc}}" FontSize="18" FontWeight="600" Margin="0 0 0 16" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding LanguageLabel, Source={StaticResource Loc}}" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="0" Grid.Column="1" 
                                         ItemsSource="{Binding LanguageOptions}"
                                         SelectedValuePath="Code"
                                         DisplayMemberPath="Display"
                                         SelectedValue="{Binding SelectedLanguageCode, Mode=TwoWay}"
                                         Width="200" HorizontalAlignment="Left" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding ThemeLabel, Source={StaticResource Loc}}" VerticalAlignment="Center" Margin="0 12 0 0" />
                            <ComboBox Grid.Row="1" Grid.Column="1" 
                                         ItemsSource="{Binding ThemeOptions}"
                                         SelectedValuePath="Code"
                                         DisplayMemberPath="Display"
                                         SelectedValue="{Binding SelectedThemeCode, Mode=TwoWay}"
                                         Width="200" HorizontalAlignment="Left" Margin="0 12 0 0" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding NotificationsLabel, Source={StaticResource Loc}}" VerticalAlignment="Center" Margin="0 12 0 0" />
                            <ui:ToggleSwitch Grid.Row="2" Grid.Column="1" Margin="0 12 0 0" 
                                             IsChecked="{Binding NotifyOnNewEntry, Mode=TwoWay}" Content="{Binding NotifyToggle, Source={StaticResource Loc}}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding TrayLabel, Source={StaticResource Loc}}" VerticalAlignment="Center" Margin="0 12 0 0" />
                            <ui:ToggleSwitch Grid.Row="3" Grid.Column="1" Margin="0 12 0 0"
                                             IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" Content="{Binding MinimizeToTrayToggle, Source={StaticResource Loc}}" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding StartWithWindowsLabel, Source={StaticResource Loc}}" VerticalAlignment="Center" Margin="0 12 0 0" />
                            <StackPanel Grid.Row="4" Grid.Column="1" Margin="0 12 0 0">
                                <ui:ToggleSwitch IsChecked="{Binding StartWithWindows, Mode=TwoWay}" Content="{Binding StartWithWindowsToggle, Source={StaticResource Loc}}" />
                            </StackPanel>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="{Binding StrictModeLabel, Source={StaticResource Loc}}" VerticalAlignment="Center" Margin="0 12 0 0" />
                            <StackPanel Grid.Row="5" Grid.Column="1" Margin="0 12 0 0">
                                <ui:ToggleSwitch IsChecked="{Binding StrictMode, Mode=TwoWay}" Content="{Binding StrictModeToggle, Source={StaticResource Loc}}" />
                                <TextBlock Text="{Binding StrictModeDescription, Source={StaticResource Loc}}" FontSize="12"
                                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="{Binding AutoBlockLabel, Source={StaticResource Loc}}" VerticalAlignment="Center" Margin="0 12 0 0" />
                            <StackPanel Grid.Row="6" Grid.Column="1" Margin="0 12 0 0">
                                <ui:ToggleSwitch IsChecked="{Binding AutoBlockOnRemove, Mode=TwoWay}" Content="{Binding AutoBlockToggle, Source={StaticResource Loc}}" />
                            </StackPanel>

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="{Binding SilentModeLabel, Source={StaticResource Loc}}" VerticalAlignment="Center" Margin="0 12 0 0" />
                            <StackPanel Grid.Row="7" Grid.Column="1" Margin="0 12 0 0">
                                <ui:ToggleSwitch IsChecked="{Binding SilentMode, Mode=TwoWay}" Content="{Binding SilentModeToggle, Source={StaticResource Loc}}" />
                            </StackPanel>

                            <TextBlock Grid.Row="8" Grid.Column="0" Text="{Binding KillOnDisableLabel, Source={StaticResource Loc}}" VerticalAlignment="Center" Margin="0 12 0 0" />
                            <StackPanel Grid.Row="8" Grid.Column="1" Margin="0 12 0 0">
                                <ui:ToggleSwitch IsChecked="{Binding KillOnDisable, Mode=TwoWay}" Content="{Binding KillOnDisableToggle, Source={StaticResource Loc}}" />
                                <TextBlock Text="{Binding KillOnDisableDescription, Source={StaticResource Loc}}" FontSize="12"
                                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <TextBlock Grid.Row="9" Grid.Column="0" VerticalAlignment="Center" Margin="0 12 0 0" />
                            <StackPanel Grid.Row="9" Grid.Column="1" Margin="0 12 0 0">
                                <Button Content="{Binding CleanStaleButton, Source={StaticResource Loc}}"
                                        Command="{Binding CleanStaleConfigCommand}"
                                        Width="200" Height="32" HorizontalAlignment="Left" />
                            </StackPanel>

                            <TextBlock Grid.Row="10" Grid.Column="0" Text="{Binding CpuThrottleLabel, Source={StaticResource Loc}}" VerticalAlignment="Center" Margin="0 14 0 0" />
                            <StackPanel Grid.Row="10" Grid.Column="1" Margin="0 14 0 0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:ToggleSwitch IsChecked="{Binding CpuThrottleEnabled, Mode=TwoWay}" Content="{Binding CpuThrottleToggle, Source={StaticResource Loc}}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding CurrentCpuUsageText}" Margin="24 0 0 0" VerticalAlignment="Center"
                                               FontWeight="SemiBold" Foreground="{ui:ThemeResource SystemAccentColorPrimaryBrush}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0 8 0 0" IsEnabled="{Binding CpuThrottleEnabled}">
                                    <TextBlock Text="{Binding CpuThresholdLabel, Source={StaticResource Loc}}" VerticalAlignment="Center" Margin="0 0 8 0"/>
                                    <Slider Minimum="10" Maximum="95" Value="{Binding CpuThrottleThreshold, Mode=TwoWay}" Width="160" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding CpuThrottleThreshold, StringFormat='{} {0}%'}" MinWidth="40" Margin="8 0 0 0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock Text="{Binding CpuThrottleDescription, Source={StaticResource Loc}}" FontSize="12"
                                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0 4 0 0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- Карточка криптографической валидации цифровых подписей Authenticode -->
                <ui:Card Margin="0 16 0 0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0 0 0 8">
                            <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="20" Foreground="{ui:ThemeResource SystemAccentColorPrimaryBrush}" VerticalAlignment="Center" Margin="0 0 10 0" />
                            <TextBlock Text="{Binding AuthenticodeSection, Source={StaticResource Loc}}" FontSize="18" FontWeight="600" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="{Binding AuthenticodeDescription, Source={StaticResource Loc}}"
                                   FontSize="13" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" LineHeight="18" Margin="0 0 0 16" />

                        <!-- Индикатор движка и режима работы -->
                        <Border Background="{ui:ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="8" Padding="14 10" Margin="0 0 0 16"
                                BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="CheckmarkCircle24" FontSize="18"
                                               Foreground="#10B981" VerticalAlignment="Center" Margin="0 0 10 0" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding AuthenticodeEngineStatus, Source={StaticResource Loc}}"
                                               FontWeight="600" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" FontSize="13" />
                                    <TextBlock Text="{Binding AuthenticodeCacheNotice, Source={StaticResource Loc}}"
                                               FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0 2 0 0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Легенда индикаторов статуса подписи -->
                        <TextBlock Text="{Binding AuthenticodeLegendTitle, Source={StaticResource Loc}}"
                                   FontSize="14" FontWeight="SemiBold" Margin="0 0 0 10" />

                        <Grid Margin="0 0 0 12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Действительна -->
                            <Border Grid.Row="0" Grid.Column="0" Background="#1A10B981" BorderBrush="#10B981" BorderThickness="1"
                                    CornerRadius="4" Padding="6 2" HorizontalAlignment="Left" Margin="0 0 12 8">
                                <TextBlock Text="✓ Valid" FontSize="11" FontWeight="SemiBold" Foreground="#10B981" />
                            </Border>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AuthenticodeLegendValid, Source={StaticResource Loc}}"
                                       FontSize="12" VerticalAlignment="Center" Margin="0 0 0 8" />

                            <!-- Истек / Недоверен -->
                            <Border Grid.Row="1" Grid.Column="0" Background="#1AF59E0B" BorderBrush="#F59E0B" BorderThickness="1"
                                    CornerRadius="4" Padding="6 2" HorizontalAlignment="Left" Margin="0 0 12 8">
                                <TextBlock Text="⚠️ Warning" FontSize="11" FontWeight="SemiBold" Foreground="#F59E0B" />
                            </Border>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AuthenticodeLegendUntrusted, Source={StaticResource Loc}}"
                                       FontSize="12" VerticalAlignment="Center" Margin="0 0 0 8" />

                            <!-- Модифицирован -->
                            <Border Grid.Row="2" Grid.Column="0" Background="#1AEF4444" BorderBrush="#EF4444" BorderThickness="1"
                                    CornerRadius="4" Padding="6 2" HorizontalAlignment="Left" Margin="0 0 12 8">
                                <TextBlock Text="⛔ Tampered" FontSize="11" FontWeight="SemiBold" Foreground="#EF4444" />
                            </Border>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AuthenticodeLegendTampered, Source={StaticResource Loc}}"
                                       FontSize="12" VerticalAlignment="Center" Margin="0 0 0 8" />

                            <!-- Без подписи -->
                            <Border Grid.Row="3" Grid.Column="0" Background="#1A64748B" BorderBrush="#64748B" BorderThickness="1"
                                    CornerRadius="4" Padding="6 2" HorizontalAlignment="Left" Margin="0 0 12 0">
                                <TextBlock Text="— Unsigned" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" />
                            </Border>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding AuthenticodeLegendUnsigned, Source={StaticResource Loc}}"
                                       FontSize="12" VerticalAlignment="Center" />
                        </Grid>

                        <Separator Margin="0 8 0 12" Background="{ui:ThemeResource CardStrokeColorDefaultBrush}" />

                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Bot24" FontSize="16" Foreground="{ui:ThemeResource SystemAccentColorPrimaryBrush}" Margin="0 0 8 0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding AuthenticodeAiIntegration, Source={StaticResource Loc}}"
                                       FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </ui:Card>

                <ui:Card Margin="0 16 0 0">
                    <StackPanel>
                        <TextBlock Text="{Binding AiSection, Source={StaticResource Loc}}" FontSize="18" FontWeight="600" Margin="0 0 0 16" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding AiEnableLabel, Source={StaticResource Loc}}" VerticalAlignment="Center" />
                            <StackPanel Grid.Row="0" Grid.Column="1">
                                <ui:ToggleSwitch IsChecked="{Binding AiEnabled, Mode=TwoWay}"
                                                 Content="{Binding AiEnableToggle, Source={StaticResource Loc}}" />
                                <TextBlock Text="{Binding AiEnableDescription, Source={StaticResource Loc}}" FontSize="12"
                                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding AiApiUrlLabel, Source={StaticResource Loc}}" VerticalAlignment="Center" Margin="0 12 0 0" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0 12 0 0">
                                <TextBox Text="{Binding AiApiUrl, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                         MinWidth="500"
                                         IsEnabled="{Binding AiEnabled}" />
                                <TextBlock Text="{Binding AiApiUrlDescription, Source={StaticResource Loc}}" FontSize="12"
                                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding AiModelLabel, Source={StaticResource Loc}}" VerticalAlignment="Center" Margin="0 12 0 0" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0 12 0 0">
                                <TextBox Text="{Binding AiModel, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                         MinWidth="500"
                                         IsEnabled="{Binding AiEnabled}" />
                                <TextBlock Text="{Binding AiModelDescription, Source={StaticResource Loc}}" FontSize="12"
                                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding AiApiKeyLabel, Source={StaticResource Loc}}" VerticalAlignment="Center" Margin="0 12 0 0" />
                            <StackPanel Grid.Row="3" Grid.Column="1" Margin="0 12 0 0">
                                <TextBox Text="{Binding AiApiKey, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                         MinWidth="500"
                                         IsEnabled="{Binding AiEnabled}" />
                                <TextBlock Text="{Binding AiApiKeyDescription, Source={StaticResource Loc}}" FontSize="12"
                                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0 16 0 0" VerticalAlignment="Center">
                                <ui:Button Content="{Binding AiTestConnectionButton, Source={StaticResource Loc}}"
                                           Command="{Binding TestAiConnectionCommand}"
                                           Appearance="Secondary"
                                           IsEnabled="{Binding AiEnabled}"
                                           Margin="0 0 16 0" />
                                <ui:ProgressRing Width="20" Height="20" IsIndeterminate="True" Margin="0 0 12 0"
                                                 Visibility="{Binding IsAiTesting, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding AiTestStatusMessage}"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           MaxWidth="550"
                                           FontWeight="500">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#EF4444" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AiTestSuccess}" Value="True">
                                                    <Setter Property="Foreground" Value="#10B981" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- Карточка антивирусной аналитики (Kaspersky OpenTIP) -->
                <ui:Card Margin="0 16 0 0">
                    <StackPanel>
                        <TextBlock Text="{Binding KasperskySection, Source={StaticResource Loc}}" FontSize="18" FontWeight="600" Margin="0 0 0 4" />
                        <TextBlock Text="{Binding KasperskyDescription, Source={StaticResource Loc}}" FontSize="12"
                                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0 0 0 16" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding KasperskyEnabledLabel, Source={StaticResource Loc}}" VerticalAlignment="Center" />
                            <ui:ToggleSwitch Grid.Row="0" Grid.Column="1"
                                             IsChecked="{Binding KasperskyEnabled, Mode=TwoWay}"
                                             Content="{Binding KasperskyEnabledToggle, Source={StaticResource Loc}}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding KasperskyApiKeyLabel, Source={StaticResource Loc}}" VerticalAlignment="Center" Margin="0 12 0 0" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0 12 0 0">
                                <TextBox Text="{Binding KasperskyApiKey, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                         MinWidth="500"
                                         IsEnabled="{Binding KasperskyEnabled}" />
                                <TextBlock Text="{Binding KasperskyApiKeyDescription, Source={StaticResource Loc}}" FontSize="12"
                                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding KasperskyApiUrlLabel, Source={StaticResource Loc}}" VerticalAlignment="Center" Margin="0 12 0 0" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0 12 0 0">
                                <TextBox Text="{Binding KasperskyApiUrl, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                         MinWidth="500"
                                         IsEnabled="{Binding KasperskyEnabled}" />
                                <TextBlock Text="{Binding KasperskyApiUrlDescription, Source={StaticResource Loc}}" FontSize="12"
                                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0 16 0 0" VerticalAlignment="Center">
                                <ui:Button Content="{Binding KasperskyTestConnectionButton, Source={StaticResource Loc}}"
                                           Command="{Binding TestKasperskyConnectionCommand}"
                                           Appearance="Secondary"
                                           IsEnabled="{Binding KasperskyEnabled}"
                                           Margin="0 0 16 0" />
                                <ui:ProgressRing Width="20" Height="20" IsIndeterminate="True" Margin="0 0 12 0"
                                                 Visibility="{Binding IsKasperskyTesting, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding KasperskyTestStatusMessage}"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           MaxWidth="550"
                                           FontWeight="500">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#EF4444" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding KasperskyTestSuccess}" Value="True">
                                                    <Setter Property="Foreground" Value="#10B981" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- Карточка автоматических политик защиты (Auto-Guards) -->
                <ui:Card Margin="0 16 0 0">
                    <StackPanel>
                        <TextBlock Text="{Binding AutoGuardsSection, Source={StaticResource Loc}}" FontSize="18" FontWeight="600" Margin="0 0 0 4" />
                        <TextBlock Text="{Binding AutoGuardsDescription, Source={StaticResource Loc}}" FontSize="12"
                                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0 0 0 16" />

                        <!-- Выбор режима действия (Аудит vs Активная блокировка) -->
                        <TextBlock Text="{Binding AutoGuardsModeLabel, Source={StaticResource Loc}}" FontSize="14" FontWeight="SemiBold" Margin="0 0 0 8" />
                        <StackPanel Orientation="Horizontal" Margin="0 0 0 16">
                            <RadioButton Content="{Binding AutoGuardsModeAudit, Source={StaticResource Loc}}"
                                         IsChecked="{Binding IsAutoGuardAudit, Mode=TwoWay}"
                                         GroupName="AutoGuardModeGroup" Margin="0 0 24 0" VerticalAlignment="Center" />
                            <RadioButton Content="{Binding AutoGuardsModeEnforce, Source={StaticResource Loc}}"
                                         IsChecked="{Binding IsAutoGuardEnforce, Mode=TwoWay}"
                                         GroupName="AutoGuardModeGroup" VerticalAlignment="Center" />
                        </StackPanel>

                        <Separator Margin="0 0 0 16" Background="{ui:ThemeResource CardStrokeColorDefaultBrush}" />

                        <!-- Политики защиты -->
                        <TextBlock Text="{Binding AutoGuardsRulesLabel, Source={StaticResource Loc}}" FontSize="14" FontWeight="SemiBold" Margin="0 0 0 10" />

                        <Grid Margin="0 0 0 12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 1. Опасные параметры CLI -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding GuardDangerousCliLabel, Source={StaticResource Loc}}" VerticalAlignment="Center" />
                            <StackPanel Grid.Row="0" Grid.Column="1">
                                <ui:ToggleSwitch IsChecked="{Binding GuardBlockDangerousCli, Mode=TwoWay}"
                                                 Content="{Binding GuardDangerousCliToggle, Source={StaticResource Loc}}" />
                                <TextBlock Text="{Binding GuardDangerousCliDescription, Source={StaticResource Loc}}" FontSize="12"
                                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <!-- 2. Каталоги Temp / Public -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding GuardTempPathLabel, Source={StaticResource Loc}}" VerticalAlignment="Center" Margin="0 12 0 0" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0 12 0 0">
                                <ui:ToggleSwitch IsChecked="{Binding GuardBlockTempPath, Mode=TwoWay}"
                                                 Content="{Binding GuardTempPathToggle, Source={StaticResource Loc}}" />
                                <TextBlock Text="{Binding GuardTempPathDescription, Source={StaticResource Loc}}" FontSize="12"
                                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <!-- 3. Скрипты и интерпретаторы -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding GuardScriptsLabel, Source={StaticResource Loc}}" VerticalAlignment="Center" Margin="0 12 0 0" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0 12 0 0">
                                <ui:ToggleSwitch IsChecked="{Binding GuardBlockScripts, Mode=TwoWay}"
                                                 Content="{Binding GuardScriptsToggle, Source={StaticResource Loc}}" />
                                <TextBlock Text="{Binding GuardScriptsDescription, Source={StaticResource Loc}}" FontSize="12"
                                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <!-- 4. Цифровая подпись Authenticode -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding GuardUnsignedLabel, Source={StaticResource Loc}}" VerticalAlignment="Center" Margin="0 12 0 0" />
                            <StackPanel Grid.Row="3" Grid.Column="1" Margin="0 12 0 0">
                                <ui:ToggleSwitch IsChecked="{Binding GuardBlockUnsigned, Mode=TwoWay}"
                                                 Content="{Binding GuardUnsignedToggle, Source={StaticResource Loc}}" />
                                <TextBlock Text="{Binding GuardUnsignedDescription, Source={StaticResource Loc}}" FontSize="12"
                                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <!-- 5. Новые службы Windows -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding GuardNewServicesLabel, Source={StaticResource Loc}}" VerticalAlignment="Center" Margin="0 12 0 0" />
                            <StackPanel Grid.Row="4" Grid.Column="1" Margin="0 12 0 0">
                                <ui:ToggleSwitch IsChecked="{Binding GuardBlockNewServices, Mode=TwoWay}"
                                                 Content="{Binding GuardNewServicesToggle, Source={StaticResource Loc}}" />
                                <TextBlock Text="{Binding GuardNewServicesDescription, Source={StaticResource Loc}}" FontSize="12"
                                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>

                        <!-- Информационная плашка безопасности -->
                        <Border Background="#1E293B" CornerRadius="6" Padding="12 10" Margin="0 8 0 0">
                            <TextBlock Text="{Binding GuardSystemProtectedNotice, Source={StaticResource Loc}}" FontSize="12"
                                       Foreground="#94A3B8" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ui:Card>

                <!-- Карточка удалённых уведомлений (Telegram / Discord) -->
                <ui:Card Margin="0 16 0 0">
                    <StackPanel>
                        <TextBlock Text="{Binding RemoteNotificationsSection, Source={StaticResource Loc}}" FontSize="18" FontWeight="600" Margin="0 0 0 4" />
                        <TextBlock Text="{Binding RemoteNotificationsDescription, Source={StaticResource Loc}}" FontSize="12"
                                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0 0 0 16" />

                        <!-- Секция событий для оповещения -->
                        <TextBlock Text="{Binding RemoteEventsSection, Source={StaticResource Loc}}" FontSize="14" FontWeight="SemiBold" Margin="0 0 0 10" />
                        <WrapPanel Margin="0 0 0 16">
                            <ui:ToggleSwitch IsChecked="{Binding RemoteNotifyOnNewEntry, Mode=TwoWay}"
                                             Content="{Binding RemoteNotifyNewEntryToggle, Source={StaticResource Loc}}"
                                             Margin="0 0 24 8" />
                            <ui:ToggleSwitch IsChecked="{Binding RemoteNotifyOnThreat, Mode=TwoWay}"
                                             Content="{Binding RemoteNotifyThreatToggle, Source={StaticResource Loc}}"
                                             Margin="0 0 24 8" />
                            <ui:ToggleSwitch IsChecked="{Binding RemoteNotifyOnBlocked, Mode=TwoWay}"
                                             Content="{Binding RemoteNotifyBlockedToggle, Source={StaticResource Loc}}"
                                             Margin="0 0 24 8" />
                        </WrapPanel>

                        <Separator Margin="0 4 0 16" Background="{ui:ThemeResource CardStrokeColorDefaultBrush}" />

                        <!-- Секция Telegram -->
                        <Grid Margin="0 0 0 16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding TelegramSection, Source={StaticResource Loc}}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <StackPanel Grid.Row="0" Grid.Column="1">
                                <ui:ToggleSwitch IsChecked="{Binding TelegramEnabled, Mode=TwoWay}"
                                                 Content="{Binding TelegramEnableToggle, Source={StaticResource Loc}}" />
                            </StackPanel>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding TelegramBotTokenLabel, Source={StaticResource Loc}}" VerticalAlignment="Center" Margin="0 12 0 0" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0 12 0 0">
                                <TextBox Text="{Binding TelegramBotToken, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                         MinWidth="500"
                                         IsEnabled="{Binding TelegramEnabled}" />
                                <TextBlock Text="{Binding TelegramBotTokenDescription, Source={StaticResource Loc}}" FontSize="12"
                                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding TelegramChatIdLabel, Source={StaticResource Loc}}" VerticalAlignment="Center" Margin="0 12 0 0" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0 12 0 0">
                                <TextBox Text="{Binding TelegramChatId, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                         MinWidth="500"
                                         IsEnabled="{Binding TelegramEnabled}" />
                                <TextBlock Text="{Binding TelegramChatIdDescription, Source={StaticResource Loc}}" FontSize="12"
                                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0 16 0 0" VerticalAlignment="Center">
                                <ui:Button Content="{Binding TestTelegramButton, Source={StaticResource Loc}}"
                                           Command="{Binding TestTelegramCommand}"
                                           Appearance="Secondary"
                                           IsEnabled="{Binding TelegramEnabled}"
                                           Margin="0 0 16 0" />
                                <ui:ProgressRing Width="20" Height="20" IsIndeterminate="True" Margin="0 0 12 0"
                                                 Visibility="{Binding IsTelegramTesting, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding TelegramTestStatusMessage}"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           MaxWidth="550"
                                           FontWeight="500">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#EF4444" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TelegramTestSuccess}" Value="True">
                                                    <Setter Property="Foreground" Value="#10B981" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>

                        <Separator Margin="0 4 0 16" Background="{ui:ThemeResource CardStrokeColorDefaultBrush}" />

                        <!-- Секция Discord -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding DiscordSection, Source={StaticResource Loc}}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <StackPanel Grid.Row="0" Grid.Column="1">
                                <ui:ToggleSwitch IsChecked="{Binding DiscordWebhookEnabled, Mode=TwoWay}"
                                                 Content="{Binding DiscordEnableToggle, Source={StaticResource Loc}}" />
                            </StackPanel>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding DiscordWebhookUrlLabel, Source={StaticResource Loc}}" VerticalAlignment="Center" Margin="0 12 0 0" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0 12 0 0">
                                <TextBox Text="{Binding DiscordWebhookUrl, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                         MinWidth="500"
                                         IsEnabled="{Binding DiscordWebhookEnabled}" />
                                <TextBlock Text="{Binding DiscordWebhookUrlDescription, Source={StaticResource Loc}}" FontSize="12"
                                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0 16 0 0" VerticalAlignment="Center">
                                <ui:Button Content="{Binding TestDiscordButton, Source={StaticResource Loc}}"
                                           Command="{Binding TestDiscordCommand}"
                                           Appearance="Secondary"
                                           IsEnabled="{Binding DiscordWebhookEnabled}"
                                           Margin="0 0 16 0" />
                                <ui:ProgressRing Width="20" Height="20" IsIndeterminate="True" Margin="0 0 12 0"
                                                 Visibility="{Binding IsDiscordTesting, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding DiscordTestStatusMessage}"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           MaxWidth="550"
                                           FontWeight="500">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#EF4444" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DiscordTestSuccess}" Value="True">
                                                    <Setter Property="Foreground" Value="#10B981" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>

        <!-- Страница удалённых -->
        <Grid Grid.Column="1" x:Name="RemovedPage" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="32 0 32 0">
                <TextBlock Text="{Binding RemovedTitle, Source={StaticResource Loc}}" FontSize="28" FontWeight="600" Margin="0 0 0 8" />
                <TextBlock Text="{Binding RemovedSubtitle, Source={StaticResource Loc}}" FontSize="18"
                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0 0 0 24" />
            </StackPanel>

            <Border Grid.Row="1" Margin="32 0 32 16"
                    Background="{DynamicResource TableContainerBackgroundBrush}"
                    BorderBrush="{DynamicResource TableContainerBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8" Padding="0">
                <ListBox ItemsSource="{Binding RemovedEntries}"
                         BorderThickness="0"
                         Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:RemovedEntry}">
                            <Grid Margin="8 4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Name}" FontWeight="600" />
                                    <TextBlock Text="{Binding FilePath}" FontSize="11"
                                               Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <ui:Button Grid.Column="1" Content="{Binding RemovedRestoreButton, Source={StaticResource Loc}}"
                                           Appearance="Primary"
                                           Command="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=DataContext.RestoreEntryCommand}"
                                           CommandParameter="{Binding Id}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>

        <!-- Страница истории -->
        <Grid Grid.Column="1" x:Name="HistoryPage" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="32 0 32 0">
                <TextBlock Text="{Binding HistoryTitle, Source={StaticResource Loc}}" FontSize="28" FontWeight="600" Margin="0 0 0 8" />
                <TextBlock Text="{Binding HistorySubtitle, Source={StaticResource Loc}}" FontSize="18"
                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0 0 0 24" />
            </StackPanel>

            <Border Grid.Row="1" Margin="32 0 32 16"
                    Background="{DynamicResource TableContainerBackgroundBrush}"
                    BorderBrush="{DynamicResource TableContainerBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8" Padding="0">
                <ListBox ItemsSource="{Binding HistoryEntries}"
                         BorderThickness="0"
                         Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:HistoryEntry}">
                            <Grid Margin="8 4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding LocalTimestamp, StringFormat={}{0:dd.MM HH:mm}}"
                                           FontSize="11" MinWidth="80"
                                           Foreground="{DynamicResource SubtleTextBrush}"
                                           VerticalAlignment="Center" />

                                <StackPanel Grid.Column="1" Margin="12 0 0 0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding ChangeType}"
                                                   FontWeight="600"
                                                   Foreground="{ui:ThemeResource SystemAccentColorPrimaryBrush}" />
                                        <TextBlock Text="—" Margin="6 0"
                                                   Foreground="{DynamicResource SubtleTextBrush}" />
                                        <TextBlock Text="{Binding EntryName}" FontWeight="600" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding EntryPath}" FontSize="11"
                                               Foreground="{DynamicResource SubtleTextBrush}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>

        <!-- Страница логов -->
        <Grid Grid.Column="1" x:Name="LogsPage" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="32 0 32 0">
                <TextBlock Text="{Binding LogsTitle, Source={StaticResource Loc}}" FontSize="28" FontWeight="600" Margin="0 0 0 8" />
                <TextBlock Text="{Binding LogsSubtitle, Source={StaticResource Loc}}" FontSize="18"
                           Foreground="{DynamicResource MutedTextBrush}" Margin="0 0 0 16" />
                <ui:TextBox PlaceholderText="{Binding LogSearchPlaceholder, Source={StaticResource Loc}}"
                            Text="{Binding LogSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Width="300" Margin="0 0 0 16" />
            </StackPanel>

            <Border Grid.Row="1" Margin="32 0 32 16"
                    Background="{DynamicResource TableContainerBackgroundBrush}"
                    BorderBrush="{DynamicResource TableContainerBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8" Padding="0">
                <ListBox ItemsSource="{Binding LogEntries}"
                         BorderThickness="0"
                         Background="Transparent"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         ScrollViewer.CanContentScroll="True"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Style.Triggers>
                                    <!-- Ошибки — красноватый фон -->
                                    <DataTrigger Binding="{Binding Level}" Value="ERR">
                                        <Setter Property="Background" Value="#26E81123" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="FTL">
                                        <Setter Property="Background" Value="#40E81123" />
                                    </DataTrigger>
                                    <!-- Предупреждения — жёлтый фон -->
                                    <DataTrigger Binding="{Binding Level}" Value="WRN">
                                        <Setter Property="Background" Value="#1AFFB900" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:LogEntry}">
                                <Grid Margin="4 2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Timestamp, StringFormat={}{0:dd.MM.yyyy HH:mm:ss}}"
                                               FontSize="11" FontFamily="Consolas"
                                               Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Level}"
                                               Margin="8 0 0 0"
                                               FontSize="11" FontFamily="Consolas"
                                               Foreground="{ui:ThemeResource SystemAccentColorPrimaryBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Level}" Value="ERR">
                                                        <Setter Property="Foreground" Value="#FF6B6B" />
                                                        <Setter Property="FontWeight" Value="Bold" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="FTL">
                                                        <Setter Property="Foreground" Value="#FF3B3B" />
                                                        <Setter Property="FontWeight" Value="Bold" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="WRN">
                                                        <Setter Property="Foreground" Value="#FFB900" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Message}"
                                               FontSize="11" FontFamily="Consolas"
                                               TextWrapping="NoWrap" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
            </Border>
        </Grid>

        <!-- Страница диспетчера задач (Процессы) -->
        <Grid Grid.Column="1" x:Name="TaskManagerPage" Visibility="Collapsed" DataContext="{Binding TaskManager}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Disabled">
                <StackPanel Margin="32 0 32 14">
                    <!-- Заголовок страницы -->
                    <TextBlock Text="{Binding TaskManagerTitle, Source={StaticResource Loc}}" FontSize="28" FontWeight="700" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" Margin="0 0 0 4" />
                    <TextBlock Text="{Binding TaskManagerSubtitle, Source={StaticResource Loc}}" FontSize="13" Foreground="#94A3B8" Margin="0 0 0 16" />

                    <!-- 4 Стеклянные карточки системных метрик -->
                    <Grid Margin="0 0 0 16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Карточка 1: Загрузка ЦП -->
                        <Border Grid.Column="0" Margin="0 0 6 0" Style="{StaticResource FluentGlassCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <TextBlock Text="{Binding CardCpu, Source={StaticResource Loc}}" FontSize="12" FontWeight="500" Foreground="#94A3B8" VerticalAlignment="Center" />
                                    <Border HorizontalAlignment="Right" Style="{StaticResource BadgeBluePill}">
                                        <TextBlock Text="CPU" FontSize="10.5" FontWeight="700" Foreground="{StaticResource BadgeBlueTextBrush}" />
                                    </Border>
                                </Grid>
                                <TextBlock Grid.Row="1" Text="{Binding TotalCpuDisplay}" FontSize="28" FontWeight="700" Foreground="#00D2D3" Margin="0 2 0 4" VerticalAlignment="Center" />
                                <Border Grid.Row="2" Height="2.5" CornerRadius="1.25" Background="{StaticResource CardNeonAccentBrush}">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#00F2FE" BlurRadius="8" Opacity="0.75" Direction="0" ShadowDepth="0" />
                                    </Border.Effect>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Карточка 2: Оперативная память -->
                        <Border Grid.Column="1" Margin="6 0" Style="{StaticResource FluentGlassCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <TextBlock Text="{Binding CardRam, Source={StaticResource Loc}}" FontSize="12" FontWeight="500" Foreground="#94A3B8" VerticalAlignment="Center" />
                                    <Border HorizontalAlignment="Right" Style="{StaticResource BadgeGreenPill}">
                                        <TextBlock Text="RAM" FontSize="10.5" FontWeight="700" Foreground="{StaticResource BadgeGreenTextBrush}" />
                                    </Border>
                                </Grid>
                                <TextBlock Grid.Row="1" Text="{Binding TotalMemoryDisplay}" FontSize="18" FontWeight="700" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" Margin="0 6 0 4" VerticalAlignment="Center" />
                                <Border Grid.Row="2" Height="2.5" CornerRadius="1.25" Background="#10B981" />
                            </Grid>
                        </Border>

                        <!-- Карточка 3: Дисковый ввод-вывод -->
                        <Border Grid.Column="2" Margin="6 0" Style="{StaticResource FluentGlassCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <TextBlock Text="{Binding CardDisk, Source={StaticResource Loc}}" FontSize="12" FontWeight="500" Foreground="#94A3B8" VerticalAlignment="Center" />
                                    <Border HorizontalAlignment="Right" Style="{StaticResource BadgeOrangePill}">
                                        <TextBlock Text="I/O" FontSize="10.5" FontWeight="700" Foreground="{StaticResource BadgeOrangeTextBrush}" />
                                    </Border>
                                </Grid>
                                <TextBlock Grid.Row="1" Text="{Binding TotalDiskDisplay}" FontSize="24" FontWeight="700" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" Margin="0 2 0 4" VerticalAlignment="Center" />
                                <Border Grid.Row="2" Height="2.5" CornerRadius="1.25" Background="#F59E0B" />
                            </Grid>
                        </Border>

                        <!-- Карточка 4: Всего процессов -->
                        <Border Grid.Column="3" Margin="6 0 0 0" Style="{StaticResource FluentGlassCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <TextBlock Text="{Binding CardProcesses, Source={StaticResource Loc}}" FontSize="12" FontWeight="500" Foreground="#94A3B8" VerticalAlignment="Center" />
                                    <Border HorizontalAlignment="Right" Style="{StaticResource BadgeBluePill}">
                                        <TextBlock Text="TASKS" FontSize="10.5" FontWeight="700" Foreground="{StaticResource BadgeBlueTextBrush}" />
                                    </Border>
                                </Grid>
                                <TextBlock Grid.Row="1" Text="{Binding ProcessesCountDisplay}" FontSize="28" FontWeight="700" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" Margin="0 2 0 4" VerticalAlignment="Center" />
                                <Border Grid.Row="2" Height="2.5" CornerRadius="1.25" Background="#3B82F6" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Поиск и фильтры категорий процессов -->
                    <StackPanel>
                        <Grid Margin="0 0 0 10">
                            <ui:TextBox PlaceholderText="{Binding SearchPlaceholder, Source={StaticResource Loc}}"
                                        Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding NavTaskManager, Source={StaticResource Loc}}" 
                                           FontSize="16" FontWeight="700" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="0 0 16 0" />

                                <!-- Переключатель режима: Список / Дерево -->
                                <Border Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="2">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:Button Content="{Binding ViewModeList, Source={StaticResource Loc}}"
                                                   ToolTip="{Binding TooltipViewModeList, Source={StaticResource Loc}}"
                                                   Icon="{ui:SymbolIcon TextBulletListSquare24}"
                                                   Style="{DynamicResource FilterTabButtonStyle}"
                                                   Appearance="{Binding ViewMode, Converter={StaticResource FilterToAppearanceConverter}, ConverterParameter=flat}"
                                                   Command="{Binding SetViewModeCommand}" CommandParameter="flat"
                                                   Padding="8 4" Margin="0 0 2 0" />
                                        <ui:Button Content="{Binding ViewModeTree, Source={StaticResource Loc}}"
                                                   ToolTip="{Binding TooltipViewModeTree, Source={StaticResource Loc}}"
                                                   Icon="{ui:SymbolIcon BranchCompare24}"
                                                   Style="{DynamicResource FilterTabButtonStyle}"
                                                   Appearance="{Binding ViewMode, Converter={StaticResource FilterToAppearanceConverter}, ConverterParameter=tree}"
                                                   Command="{Binding SetViewModeCommand}" CommandParameter="tree"
                                                   Padding="8 4" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <WrapPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
                                <ui:Button Content="{Binding FilterAll, Source={StaticResource Loc}}" Margin="0 0 4 0"
                                           Icon="{ui:SymbolIcon Filter24}"
                                           Style="{DynamicResource FilterTabButtonStyle}"
                                           Appearance="{Binding SelectedFilter, Converter={StaticResource FilterToAppearanceConverter}, ConverterParameter=all}"
                                           Command="{Binding SetFilterCommand}" CommandParameter="all" />
                                <ui:Button Content="{Binding FilterApps, Source={StaticResource Loc}}" Margin="0 0 4 0"
                                           Icon="{ui:SymbolIcon WindowApps24}"
                                           Style="{DynamicResource FilterTabButtonStyle}"
                                           Appearance="{Binding SelectedFilter, Converter={StaticResource FilterToAppearanceConverter}, ConverterParameter=apps}"
                                           Command="{Binding SetFilterCommand}" CommandParameter="apps" />
                                <ui:Button Content="{Binding FilterBackground, Source={StaticResource Loc}}" Margin="0 0 4 0"
                                           Icon="{ui:SymbolIcon Apps24}"
                                           Style="{DynamicResource FilterTabButtonStyle}"
                                           Appearance="{Binding SelectedFilter, Converter={StaticResource FilterToAppearanceConverter}, ConverterParameter=background}"
                                           Command="{Binding SetFilterCommand}" CommandParameter="background" />
                                <ui:Button Content="{Binding FilterServices, Source={StaticResource Loc}}" Margin="0 0 4 0"
                                           Icon="{ui:SymbolIcon ServiceBell24}"
                                           Style="{DynamicResource FilterTabButtonStyle}"
                                           Appearance="{Binding SelectedFilter, Converter={StaticResource FilterToAppearanceConverter}, ConverterParameter=services}"
                                           Command="{Binding SetFilterCommand}" CommandParameter="services" />
                                <ui:Button Content="{Binding FilterAutostart, Source={StaticResource Loc}}" Margin="0 0 4 0"
                                           Icon="{ui:SymbolIcon ShieldCheckmark24}"
                                           Style="{DynamicResource FilterTabButtonStyle}"
                                           Appearance="{Binding SelectedFilter, Converter={StaticResource FilterToAppearanceConverter}, ConverterParameter=autostart}"
                                           Command="{Binding SetFilterCommand}" CommandParameter="autostart" />
                            </WrapPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Таблица процессов -->
            <Border Grid.Row="1" Margin="32 0 32 16"
                    Background="{DynamicResource TableContainerBackgroundBrush}"
                    BorderBrush="{DynamicResource TableContainerBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Заголовки колонок таблицы процессов -->
                    <Border Grid.Row="0" BorderThickness="0 0 0 1"
                            BorderBrush="{DynamicResource TableRowBorderBrush}"
                            Padding="12 8 12 8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>

                            <!-- Колонка 1: Имя процесса и PID -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="4 0 0 0">
                                <Button Style="{StaticResource HeaderSortButtonStyle}"
                                        Command="{Binding SortByCommand}" CommandParameter="name">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding ColProcessName, Source={StaticResource Loc}}" />
                                        <TextBlock Text="{Binding SortNameIndicator}" Margin="3 0 0 0" Foreground="#00D2D3" FontWeight="Bold" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource HeaderSortButtonStyle}" Margin="4 0 0 0"
                                        Command="{Binding SortByCommand}" CommandParameter="pid">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="(" Foreground="#64748B" />
                                        <TextBlock Text="{Binding ColPid, Source={StaticResource Loc}}" />
                                        <TextBlock Text="{Binding SortPidIndicator}" Margin="2 0 0 0" Foreground="#00D2D3" FontWeight="Bold" />
                                        <TextBlock Text=")" Foreground="#64748B" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Колонка 2: ЦП % -->
                            <Button Grid.Column="2" Style="{StaticResource HeaderSortButtonRightStyle}"
                                    Command="{Binding SortByCommand}" CommandParameter="cpu">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding ColCpu, Source={StaticResource Loc}}" />
                                    <TextBlock Text="{Binding SortCpuIndicator}" Margin="3 0 0 0" Foreground="#00D2D3" FontWeight="Bold" />
                                </StackPanel>
                            </Button>

                            <!-- Колонка 3: Память -->
                            <Button Grid.Column="3" Style="{StaticResource HeaderSortButtonRightStyle}"
                                    Command="{Binding SortByCommand}" CommandParameter="ram">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding ColRam, Source={StaticResource Loc}}" />
                                    <TextBlock Text="{Binding SortRamIndicator}" Margin="3 0 0 0" Foreground="#00D2D3" FontWeight="Bold" />
                                </StackPanel>
                            </Button>

                            <!-- Колонка 4: Диск -->
                            <Button Grid.Column="4" Style="{StaticResource HeaderSortButtonRightStyle}"
                                    Command="{Binding SortByCommand}" CommandParameter="disk">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding ColDisk, Source={StaticResource Loc}}" />
                                    <TextBlock Text="{Binding SortDiskIndicator}" Margin="3 0 0 0" Foreground="#00D2D3" FontWeight="Bold" />
                                </StackPanel>
                            </Button>

                            <!-- Колонка 5: Сеть -->
                            <Button Grid.Column="5" Style="{StaticResource HeaderSortButtonRightStyle}"
                                    Command="{Binding SortByCommand}" CommandParameter="net">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding ColNetwork, Source={StaticResource Loc}}" />
                                    <TextBlock Text="{Binding SortNetIndicator}" Margin="3 0 0 0" Foreground="#00D2D3" FontWeight="Bold" />
                                </StackPanel>
                            </Button>

                            <!-- Колонка 6: Издатель -->
                            <Button Grid.Column="6" Style="{StaticResource HeaderSortButtonStyle}" Margin="12 0 0 0"
                                    Command="{Binding SortByCommand}" CommandParameter="publisher">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ColPublisher, Source={StaticResource Loc}}" />
                                    <TextBlock Text="{Binding SortPublisherIndicator}" Margin="3 0 0 0" Foreground="#00D2D3" FontWeight="Bold" />
                                </StackPanel>
                            </Button>

                            <!-- Колонка 7: Источник запуска -->
                            <Button Grid.Column="7" Style="{StaticResource HeaderSortButtonStyle}" Margin="8 0 0 0"
                                    Command="{Binding SortByCommand}" CommandParameter="startup">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ColStartupOrigin, Source={StaticResource Loc}}" />
                                    <TextBlock Text="{Binding SortStartupIndicator}" Margin="3 0 0 0" Foreground="#00D2D3" FontWeight="Bold" />
                                </StackPanel>
                            </Button>

                            <!-- Колонка 8: Действия -->
                            <TextBlock Grid.Column="8" Text="{Binding ColActions, Source={StaticResource Loc}}"
                                       FontSize="11.5" FontWeight="600" Foreground="#94A3B8"
                                       TextAlignment="Right" VerticalAlignment="Center" Margin="0 0 8 0" />
                        </Grid>
                    </Border>

                    <!-- Список процессов -->
                    <ListBox Grid.Row="1" x:Name="ProcessList"
                             ItemsSource="{Binding FilteredProcesses}"
                             SelectedItem="{Binding SelectedProcess, Mode=TwoWay}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="12 6" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="BorderThickness" Value="0 0 0 1" />
                                <Setter Property="BorderBrush" Value="{DynamicResource TableRowBorderBrush}" />
                                <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <ContextMenu Background="#202530" BorderBrush="#374151" BorderThickness="1" Padding="4">
                                            <MenuItem Header="{Binding ActionKillProcess, Source={StaticResource Loc}}"
                                                      Foreground="#F87171" FontWeight="600"
                                                      Command="{Binding PlacementTarget.Tag.KillProcessCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                <MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="DismissCircle24" Foreground="#EF4444" FontSize="16" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="{Binding ActionSuspendProcess, Source={StaticResource Loc}}"
                                                      Foreground="#FBBF24" FontWeight="600"
                                                      Visibility="{Binding PlacementTarget.DataContext.IsSuspended, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                                      Command="{Binding PlacementTarget.Tag.SuspendProcessCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                <MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="Pause24" Foreground="#F59E0B" FontSize="16" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="{Binding ActionResumeProcess, Source={StaticResource Loc}}"
                                                      Foreground="#34D399" FontWeight="600"
                                                      Visibility="{Binding PlacementTarget.DataContext.IsSuspended, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                      Command="{Binding PlacementTarget.Tag.ResumeProcessCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                <MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="Play24" Foreground="#10B981" FontSize="16" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="{Binding ActionBlockProcess, Source={StaticResource Loc}}"
                                                      Foreground="#F8FAFC"
                                                      Command="{Binding PlacementTarget.Tag.BlockProcessCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                <MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="ShieldDismiss24" Foreground="#EF4444" FontSize="16" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator Background="#374151" Margin="4 2" />
                                            <MenuItem Header="{Binding ActionLocateStartup, Source={StaticResource Loc}}"
                                                      Foreground="#F8FAFC"
                                                      Command="{Binding PlacementTarget.Tag.LocateInStartupCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      IsEnabled="{Binding PlacementTarget.DataContext.IsStartupEntry, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                <MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="ShieldCheckmark24" Foreground="#10B981" FontSize="16" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="{Binding ActionOpenFileLocation, Source={StaticResource Loc}}"
                                                      Foreground="#F8FAFC"
                                                      Command="{Binding PlacementTarget.Tag.OpenFileLocationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                <MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="FolderOpen24" Foreground="#60A5FA" FontSize="16" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="{Binding ActionProcessConnections, Source={StaticResource Loc}}"
                                                      Command="{Binding PlacementTarget.Tag.OpenProcessConnectionsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      IsEnabled="{Binding PlacementTarget.DataContext.HasNetworkActivity, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                <MenuItem.Style>
                                                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                        <Setter Property="Foreground" Value="#00D2D3" />
                                                        <Style.Triggers>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter Property="Foreground" Value="#64748B" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </MenuItem.Style>
                                                <MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="Globe24" FontSize="16">
                                                        <ui:SymbolIcon.Style>
                                                            <Style TargetType="ui:SymbolIcon">
                                                                <Setter Property="Foreground" Value="#00D2D3" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding PlacementTarget.DataContext.HasNetworkActivity, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="False">
                                                                        <Setter Property="Foreground" Value="#64748B" />
                                                                        <Setter Property="Opacity" Value="0.4" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ui:SymbolIcon.Style>
                                                    </ui:SymbolIcon>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="{Binding ActionProcessModules, Source={StaticResource Loc}}"
                                                      Foreground="#38BDF8"
                                                      Command="{Binding PlacementTarget.Tag.OpenProcessModulesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                <MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="Cube24" Foreground="#38BDF8" FontSize="16" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:ProcessInfo}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Иконка пульса нагрузки -->
                                    <Viewbox Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconPulse}" Fill="#00D2D3" Stretch="Uniform" />
                                    </Viewbox>

                                    <!-- Имя + PID + Описание -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="{Binding TreeIndentLeft, Converter={StaticResource TreeIndentConverter}}">
                                        <StackPanel Orientation="Horizontal">
                                            <!-- Кнопка экспандера дерева (для процессов с детьми) -->
                                            <Grid Width="18" Height="18" Margin="0 0 4 0" VerticalAlignment="Center"
                                                  Visibility="{Binding HasChildren, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Button Style="{StaticResource TreeExpandButtonStyle}"
                                                        ToolTip="Свернуть / Развернуть"
                                                        Command="{Binding DataContext.ToggleExpandCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}">
                                                    <Grid>
                                                        <ui:SymbolIcon Symbol="ChevronDown12" FontSize="10" Foreground="#94A3B8"
                                                                       Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                        <ui:SymbolIcon Symbol="ChevronRight12" FontSize="10" Foreground="#94A3B8"
                                                                       Visibility="{Binding IsExpanded, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                                    </Grid>
                                                </Button>
                                            </Grid>

                                            <!-- Заглушка/глиф ветви для дочерних процессов без собственных детей -->
                                            <Grid Width="18" Height="18" Margin="0 0 4 0" VerticalAlignment="Center"
                                                  Visibility="{Binding IsChildProcess, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="└" Foreground="#475569" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding HasChildren, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                            </Grid>

                                            <TextBlock Text="{Binding Name}" FontWeight="600" FontSize="13" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                                            <TextBlock Text=" (" Foreground="#64748B" FontSize="11" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Pid}" Foreground="#00D2D3" FontSize="11" FontWeight="600" VerticalAlignment="Center" />
                                            <TextBlock Text=")" Foreground="#64748B" FontSize="11" VerticalAlignment="Center" />

                                            <!-- Бейдж количества дочерних процессов -->
                                            <Border Visibility="{Binding HasChildren, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    Background="#1E293B" BorderBrush="#334155" BorderThickness="1"
                                                    CornerRadius="3" Padding="4 1" Margin="6 0 0 0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ChildrenCount, StringFormat='{}{0}'}" FontSize="10" Foreground="#94A3B8" FontWeight="600" />
                                            </Border>
                                            <Border Visibility="{Binding IsSuspended, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    Background="#3B2D14" BorderBrush="#F59E0B" BorderThickness="1"
                                                    CornerRadius="3" Padding="4 1" Margin="6 0 0 0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding BadgeSuspended, Source={StaticResource Loc}}" FontSize="10" Foreground="#FBBF24" FontWeight="600" />
                                            </Border>
                                            <!-- Бейдж угрозы CLI процесса -->
                                            <Border Visibility="{Binding HasThreat, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    Margin="6 0 0 0" Padding="5 1" CornerRadius="3" VerticalAlignment="Center"
                                                    Background="{Binding ThreatInfo.ThreatLevel, Converter={StaticResource ThreatLevelToBackgroundConverter}}"
                                                    BorderBrush="{Binding ThreatInfo.ThreatLevel, Converter={StaticResource ThreatLevelToBorderConverter}}"
                                                    BorderThickness="1">
                                                <Border.ToolTip>
                                                    <ToolTip Placement="Top" MaxWidth="450">
                                                        <Border Background="#F0101721" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="8" Padding="10">
                                                            <StackPanel>
                                                                <StackPanel Orientation="Horizontal" Margin="0 0 0 4">
                                                                    <ui:SymbolIcon Symbol="Warning24" 
                                                                                   Foreground="{Binding ThreatInfo.ThreatLevel, Converter={StaticResource ThreatLevelToForegroundConverter}}" 
                                                                                   Margin="0 0 6 0" />
                                                                    <TextBlock Text="{Binding ThreatInfo.BadgeText}" FontWeight="Bold" FontSize="12" Foreground="#F8FAFC" />
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding ThreatInfo.Description}" TextWrapping="Wrap" Margin="0 2 0 6" FontSize="11" Foreground="#CBD5E1" />
                                                                <TextBlock Text="Индикаторы эвристики:" FontWeight="SemiBold" FontSize="10" Foreground="#94A3B8" Margin="0 0 0 2" />
                                                                <ItemsControl ItemsSource="{Binding ThreatInfo.Indicators}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <TextBlock Text="{Binding StringFormat='• {0}'}" FontSize="10" Foreground="#F87171" Margin="4 1" TextWrapping="Wrap" />
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <Separator Margin="0,6" Background="#1FFFFFFF" />
                                                                <TextBlock Text="{Binding CommandLine, StringFormat='CLI: {0}'}" FontSize="9.5" Foreground="#64748B" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </Border>
                                                    </ToolTip>
                                                </Border.ToolTip>
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Warning24" FontSize="10" Margin="0 0 3 0" VerticalAlignment="Center"
                                                                   Foreground="{Binding ThreatInfo.ThreatLevel, Converter={StaticResource ThreatLevelToForegroundConverter}}" />
                                                    <TextBlock Text="{Binding ThreatInfo.BadgeText}" FontSize="10" FontWeight="600"
                                                               Foreground="{Binding ThreatInfo.ThreatLevel, Converter={StaticResource ThreatLevelToForegroundConverter}}" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis" MaxWidth="280" Visibility="{Binding Description, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
                                    </StackPanel>

                                    <!-- ЦП % -->
                                    <TextBlock Grid.Column="2" Text="{Binding DisplayCpu}" TextAlignment="Right"
                                               FontFamily="Consolas" FontSize="12.5" FontWeight="600"
                                               Foreground="{Binding CpuPercent, Converter={StaticResource CpuUsageToColorConverter}}"
                                               VerticalAlignment="Center" />

                                    <!-- Память -->
                                    <TextBlock Grid.Column="3" Text="{Binding DisplayRam}" TextAlignment="Right"
                                               FontFamily="Consolas" FontSize="12" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                                               VerticalAlignment="Center" />

                                    <!-- Диск -->
                                    <TextBlock Grid.Column="4" Text="{Binding DisplayDisk}" TextAlignment="Right"
                                               FontFamily="Consolas" FontSize="11.5" Foreground="#94A3B8"
                                               VerticalAlignment="Center" />

                                    <!-- Сеть -->
                                    <TextBlock Grid.Column="5" Text="{Binding DisplayNetwork}" TextAlignment="Right"
                                               FontFamily="Consolas" FontSize="11.5" Foreground="#94A3B8"
                                               VerticalAlignment="Center" />

                                     <!-- Издатель и статус Authenticode -->
                                     <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center" Margin="12 0 4 0"
                                                 ToolTip="{Binding Converter={StaticResource SignatureStatusToTooltipConverter}}">
                                         <ui:SymbolIcon Symbol="{Binding SignatureStatus, Converter={StaticResource SignatureStatusToSymbolConverter}}"
                                                        Foreground="{Binding SignatureStatus, Converter={StaticResource SignatureStatusToColorConverter}}"
                                                        FontSize="11" Margin="0 0 6 0" VerticalAlignment="Center" />
                                         <TextBlock Text="{Binding Publisher}" FontSize="11.5"
                                                    Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                                    TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxWidth="110" />
                                     </StackPanel>

                                    <!-- Источник запуска (бейдж) -->
                                    <Border Grid.Column="7" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8 0 4 0"
                                            CornerRadius="6" Padding="6 2"
                                            Background="{Binding IsStartupEntry, Converter={StaticResource StartupStatusBackgroundConverter}}"
                                            BorderBrush="{Binding IsStartupEntry, Converter={StaticResource StartupStatusBorderConverter}}"
                                            BorderThickness="1">
                                        <TextBlock Text="{Binding Converter={StaticResource ProcessStartupOriginConverter}}" FontSize="11" FontWeight="600"
                                                   Foreground="{Binding IsStartupEntry, Converter={StaticResource StartupStatusForegroundConverter}}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="140" />
                                    </Border>

                                    <!-- Кнопки действий: Иконка щита перед красной кнопкой Блок -->
                                    <!-- Кнопки действий: Сеть, Щит (для автозапуска), Блок -->
                                    <StackPanel Grid.Column="8" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <ui:Button Appearance="Transparent" Padding="4" Margin="0 0 6 0"
                                                   IsEnabled="{Binding HasNetworkActivity}"
                                                   ToolTip="{Binding ActionProcessConnections, Source={StaticResource Loc}}"
                                                   Command="{Binding DataContext.OpenProcessConnectionsCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                   CommandParameter="{Binding}">
                                            <ui:SymbolIcon Symbol="Globe24" FontSize="16">
                                                <ui:SymbolIcon.Style>
                                                    <Style TargetType="ui:SymbolIcon">
                                                        <Setter Property="Foreground" Value="#00D2D3" />
                                                        <Setter Property="Opacity" Value="1.0" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasNetworkActivity}" Value="False">
                                                                <Setter Property="Foreground" Value="#64748B" />
                                                                <Setter Property="Opacity" Value="0.35" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>
                                        </ui:Button>
                                        <ui:Button Icon="{ui:SymbolIcon Cube24}" Appearance="Transparent" Padding="4" Margin="0 0 6 0"
                                                   ToolTip="{Binding ActionProcessModules, Source={StaticResource Loc}}"
                                                   Command="{Binding DataContext.OpenProcessModulesCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                   CommandParameter="{Binding}" />
                                        <ui:Button Icon="{ui:SymbolIcon ShieldCheckmark24}" Appearance="Transparent" Padding="4" Margin="0 0 6 0"
                                                   ToolTip="{Binding ActionLocateStartup, Source={StaticResource Loc}}"
                                                   Visibility="{Binding IsStartupEntry, Converter={StaticResource BoolToVisibility}}"
                                                   Command="{Binding DataContext.LocateInStartupCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                   CommandParameter="{Binding}" />
                                        <Button Content="{Binding ActionBlock, Source={StaticResource Loc}}"
                                                Style="{StaticResource ActionBlockButton}"
                                                ToolTip="{Binding ActionBlockProcess, Source={StaticResource Loc}}"
                                                Command="{Binding DataContext.BlockProcessCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- Страница анализатора времени загрузки Windows (Boot Time Tracer) -->
        <Grid Grid.Column="1" x:Name="BootTimePage" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Заголовок страницы -->
            <StackPanel Grid.Row="0" Margin="32 0 32 0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding BootTimeTitle, Source={StaticResource Loc}}"
                                   FontSize="28" FontWeight="700"
                                   Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                                   Margin="0 0 0 4" />
                        <TextBlock Text="{Binding BootTimeSubtitle, Source={StaticResource Loc}}"
                                   FontSize="13" Foreground="#94A3B8" Margin="0 0 0 4" />
                        <!-- Дельта: быстрее/медленнее предыдущей загрузки -->
                        <TextBlock Text="{Binding BootTimeDeltaText}"
                                   Foreground="{Binding BootTimeDeltaColor}"
                                   FontSize="13" FontWeight="600" Margin="0 0 0 8"
                                   Visibility="{Binding BootTimeDeltaText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0 0 0 8">
                        <!-- Кнопка Обновить -->
                        <ui:Button Command="{Binding LoadBootTimeCommand}"
                                   IsEnabled="{Binding IsBootTimeLoading, Converter={StaticResource InverseBoolConverter}}"
                                   Appearance="Secondary" Icon="{ui:SymbolIcon ArrowSync24}">
                            <ui:Button.Content>
                                <TextBlock Text="{Binding BootTimeRefresh, Source={StaticResource Loc}}" />
                            </ui:Button.Content>
                        </ui:Button>
                    </StackPanel>
                </Grid>

                <!-- 4 KPI-карточки -->
                <UniformGrid Rows="1" Columns="4" Margin="0 0 0 16">
                    <!-- Карточка: Общее время загрузки -->
                    <Border Margin="0 0 8 0" Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8" Padding="16 12">
                        <StackPanel>
                            <TextBlock Text="{Binding BootTimeOverall, Source={StaticResource Loc}}"
                                       FontSize="11" Foreground="#94A3B8" Margin="0 0 0 4" />
                            <TextBlock Text="{Binding BootTimeReport.LatestBoot.DisplayBootTime, FallbackValue='—'}"
                                       FontSize="22" FontWeight="700"
                                       Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Border>
                    <!-- Карточка: До рабочего стола -->
                    <Border Margin="4 0 4 0" Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8" Padding="16 12">
                        <StackPanel>
                            <TextBlock Text="{Binding BootTimeToDesktop, Source={StaticResource Loc}}"
                                       FontSize="11" Foreground="#94A3B8" Margin="0 0 0 4" />
                            <TextBlock Text="{Binding BootTimeReport.LatestBoot.DisplayMainPathBootTime, FallbackValue='—'}"
                                       FontSize="22" FontWeight="700"
                                       Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Border>
                    <!-- Карточка: Фоновая фаза -->
                    <Border Margin="4 0 4 0" Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8" Padding="16 12">
                        <StackPanel>
                            <TextBlock Text="{Binding BootTimePostBoot, Source={StaticResource Loc}}"
                                       FontSize="11" Foreground="#94A3B8" Margin="0 0 0 4" />
                            <TextBlock Text="{Binding BootTimeReport.LatestBoot.DisplayPostBootTime, FallbackValue='—'}"
                                       FontSize="22" FontWeight="700"
                                       Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Border>
                    <!-- Карточка: Приложений в старте -->
                    <Border Margin="8 0 0 0" Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8" Padding="16 12">
                        <StackPanel>
                            <TextBlock Text="{Binding BootTimeAppsCount, Source={StaticResource Loc}}"
                                       FontSize="11" Foreground="#94A3B8" Margin="0 0 0 4" />
                            <TextBlock Text="{Binding BootTimeReport.LatestBoot.StartupAppsCount, FallbackValue='—'}"
                                       FontSize="22" FontWeight="700"
                                       Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </StackPanel>

            <!-- Нет данных — заглушка -->
            <Border Grid.Row="1" Margin="32 8 32 16"
                    Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="24"
                    Visibility="{Binding BootTimeReport.HasData, Converter={StaticResource InverseBoolToVisibilityConverter}, FallbackValue=Collapsed}">
                <TextBlock Text="{Binding BootTimeNoData, Source={StaticResource Loc}}"
                           TextWrapping="Wrap" Foreground="#94A3B8" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <!-- Контент страницы: виновники + история -->
            <ScrollViewer Grid.Row="1" Margin="32 0 32 16"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding BootTimeReport.HasData, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                <StackPanel>
                    <!-- ── Таблица виновников замедления ── -->
                    <TextBlock Text="{Binding BootTimeOffendersTitle, Source={StaticResource Loc}}"
                               FontSize="16" FontWeight="600"
                               Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                               Margin="0 0 0 8" />
                    <Border Background="{DynamicResource TableContainerBackgroundBrush}"
                            BorderBrush="{DynamicResource TableContainerBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10" Padding="0" Margin="0 0 0 20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Шапка таблицы: Виновники замедления -->
                            <Border Grid.Row="0" BorderThickness="0 0 0 1"
                                    BorderBrush="{DynamicResource TableRowBorderBrush}"
                                    Padding="12 8 12 8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding BootTimeColCategory, Source={StaticResource Loc}}"
                                               FontSize="11.5" FontWeight="600" Foreground="#94A3B8" VerticalAlignment="Center" />

                                    <TextBlock Grid.Column="1" Text="{Binding BootTimeColName, Source={StaticResource Loc}}"
                                               FontSize="11.5" FontWeight="600" Foreground="#94A3B8" VerticalAlignment="Center" Margin="6 0 0 0" />

                                    <TextBlock Grid.Column="2" Text="{Binding BootTimeColPublisher, Source={StaticResource Loc}}"
                                               FontSize="11.5" FontWeight="600" Foreground="#94A3B8" VerticalAlignment="Center" />

                                    <TextBlock Grid.Column="3" Text="{Binding BootTimeColTotalTime, Source={StaticResource Loc}}"
                                               FontSize="11.5" FontWeight="600" Foreground="#94A3B8" VerticalAlignment="Center" TextAlignment="Right" />

                                    <TextBlock Grid.Column="4" Text="{Binding BootTimeColDelay, Source={StaticResource Loc}}"
                                               FontSize="11.5" FontWeight="600" Foreground="#94A3B8" VerticalAlignment="Center" TextAlignment="Right" Margin="0 0 8 0" />
                                </Grid>
                            </Border>

                            <!-- Список виновников замедления -->
                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding BootTimeReport.TopOffenders}"
                                     BorderThickness="0" Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="12 7" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="BorderThickness" Value="0 0 0 1" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource TableRowBorderBrush}" />
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource TableRowHoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource TableRowHoverBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource TableRowBorderBrush}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="120" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Колонка 0: Категория (Мягкий бейдж) -->
                                            <Border Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                    Background="{Binding CategoryColor, Converter={StaticResource HexToBrushConverter}, ConverterParameter=0.15}"
                                                    BorderBrush="{Binding CategoryColor, Converter={StaticResource HexToBrushConverter}}"
                                                    BorderThickness="1" CornerRadius="10" Padding="8 2">
                                                <TextBlock Text="{Binding DisplayCategory}"
                                                           FontSize="10.5" FontWeight="600"
                                                           Foreground="{Binding CategoryColor, Converter={StaticResource HexToBrushConverter}}" />
                                            </Border>

                                            <!-- Колонка 1: Имя и путь (масштабируется по ширине) -->
                                            <Grid Grid.Column="1" VerticalAlignment="Center" Margin="6 0 12 0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="{Binding DisplayName}"
                                                           FontSize="12.5" FontWeight="600"
                                                           Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Row="1" Text="{Binding Path}"
                                                           FontSize="10.5" Foreground="#64748B"
                                                           TextTrimming="CharacterEllipsis" Margin="0 1 0 0" />
                                            </Grid>

                                            <!-- Колонка 2: Издатель -->
                                            <TextBlock Grid.Column="2" Text="{Binding Publisher}"
                                                       FontSize="11.5" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0 0 10 0" />

                                            <!-- Колонка 3: Общее время работы -->
                                            <TextBlock Grid.Column="3" Text="{Binding DisplayTotalTime}"
                                                       FontSize="11.5" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                                       TextAlignment="Right" VerticalAlignment="Center" HorizontalAlignment="Right" />

                                            <!-- Колонка 4: Задержка (Мягкий Fluent-бейдж) -->
                                            <Border Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Background="{Binding BadgeColor, Converter={StaticResource HexToBrushConverter}, ConverterParameter=0.15}"
                                                    BorderBrush="{Binding BadgeColor, Converter={StaticResource HexToBrushConverter}}"
                                                    BorderThickness="1" CornerRadius="10" Padding="8 2" MinWidth="65">
                                                <TextBlock Text="{Binding DisplayDegradation}"
                                                           FontSize="10.5" FontWeight="600"
                                                           Foreground="{Binding BadgeColor, Converter={StaticResource HexToBrushConverter}}"
                                                           HorizontalAlignment="Center" TextAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- ── Таблица истории загрузок ── -->
                    <TextBlock Text="{Binding BootTimeHistoryTitle, Source={StaticResource Loc}}"
                               FontSize="16" FontWeight="600"
                               Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                               Margin="0 0 0 8" />
                    <Border Background="{DynamicResource TableContainerBackgroundBrush}"
                            BorderBrush="{DynamicResource TableContainerBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10" Padding="0" Margin="0 0 0 16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Шапка таблицы: История предыдущих загрузок -->
                            <Border Grid.Row="0" BorderThickness="0 0 0 1"
                                    BorderBrush="{DynamicResource TableRowBorderBrush}"
                                    Padding="12 8 12 8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding BootTimeHistColDate, Source={StaticResource Loc}}"
                                               FontSize="11.5" FontWeight="600" Foreground="#94A3B8" VerticalAlignment="Center" />

                                    <TextBlock Grid.Column="1" Text="{Binding BootTimeHistColTotal, Source={StaticResource Loc}}"
                                               FontSize="11.5" FontWeight="600" Foreground="#94A3B8" VerticalAlignment="Center" Margin="6 0 0 0" />

                                    <TextBlock Grid.Column="2" Text="{Binding BootTimeHistColDesktop, Source={StaticResource Loc}}"
                                               FontSize="11.5" FontWeight="600" Foreground="#94A3B8" VerticalAlignment="Center" />

                                    <TextBlock Grid.Column="3" Text="{Binding BootTimeHistColPost, Source={StaticResource Loc}}"
                                               FontSize="11.5" FontWeight="600" Foreground="#94A3B8" VerticalAlignment="Center" />

                                    <TextBlock Grid.Column="4" Text="{Binding BootTimeHistColApps, Source={StaticResource Loc}}"
                                               FontSize="11.5" FontWeight="600" Foreground="#94A3B8" VerticalAlignment="Center" TextAlignment="Center" />

                                    <TextBlock Grid.Column="5" Text="{Binding BootTimeHistColRating, Source={StaticResource Loc}}"
                                               FontSize="11.5" FontWeight="600" Foreground="#94A3B8" VerticalAlignment="Center" TextAlignment="Right" Margin="0 0 8 0" />
                                </Grid>
                            </Border>

                            <!-- Список истории загрузок -->
                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding BootTimeReport.RecentSessions}"
                                     BorderThickness="0" Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="12 7" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="BorderThickness" Value="0 0 0 1" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource TableRowBorderBrush}" />
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource TableRowHoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource TableRowHoverBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource TableRowBorderBrush}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="110" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Колонка 0: Дата и время -->
                                            <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}"
                                                       FontSize="11.5" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                                       VerticalAlignment="Center" />

                                            <!-- Колонка 1: Общее время (акцентное, масштабируется) -->
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayBootTime}"
                                                       FontSize="12.5" FontWeight="600"
                                                       Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                                                       VerticalAlignment="Center" Margin="6 0 0 0" />

                                            <!-- Колонка 2: До рабочего стола -->
                                            <TextBlock Grid.Column="2" Text="{Binding DisplayMainPathBootTime}"
                                                       FontSize="11.5" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                                       VerticalAlignment="Center" />

                                            <!-- Колонка 3: Фоновая фаза -->
                                            <TextBlock Grid.Column="3" Text="{Binding DisplayPostBootTime}"
                                                       FontSize="11.5" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                                       VerticalAlignment="Center" />

                                            <!-- Колонка 4: Количество приложений -->
                                            <TextBlock Grid.Column="4" Text="{Binding StartupAppsCount}"
                                                       FontSize="11.5" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                                       VerticalAlignment="Center" TextAlignment="Center" />

                                            <!-- Колонка 5: Оценка (Мягкий Fluent-бейдж) -->
                                            <Border Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Background="{Binding SpeedRatingColor, Converter={StaticResource HexToBrushConverter}, ConverterParameter=0.15}"
                                                    BorderBrush="{Binding SpeedRatingColor, Converter={StaticResource HexToBrushConverter}}"
                                                    BorderThickness="1" CornerRadius="10" Padding="8 2" MinWidth="65">
                                                <TextBlock Text="{Binding SpeedRating}"
                                                           FontSize="10.5" FontWeight="600"
                                                           Foreground="{Binding SpeedRatingColor, Converter={StaticResource HexToBrushConverter}}"
                                                           HorizontalAlignment="Center" TextAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

            <!-- Оверлей загрузки -->
            <Grid x:Name="StartOverlay" Visibility="Visible" Panel.ZIndex="100"
                  Grid.RowSpan="2" Grid.ColumnSpan="2"
                  Background="#F01E1E1E">
                <Border Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                        Width="420" MinHeight="280"
                        CornerRadius="12"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                        <!-- Радар: строгая векторная графика -->
                        <Grid Width="72" Height="72" Margin="0 0 0 16">
                            <Ellipse Width="72" Height="72" Stroke="{ui:ThemeResource SystemAccentColorPrimaryBrush}" StrokeThickness="1" Opacity="0.9"/>
                            <Ellipse Width="48" Height="48" Stroke="{ui:ThemeResource SystemAccentColorPrimaryBrush}" StrokeThickness="1" Opacity="0.5"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Ellipse Width="24" Height="24" Stroke="{ui:ThemeResource SystemAccentColorPrimaryBrush}" StrokeThickness="1" Opacity="0.25"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Line X1="36" Y1="0" X2="36" Y2="72" Stroke="{ui:ThemeResource SystemAccentColorPrimaryBrush}" StrokeThickness="0.5" Opacity="0.25"/>
                            <Line X1="0" Y1="36" X2="72" Y2="36" Stroke="{ui:ThemeResource SystemAccentColorPrimaryBrush}" StrokeThickness="0.5" Opacity="0.25"/>
                            <!-- Луч радара: вращаем весь контейнер вокруг центра круга (36,36) -->
                            <Grid Width="72" Height="72">
                                <Grid.RenderTransform>
                                    <RotateTransform x:Name="RadarSweep" CenterX="36" CenterY="36" Angle="0" />
                                </Grid.RenderTransform>
                                <Line X1="36" Y1="36" X2="66" Y2="12" Stretch="None"
                                      Stroke="{ui:ThemeResource SystemAccentColorPrimaryBrush}" StrokeThickness="1.5" />
                                <Grid.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="RadarSweep"
                                                                 Storyboard.TargetProperty="Angle"
                                                                 From="0" To="360" Duration="0:0:3" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Grid.Triggers>
                            </Grid>
                            <Ellipse Width="4" Height="4" Fill="{ui:ThemeResource SystemAccentColorPrimaryBrush}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="{Binding AppName, Source={StaticResource Loc}}" FontSize="20" FontWeight="600"
                                   HorizontalAlignment="Center" Margin="0 0 0 6" />
                        <TextBlock x:Name="StatusText" Text="{Binding StatusStarting, Source={StaticResource Loc}}" FontSize="13"
                                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                                   MaxWidth="370" Margin="0 4 0 0" />

                        <!-- Панель действий при ошибке -->
                        <StackPanel x:Name="OverlayErrorPanel" Visibility="Collapsed" Margin="0 16 0 0" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <ui:Button x:Name="OverlayRetryButton"
                                           Content="{Binding BtnRetry, Source={StaticResource Loc}}"
                                           Appearance="Primary"
                                           Click="OnOverlayRetryClick"
                                           Margin="0 0 8 0" />
                                <ui:Button x:Name="OverlayExitButton"
                                           Content="{Binding BtnExit, Source={StaticResource Loc}}"
                                           Appearance="Secondary"
                                           Click="OnOverlayExitClick" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Статус-бар -->
        <Border Grid.Row="2" Background="{ui:ThemeResource ControlFillColorDefaultBrush}"
                BorderThickness="0 1 0 0" BorderBrush="{ui:ThemeResource ControlStrokeColorDefaultBrush}"
                Padding="12 0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Статус подключения и службы -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#E81123" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="#00CC6A" />
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsConnected}" Value="True" />
                                            <Condition Binding="{Binding IsMonitoringPaused}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Fill" Value="#F59E0B" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Margin="8 0 0 0" FontSize="12" VerticalAlignment="Center"
                               Text="{Binding ServiceStatusDetails}"
                               Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- Компактная плашка ПК в статус-баре -->
                <Button Grid.Column="2" Margin="0 0 16 0" VerticalAlignment="Center"
                        Padding="6 2" Cursor="Hand" Background="Transparent" BorderThickness="0"
                        Command="{Binding OpenSystemInfoCommand}">
                    <Button.ToolTip>
                        <ToolTip Content="{Binding ComputerInfo.CompactSummary}" Placement="Top" />
                    </Button.ToolTip>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconDesktop}" Width="12" Height="12" Stretch="Uniform"
                              Fill="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0 0 6 0" VerticalAlignment="Center" />
                        <TextBlock FontSize="11" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"
                                   Text="{Binding ComputerInfo.MachineName}" FontWeight="SemiBold" />
                        <TextBlock FontSize="11" Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="6 0 0 0">
                            <Run Text="•" /><Run Text=" " /><Run Text="{Binding ComputerInfo.CpuName}" /><Run Text=" •" /><Run Text=" " /><Run Text="{Binding ComputerInfo.RamTotalGb, StringFormat={}{0:F1} ГБ}" />
                        </TextBlock>
                    </StackPanel>
                </Button>

                <!-- Общее количество записей -->
                <TextBlock Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"
                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}">
                    <Run Text="{Binding CardTotal, Source={StaticResource Loc}, Mode=OneWay}" /><Run Text=": " /><Run Text="{Binding TotalCount, Mode=OneWay}" />
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
