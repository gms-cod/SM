<ui:FluentWindow
    x:Class="StartupMonitor.UI.Views.Dialogs.FirewallRuleEditWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Создание правила брандмауэра"
    WindowStartupLocation="CenterOwner"
    Background="{ui:ThemeResource ApplicationBackgroundBrush}"
    ExtendsContentIntoTitleBar="True"
    ShowInTaskbar="False"
    Width="600" Height="720"
    MinHeight="560" MinWidth="500">

    <Grid Margin="16,0,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TitleBar -->
        <ui:TitleBar x:Name="TitleBar" Grid.Row="0" Title="Создание правила брандмауэра" ShowMinimize="False" ShowMaximize="False" ShowClose="True" />

        <!-- Заголовок -->
        <ui:Card Grid.Row="1" Margin="0,4,0,12" Padding="14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="40" Height="40" CornerRadius="8" Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Shield24" FontSize="20" Foreground="{ui:ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtHeaderTitle" Text="Создание правила брандмауэра" FontSize="16" FontWeight="SemiBold" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="Правило брандмауэра Windows (INetFwRules)" FontSize="12" Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </ui:Card>

        <!-- Форма -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Имя правила *" FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                <ui:TextBox x:Name="TxtName" PlaceholderText="Например: StartupMonitor — блокировка 192.168.1.0/24" Margin="0,0,0,12" />

                <TextBlock Text="Описание" FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                <ui:TextBox x:Name="TxtDescription" PlaceholderText="Необязательный комментарий" TextWrapping="Wrap" MinHeight="48" Margin="0,0,0,12" />

                <TextBlock Text="Действие" FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <RadioButton x:Name="RadioAllow" Content="Разрешить подключение" Foreground="#4CAF50" FontWeight="SemiBold" Margin="0,0,20,0" VerticalAlignment="Center" />
                    <RadioButton x:Name="RadioBlock" Content="Блокировать подключение" Foreground="#F44336" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Text="Направление" FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <RadioButton x:Name="RadioInbound" Content="Входящее" Margin="0,0,20,0" VerticalAlignment="Center" />
                    <RadioButton x:Name="RadioOutbound" Content="Исходящее" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Text="Протокол" FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                <ComboBox x:Name="CmbProtocol" Margin="0,0,0,12" SelectedIndex="0">
                    <ComboBoxItem Content="Любой" Tag="256" />
                    <ComboBoxItem Content="TCP" Tag="6" />
                    <ComboBoxItem Content="UDP" Tag="17" />
                    <ComboBoxItem Content="ICMPv4" Tag="1" />
                    <ComboBoxItem Content="ICMPv6" Tag="58" />
                </ComboBox>

                <TextBlock Text="Локальные порты" FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                <ui:TextBox x:Name="TxtLocalPorts" PlaceholderText="80, 443 или 8000-8080 (только TCP/UDP)" Margin="0,0,0,12" />

                <TextBlock Text="Удаленные порты" FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                <ui:TextBox x:Name="TxtRemotePorts" PlaceholderText="80, 443 или 8000-8080 (только TCP/UDP)" Margin="0,0,0,12" />

                <TextBlock Text="Удаленные IP-адреса / подсети" FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                <ui:TextBox x:Name="TxtRemoteAddresses" PlaceholderText="192.168.1.0/24 или * (пусто = любые)" TextWrapping="Wrap" MinHeight="48" Margin="0,0,0,12" />

                <TextBlock Text="Путь к программе" FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox x:Name="TxtApplicationPath" Grid.Column="0" PlaceholderText="Пусто = применяется ко всей системе" Margin="0,0,8,0" />
                    <ui:Button Grid.Column="1" Appearance="Secondary" Content="Обзор..." Click="OnBrowseAppClick" MinWidth="90" />
                </Grid>

                <TextBlock Text="Имя службы" FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                <ui:TextBox x:Name="TxtServiceName" PlaceholderText="Пусто = без привязки к службе" Margin="0,0,0,12" />

                <TextBlock Text="Профили сети" FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <CheckBox x:Name="ChkDomain" Content="Доменный" Margin="0,0,16,0" />
                    <CheckBox x:Name="ChkPrivate" Content="Частный" Margin="0,0,16,0" />
                    <CheckBox x:Name="ChkPublic" Content="Общедоступный" />
                </StackPanel>

                <CheckBox x:Name="ChkEnabled" Content="Правило включено" IsChecked="True" FontWeight="SemiBold" Margin="0,0,0,12" />

                <TextBlock x:Name="TxtStatus" FontSize="12" Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <!-- Кнопки -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:Button Grid.Column="1" Appearance="Secondary" Content="Отмена" Click="OnCancelClick" Margin="0,0,8,0" MinWidth="100" />
            <ui:Button Grid.Column="2" Appearance="Primary" Content="Сохранить правило" Click="OnSaveClick" MinWidth="150" />
        </Grid>
    </Grid>
</ui:FluentWindow>
