<ui:FluentWindow
    x:Class="StartupMonitor.UI.Views.Dialogs.SnapshotsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:services="clr-namespace:StartupMonitor.UI.Services"
    xmlns:converters="clr-namespace:StartupMonitor.UI.Converters"
    Title="{Binding SnapshotsTitle, Source={x:Static services:LocalizationService.Instance}}"
    WindowStartupLocation="CenterOwner"
    Background="{ui:ThemeResource ApplicationBackgroundBrush}"
    ExtendsContentIntoTitleBar="True"
    ShowInTaskbar="False"
    Width="940" Height="720"
    MinHeight="500" MinWidth="750">

    <Window.Resources>
        <converters:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVis" />
    </Window.Resources>

    <Grid Margin="16,0,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TitleBar -->
        <ui:TitleBar Grid.Row="0" Title="{Binding SnapshotsTitle, Source={x:Static services:LocalizationService.Instance}}" ShowMinimize="False" ShowMaximize="True" ShowClose="True" />

        <!-- Блок создания нового снимка -->
        <ui:Card Grid.Row="1" Margin="0,4,0,12" Padding="14">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Data="{StaticResource IconCamera}" Width="18" Height="18"
                          Fill="{ui:ThemeResource AccentTextFillColorPrimaryBrush}" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="1" Text="{Binding SnapshotsSubtitle, Source={x:Static services:LocalizationService.Instance}}"
                               FontSize="13" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:TextBox x:Name="TxtSnapshotName" Grid.Column="0" Margin="0,0,8,0"
                                PlaceholderText="{Binding SnapshotNamePrompt, Source={x:Static services:LocalizationService.Instance}}" />
                    <ui:TextBox x:Name="TxtSnapshotDesc" Grid.Column="1" Margin="0,0,8,0"
                                PlaceholderText="{Binding SnapshotDescPrompt, Source={x:Static services:LocalizationService.Instance}}" />
                    <ui:Button x:Name="BtnCreateSnapshot" Grid.Column="2" Appearance="Primary"
                               Content="{Binding CreateSnapshotBtn, Source={x:Static services:LocalizationService.Instance}}"
                               Click="OnCreateSnapshotClick" />
                </Grid>
            </StackPanel>
        </ui:Card>

        <!-- Основная область: Список снимков и результаты сравнения -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="200" MinHeight="120" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="160" />
            </Grid.RowDefinitions>

            <!-- Верхняя часть: Таблица сохраненных снимков -->
            <ui:Card Grid.Row="0" Margin="0,0,0,4" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding SnapSavedSnapshots, Source={x:Static services:LocalizationService.Instance}}" FontWeight="SemiBold" Margin="4,0,0,6" FontSize="13"
                               Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" />

                    <DataGrid x:Name="GridSnapshots" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" BorderThickness="0" Background="Transparent">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{Binding SnapColName, Source={x:Static services:LocalizationService.Instance}}" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="{Binding SnapColDate, Source={x:Static services:LocalizationService.Instance}}" Binding="{Binding CreatedAt, StringFormat=\{0:dd.MM.yyyy HH:mm\}}" Width="130" />
                            <DataGridTextColumn Header="{Binding SnapColEntries, Source={x:Static services:LocalizationService.Instance}}" Binding="{Binding EntriesCount}" Width="80" />
                            <DataGridTextColumn Header="{Binding SnapColMachine, Source={x:Static services:LocalizationService.Instance}}" Binding="{Binding MachineName}" Width="1.5*" />
                            <DataGridTextColumn Header="{Binding SnapColDesc, Source={x:Static services:LocalizationService.Instance}}" Binding="{Binding Description}" Width="2*" />
                            <DataGridTemplateColumn Width="220" Header="{Binding ColumnActions, Source={x:Static services:LocalizationService.Instance}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <ui:Button Appearance="Primary" Padding="8,4" Margin="0,0,6,0"
                                                       Content="{Binding SnapBtnCompare, Source={x:Static services:LocalizationService.Instance}}" Click="OnCompareSnapshotClick"
                                                       ToolTip="{Binding SnapCompareTooltip, Source={x:Static services:LocalizationService.Instance}}" />
                                            <ui:Button Appearance="Danger" Padding="8,4"
                                                       Content="🗑" Click="OnDeleteSnapshotClick"
                                                       ToolTip="{Binding SnapDeleteTooltip, Source={x:Static services:LocalizationService.Instance}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Пустое состояние -->
                    <TextBlock x:Name="TxtNoSnapshots" Grid.Row="1" Visibility="Collapsed"
                               Text="{Binding SnapshotNoSnapshots, Source={x:Static services:LocalizationService.Instance}}"
                               TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"
                               Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" />
                </Grid>
            </ui:Card>

            <!-- Разделитель областей снимков и анализа -->
            <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Transparent" />

            <!-- Нижняя часть: Результаты сравнительного анализа («Было — Стало») -->
            <ui:Card Grid.Row="2" Margin="0,4,0,0" Padding="12">
                <Grid x:Name="PanelDiff">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Панель KPI и кнопки применения -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Счетчики изменений -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtDiffHeader" Text="{Binding SnapResultsHeader, Source={x:Static services:LocalizationService.Instance}}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="0,0,14,0" />

                            <Border Background="#10B981" CornerRadius="12" Padding="8,3" Margin="0,0,8,0">
                                <TextBlock x:Name="BadgeAdded" Text="+0 Новых" Foreground="White" FontWeight="Bold" FontSize="11" />
                            </Border>
                            <Border Background="#3B82F6" CornerRadius="12" Padding="8,3" Margin="0,0,8,0">
                                <TextBlock x:Name="BadgeModified" Text="~0 Измененных" Foreground="White" FontWeight="Bold" FontSize="11" />
                            </Border>
                            <Border Background="#EF4444" CornerRadius="12" Padding="8,3" Margin="0,0,8,0">
                                <TextBlock x:Name="BadgeRemoved" Text="-0 Удаленных" Foreground="White" FontWeight="Bold" FontSize="11" />
                            </Border>
                            <Border Background="#6B7280" CornerRadius="12" Padding="8,3">
                                <TextBlock x:Name="BadgeUnchanged" Text="0 Без изменений" Foreground="White" FontWeight="SemiBold" FontSize="11" />
                            </Border>
                        </StackPanel>

                        <!-- Кнопка фильтрации в главном окне -->
                        <ui:Button x:Name="BtnApplyFilter" Grid.Column="1" Appearance="Primary"
                                   Content="{Binding SnapshotApplyFilter, Source={x:Static services:LocalizationService.Instance}}"
                                   Click="OnApplyFilterToMainClick" />
                    </Grid>

                    <!-- Вкладки с деталями различий -->
                    <TabControl x:Name="TabsDiff" Grid.Row="1" Background="Transparent" BorderThickness="0">
                        <!-- Вкладка: Новые записи -->
                        <TabItem x:Name="TabAdded" Header="Новые записи (+0)">
                            <DataGrid x:Name="GridAdded" AutoGenerateColumns="False" CanUserAddRows="False"
                                      IsReadOnly="True" HeadersVisibility="Column" Background="Transparent" BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{Binding ColumnName, Source={x:Static services:LocalizationService.Instance}}" Binding="{Binding Name}" Width="180" />
                                    <DataGridTextColumn Header="{Binding SnapColLocation, Source={x:Static services:LocalizationService.Instance}}" Binding="{Binding Location}" Width="120" />
                                    <DataGridTextColumn Header="{Binding SnapColCommandLine, Source={x:Static services:LocalizationService.Instance}}" Binding="{Binding DisplayPath}" Width="*" />
                                    <DataGridTextColumn Header="{Binding ColumnPublisher, Source={x:Static services:LocalizationService.Instance}}" Binding="{Binding Publisher}" Width="150" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>

                        <!-- Вкладка: Измененные записи -->
                        <TabItem x:Name="TabModified" Header="Измененные (~0)">
                            <DataGrid x:Name="GridModified" AutoGenerateColumns="False" CanUserAddRows="False"
                                      IsReadOnly="True" HeadersVisibility="Column" Background="Transparent" BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{Binding ColumnName, Source={x:Static services:LocalizationService.Instance}}" Binding="{Binding CurrentEntry.Name}" Width="160" />
                                    <DataGridTextColumn Header="{Binding SnapColChangedParams, Source={x:Static services:LocalizationService.Instance}}" Binding="{Binding Summary}" Width="180" />
                                    <DataGridTextColumn Header="{Binding SnapColCurrentState, Source={x:Static services:LocalizationService.Instance}}" Binding="{Binding CurrentEntry.DisplayPath}" Width="2*" />
                                    <DataGridTextColumn Header="{Binding SnapColBaselineState, Source={x:Static services:LocalizationService.Instance}}" Binding="{Binding BaselineEntry.CommandLine}" Width="2*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>

                        <!-- Вкладка: Удаленные записи -->
                        <TabItem x:Name="TabRemoved" Header="Удаленные (-0)">
                            <DataGrid x:Name="GridRemoved" AutoGenerateColumns="False" CanUserAddRows="False"
                                      IsReadOnly="True" HeadersVisibility="Column" Background="Transparent" BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{Binding ColumnName, Source={x:Static services:LocalizationService.Instance}}" Binding="{Binding Name}" Width="180" />
                                    <DataGridTextColumn Header="{Binding SnapColLocation, Source={x:Static services:LocalizationService.Instance}}" Binding="{Binding Location}" Width="120" />
                                    <DataGridTextColumn Header="{Binding SnapColCommandLine, Source={x:Static services:LocalizationService.Instance}}" Binding="{Binding CommandLine}" Width="*" />
                                    <DataGridTextColumn Header="{Binding ColumnPublisher, Source={x:Static services:LocalizationService.Instance}}" Binding="{Binding Publisher}" Width="150" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </ui:Card>
        </Grid>

        <!-- Подвал с кнопкой закрытия -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <ui:Button Appearance="Secondary" Content="{Binding SnapBtnClose, Source={x:Static services:LocalizationService.Instance}}" Width="110" Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>

