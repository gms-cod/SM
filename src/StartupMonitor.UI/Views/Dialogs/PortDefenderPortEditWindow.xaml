<ui:FluentWindow
    x:Class="StartupMonitor.UI.Views.Dialogs.PortDefenderPortEditWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Настройка защищаемого порта"
    WindowStartupLocation="CenterOwner"
    Background="{ui:ThemeResource ApplicationBackgroundBrush}"
    ExtendsContentIntoTitleBar="True"
    ShowInTaskbar="False"
    ResizeMode="NoResize"
    Width="480" Height="460">

    <Grid Margin="18,0,18,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TitleBar -->
        <ui:TitleBar x:Name="DialogTitleBar" Grid.Row="0" Title="Настройка защищаемого порта" ShowMinimize="False" ShowMaximize="False" ShowClose="True" />

        <!-- Шапка -->
        <ui:Card Grid.Row="1" Margin="0,4,0,12" Padding="12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="38" Height="38" CornerRadius="8" Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="ShieldLock24" FontSize="20" Foreground="{ui:ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtHeaderTitle" Text="Защищаемый порт" FontSize="15" FontWeight="SemiBold" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="Укажите номер порта TCP в диапазоне 1..65535" FontSize="12" Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </StackPanel>
        </ui:Card>

        <!-- Поля формы -->
        <StackPanel Grid.Row="2" VerticalAlignment="Top">
            <!-- Быстрый выбор из каталога популярных портов -->
            <TextBlock Text="Популярный шаблон (быстрый выбор):" FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
            <ComboBox x:Name="CmbPresets" Margin="0,0,0,12" SelectionChanged="OnPresetSelected" />

            <!-- Ввод номера порта -->
            <TextBlock Text="Номер TCP-порта (1..65535):" FontSize="12" FontWeight="SemiBold" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" Margin="0,0,0,4" />
            <ui:TextBox x:Name="TxtPort" PlaceholderText="Например: 3389, 22, 445" Margin="0,0,0,8" TextChanged="OnPortTextChanged" />

            <!-- Карточка предпросмотра метаданных -->
            <Border Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="12" Margin="0,4,0,8" BorderThickness="1" BorderBrush="#20808080">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                            <TextBlock x:Name="TxtPreviewService" Text="Служба: RDP" FontWeight="SemiBold" FontSize="13" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" Margin="0,0,8,0" />
                            <Border x:Name="BorderRiskBadge" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Background="#D32F2F">
                                <TextBlock x:Name="TxtPreviewRisk" Text="Критический" FontSize="10" FontWeight="SemiBold" Foreground="#FFFFFF" />
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="TxtPreviewDesc" Text="Удалённый рабочий стол Windows" FontSize="11" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="6" Background="{ui:ThemeResource ControlFillColorDefaultBrush}" Padding="8,4" Margin="8,0,0,0">
                        <TextBlock x:Name="TxtPreviewPortBadge" Text="#3389" FontFamily="Consolas, Segoe UI" FontSize="13" FontWeight="Bold" Foreground="{ui:ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </Border>
                </Grid>
            </Border>

            <!-- Сообщение об ошибке валидации -->
            <TextBlock x:Name="TxtError" Text="" FontSize="11" Foreground="#FF5252" TextWrapping="Wrap" Visibility="Collapsed" Margin="2,0,0,4" />
        </StackPanel>

        <!-- Кнопки управления -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:Button Grid.Column="1" Appearance="Secondary" Content="Отмена" Click="OnCancelClick" Margin="0,0,8,0" MinWidth="90" />
            <ui:Button x:Name="BtnSave" Grid.Column="2" Appearance="Primary" Content="Сохранить" Click="OnSaveClick" MinWidth="110" />
        </Grid>
    </Grid>
</ui:FluentWindow>
