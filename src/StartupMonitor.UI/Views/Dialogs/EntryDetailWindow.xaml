<ui:FluentWindow
    x:Class="StartupMonitor.UI.Views.Dialogs.EntryDetailWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Детали записи"
    WindowStartupLocation="CenterOwner"
    Background="{ui:ThemeResource ApplicationBackgroundBrush}"
    ExtendsContentIntoTitleBar="True"
    ShowInTaskbar="False"
    ResizeMode="NoResize"
    Width="660" Height="640">

    <Window.Resources>
        <Style x:Key="SelectableText" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{ui:ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" IsTabStop="False" VerticalScrollBarVisibility="Hidden" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12,0,12,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding Name}" ShowMinimize="False" ShowMaximize="False" ShowClose="True" />

        <!-- Контент скроллится, кнопки всегда видны внизу -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <!-- Основная информация -->
            <ui:Card Margin="0 0 0 12" Padding="12">
                <StackPanel>
                    <TextBlock Text="{Binding DetailMainInfo, Source={StaticResource Loc}}" FontSize="16" FontWeight="SemiBold" Margin="0 0 0 8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding ColumnName, Source={StaticResource Loc}, StringFormat='{}{0}:'}" FontWeight="SemiBold" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name}" Style="{StaticResource SelectableText}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding DetailPath, Source={StaticResource Loc}}" FontWeight="SemiBold" Margin="0 8 0 0" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding FilePath}" Style="{StaticResource SelectableText}" Margin="0 8 0 0" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding DetailCommand, Source={StaticResource Loc}}" FontWeight="SemiBold" Margin="0 8 0 0" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CommandLine}" Style="{StaticResource SelectableText}" Margin="0 8 0 0" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding ColumnPublisher, Source={StaticResource Loc}, StringFormat='{}{0}:'}" FontWeight="SemiBold" Margin="0 8 0 0" />
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Publisher}" Style="{StaticResource SelectableText}" Margin="0 8 0 0" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding LocLocationLabel, Source={StaticResource Loc}, StringFormat='{}{0}:'}" FontWeight="SemiBold" Margin="0 8 0 0" />
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding LocationDetail}" Style="{StaticResource SelectableText}" Margin="0 8 0 0" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="{Binding ColumnStatus, Source={StaticResource Loc}, StringFormat='{}{0}:'}" FontWeight="SemiBold" Margin="0 8 0 0" />
                        <TextBox Grid.Row="5" Grid.Column="1" Style="{StaticResource SelectableText}" Margin="0 8 0 0">
                            <TextBox.Text>
                                <Binding Path="Status" Converter="{StaticResource StatusToDisplayConverter}" />
                            </TextBox.Text>
                        </TextBox>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="{Binding DetailDetected, Source={StaticResource Loc}}" FontWeight="SemiBold" Margin="0 8 0 0" />
                        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding LocalDetectedAt, Mode=OneWay, StringFormat='{}{0:g}'}" Style="{StaticResource SelectableText}" Margin="0 8 0 0" />

                        <TextBlock Grid.Row="7" Grid.Column="0" Text="{Binding DetailDelay, Source={StaticResource Loc}}" FontWeight="SemiBold" Margin="0 8 0 0"
                                   Visibility="{Binding Status, Converter={StaticResource StatusToVisibilityConverter}, ConverterParameter=Delayed}" />
                        <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding DelaySeconds, StringFormat='{}{0} сек.'}" Style="{StaticResource SelectableText}" Margin="0 8 0 0"
                                 Visibility="{Binding Status, Converter={StaticResource StatusToVisibilityConverter}, ConverterParameter=Delayed}" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!-- AI-рейтинг и ручной выбор звёзд -->
            <ui:Card Margin="0 0 0 12" Padding="12">
                <StackPanel>
                    <DockPanel Margin="0 0 0 8">
                        <TextBlock Text="Оценка безопасности и рейтинг" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Border x:Name="BadgeRatingOrigin" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                Background="{ui:ThemeResource CardBackgroundFillColorSecondaryBrush}">
                            <TextBlock x:Name="TxtRatingOrigin" Text="AI-оценка" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>
                    </DockPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Текущие звёзды + селектор ручной установки 1-5 звёзд -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Рейтинг:" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtStarsDisplay"
                                       Text="{Binding AiRating, Converter={StaticResource RatingToStarsConverter}}"
                                       Foreground="{Binding AiRating, Converter={StaticResource RatingToColorConverter}}"
                                       FontWeight="Bold" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0" />

                            <!-- Интерактивные кнопки ручного выбора 1..5 звёзд -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="Установить вручную:" FontSize="11" Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <Button Content="1★" Tag="1" Width="30" Height="24" Padding="0" Margin="1,0" FontSize="11" Click="OnStarClick" Cursor="Hand" ToolTip="1 звезда: Опасное / нежелательное ПО (риск высокий)" />
                                <Button Content="2★" Tag="2" Width="30" Height="24" Padding="0" Margin="1,0" FontSize="11" Click="OnStarClick" Cursor="Hand" ToolTip="2 звезды: Подозрительное ПО / повышенный риск" />
                                <Button Content="3★" Tag="3" Width="30" Height="24" Padding="0" Margin="1,0" FontSize="11" Click="OnStarClick" Cursor="Hand" ToolTip="3 звезды: Нейтральное ПО / средний риск" />
                                <Button Content="4★" Tag="4" Width="30" Height="24" Padding="0" Margin="1,0" FontSize="11" Click="OnStarClick" Cursor="Hand" ToolTip="4 звезды: Безопасное известное ПО" />
                                <Button Content="5★" Tag="5" Width="30" Height="24" Padding="0" Margin="1,0" FontSize="11" FontWeight="SemiBold" Foreground="#10B981" Click="OnStarClick" Cursor="Hand" ToolTip="5 звёзд: Полностью доверенное ПО / собственный скрипт" />
                            </StackPanel>

                            <Button x:Name="BtnResetUserRating" Content="Сбросить к AI" Height="24" Padding="8,2" FontSize="11"
                                    Click="OnResetUserRatingClick" Margin="4,0,0,0" ToolTip="Сбросить ручную оценку и вернуть автоматический вердикт нейросети" />
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Категория:" FontWeight="SemiBold" Margin="0 8 0 0" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding AiCategory}" Style="{StaticResource SelectableText}" Margin="0 8 0 0" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Риск:" FontWeight="SemiBold" Margin="0 8 0 0" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding AiRisk}" Style="{StaticResource SelectableText}" Margin="0 8 0 0" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Рекомендация:" FontWeight="SemiBold" Margin="0 8 0 0" />
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding AiRecommendation}" Style="{StaticResource SelectableText}" Margin="0 8 0 0" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!-- Kaspersky OpenTIP -->
            <ui:Card Margin="0 0 0 12" Padding="12">
                <StackPanel>
                    <DockPanel Margin="0 0 0 8">
                        <TextBlock Text="Kaspersky OpenTIP" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <ui:Button Content="{Binding BtnCheckKaspersky, Source={StaticResource Loc}}"
                                   Click="OnScanKasperskyClick"
                                   Appearance="Secondary"
                                   Padding="10 4"
                                   HorizontalAlignment="Right" />
                    </DockPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Вердикт:" FontWeight="SemiBold" />
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 Text="{Binding KasperskyZone, Converter={StaticResource KasperskyIndicatorConverter}}"
                                 Foreground="{Binding KasperskyZone, Converter={StaticResource KasperskyColorConverter}}"
                                 Style="{StaticResource SelectableText}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Детект:" FontWeight="SemiBold" Margin="0 8 0 0" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding KasperskyDetection}" Style="{StaticResource SelectableText}" Margin="0 8 0 0" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Статус:" FontWeight="SemiBold" Margin="0 8 0 0" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding KasperskyFileStatus}" Style="{StaticResource SelectableText}" Margin="0 8 0 0" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!-- Эвристический анализ командной строки (CLI Threats) -->
            <ui:Card Margin="0 0 0 12" Padding="12" Visibility="{Binding HasThreat, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0 0 0 8">
                        <ui:SymbolIcon Symbol="Warning24" 
                                       Foreground="{Binding ThreatInfo.ThreatLevel, Converter={StaticResource ThreatLevelToForegroundConverter}}" 
                                       Margin="0 0 8 0" VerticalAlignment="Center" />
                        <TextBlock Text="CLI Эвристика" FontSize="16" FontWeight="SemiBold" 
                                   Foreground="{Binding ThreatInfo.ThreatLevel, Converter={StaticResource ThreatLevelToForegroundConverter}}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Угроза:" FontWeight="SemiBold" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ThreatInfo.BadgeText}" 
                                 Foreground="{Binding ThreatInfo.ThreatLevel, Converter={StaticResource ThreatLevelToForegroundConverter}}"
                                 FontWeight="Bold" Style="{StaticResource SelectableText}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Описание:" FontWeight="SemiBold" Margin="0 8 0 0" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ThreatInfo.Description}" Style="{StaticResource SelectableText}" Margin="0 8 0 0" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Индикаторы:" FontWeight="SemiBold" Margin="0 8 0 0" />
                        <ItemsControl Grid.Row="2" Grid.Column="1" ItemsSource="{Binding ThreatInfo.Indicators}" Margin="0 8 0 0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat='• {0}'}" FontSize="11" Foreground="#F87171" Margin="0 2" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!-- SHA256 -->
            <ui:Card Padding="12" Margin="0 0 0 12">
                <StackPanel>
                    <TextBlock Text="Хеш" FontSize="16" FontWeight="SemiBold" Margin="0 0 0 8" />
                    <TextBox Text="{Binding SHA256}" FontSize="11" Opacity="0.6" Style="{StaticResource SelectableText}" />
                </StackPanel>
            </ui:Card>
        </StackPanel>
        </ScrollViewer>

        <!-- Кнопки (WrapPanel — переносятся на вторую строку, не обрезаются) -->
        <WrapPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 8 0 0">
                <Button x:Name="BtnRefreshAi" Content="{Binding DetailRefreshAi, Source={StaticResource Loc}}" Width="150" Height="32" Click="OnRefreshRatingClick" Margin="0 0 8 8" />
                <Button Content="{Binding CtxOpenFileLocation, Source={StaticResource Loc}}" Width="170" Height="32" Click="OnOpenLocationClick" Margin="0 0 8 8" />
                <Button Content="{Binding CtxCopyPath, Source={StaticResource Loc}}" Width="140" Height="32" Click="OnCopyPathClick" Margin="0 0 8 8" />
                <Button Content="{Binding CtxBlock, Source={StaticResource Loc}}" Width="140" Height="32" Click="OnBlockClick"
                        Visibility="{Binding Status, Converter={StaticResource StatusToVisibilityConverter}, ConverterParameter=!Blocked}"
                        Margin="0 0 8 8" />
                <Button Content="{Binding ToggleDisable, Source={StaticResource Loc}}" Width="120" Height="32" Click="OnDisableClick"
                        Visibility="{Binding Status, Converter={StaticResource StatusToVisibilityConverter}, ConverterParameter=Enabled}"
                        Margin="0 0 8 8" />
                <Button Content="{Binding DetailDelay30s, Source={StaticResource Loc}}" Width="135" Height="32" Click="OnSetDelayClick"
                        Visibility="{Binding Status, Converter={StaticResource StatusToVisibilityConverter}, ConverterParameter=Enabled}"
                        Margin="0 0 8 8" />
                <Button Content="{Binding ToggleEnable, Source={StaticResource Loc}}" Width="110" Height="32" Click="OnEnableClick"
                        Visibility="{Binding Status, Converter={StaticResource StatusToVisibilityConverter}, ConverterParameter=Disabled}"
                        Margin="0 0 8 8" />
                <Button Content="{Binding CtxCancelDelay, Source={StaticResource Loc}}" Width="150" Height="32" Click="OnCancelDelayClick"
                        Visibility="{Binding Status, Converter={StaticResource StatusToVisibilityConverter}, ConverterParameter=Delayed}"
                        Margin="0 0 8 8" />
                <Button Content="{Binding CtxLaunchNow, Source={StaticResource Loc}}" Width="140" Height="32" Click="OnLaunchNowClick"
                        Visibility="{Binding Status, Converter={StaticResource StatusToVisibilityConverter}, ConverterParameter=Delayed}"
                        Margin="0 0 8 8" />
                <Button Content="{Binding ToggleUnblock, Source={StaticResource Loc}}" Width="140" Height="32" Click="OnUnblockClick"
                        Visibility="{Binding Status, Converter={StaticResource StatusToVisibilityConverter}, ConverterParameter=Blocked}"
                        Margin="0 0 8 8" />
                <Button Content="{Binding CtxRemoveFromSystem, Source={StaticResource Loc}}" Width="150" Height="32" Click="OnRemoveClick"
                         Foreground="#E81123" Margin="0 0 8 8" />
                <Button Content="{Binding SnapBtnClose, Source={StaticResource Loc}}" Width="100" Height="32" Click="OnCloseClick" Margin="0 0 0 8" />
            </WrapPanel>
    </Grid>
</ui:FluentWindow>
