<ui:FluentWindow
    x:Class="StartupMonitor.UI.Views.Dialogs.PortDefenderConfigWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{Binding PortDefenderTitle, Source={StaticResource Loc}}"
    WindowStartupLocation="CenterOwner"
    Background="{ui:ThemeResource ApplicationBackgroundBrush}"
    ExtendsContentIntoTitleBar="True"
    ShowInTaskbar="False"
    Width="560" Height="640"
    MinHeight="520" MinWidth="480">

    <Grid Margin="16,0,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TitleBar -->
        <ui:TitleBar Grid.Row="0" Title="{Binding PortDefenderTitle, Source={StaticResource Loc}}" ShowMinimize="False" ShowMaximize="False" ShowClose="True" />

        <!-- Заголовок -->
        <ui:Card Grid.Row="1" Margin="0,4,0,12" Padding="14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="40" Height="40" CornerRadius="8" Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Shield24" FontSize="20" Foreground="{ui:ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding PortDefenderTitle, Source={StaticResource Loc}}" FontSize="16" FontWeight="SemiBold" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="{Binding PortDefenderSubtitle, Source={StaticResource Loc}}" FontSize="12" Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </ui:Card>

        <!-- Форма настроек -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <CheckBox x:Name="ChkEnabled" Content="{Binding PortDefenderEnabledToggle, Source={StaticResource Loc}}" IsChecked="True" Margin="0,0,0,12" FontWeight="SemiBold" />

                <TextBlock Text="{Binding PortDefenderProtectedPortsLabel, Source={StaticResource Loc}}" FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                <ui:TextBox x:Name="TxtProtectedPorts" PlaceholderText="{Binding PortDefenderPortsHint, Source={StaticResource Loc}}" Margin="0,0,0,12"
                            ToolTip="{Binding PortDefenderProtectedPortsTooltip, Source={StaticResource Loc}}" />

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding PortDefenderThresholdLabel, Source={StaticResource Loc}}" FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                        <ui:TextBox x:Name="TxtMaxAttempts" PlaceholderText="10"
                                    ToolTip="{Binding PortDefenderThresholdTooltip, Source={StaticResource Loc}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{Binding PortDefenderWindowLabel, Source={StaticResource Loc}}" FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                        <ui:TextBox x:Name="TxtWindowSeconds" PlaceholderText="60"
                                    ToolTip="{Binding PortDefenderWindowTooltip, Source={StaticResource Loc}}" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding PortDefenderBanDurationLabel, Source={StaticResource Loc}}" FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                <ui:TextBox x:Name="TxtBanDuration" PlaceholderText="15" Margin="0,0,0,12"
                            ToolTip="{Binding PortDefenderBanDurationTooltip, Source={StaticResource Loc}}" />

                <CheckBox x:Name="ChkAutoEscalate" Content="{Binding PortDefenderAutoEscalateToggle, Source={StaticResource Loc}}" IsChecked="True" Margin="0,0,0,8" />
                <CheckBox x:Name="ChkTrustPrivate" Content="{Binding PortDefenderTrustPrivateToggle, Source={StaticResource Loc}}" IsChecked="True" Margin="0,0,0,12" />

                <TextBlock Text="{Binding PortDefenderWhitelistLabel, Source={StaticResource Loc}}" FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                <ui:TextBox x:Name="TxtWhitelist" PlaceholderText="{Binding PortDefenderWhitelistHint, Source={StaticResource Loc}}" TextWrapping="Wrap" MinHeight="60" Margin="0,0,0,12"
                            ToolTip="{Binding PortDefenderWhitelistTooltip, Source={StaticResource Loc}}" />

                <TextBlock x:Name="TxtStatus" Text="{Binding NetStatusLoading, Source={StaticResource Loc}}" FontSize="12" Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <!-- Кнопки -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:Button Grid.Column="1" Appearance="Secondary" Content="{Binding PortDefenderCloseButton, Source={StaticResource Loc}}" Click="OnCancelClick" Margin="0,0,8,0" MinWidth="100" />
            <ui:Button Grid.Column="2" Appearance="Primary" Content="{Binding PortDefenderSaveButton, Source={StaticResource Loc}}" Click="OnSaveClick" MinWidth="120" />
        </Grid>
    </Grid>
</ui:FluentWindow>
