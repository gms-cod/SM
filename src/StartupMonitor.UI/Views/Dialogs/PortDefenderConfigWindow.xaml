<ui:FluentWindow
    x:Class="StartupMonitor.UI.Views.Dialogs.PortDefenderConfigWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Port Defender — защита портов"
    WindowStartupLocation="CenterOwner"
    Background="{ui:ThemeResource ApplicationBackgroundBrush}"
    ExtendsContentIntoTitleBar="True"
    ShowInTaskbar="False"
    Width="560" Height="640"
    MinHeight="520" MinWidth="480">

    <Grid Margin="16,0,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TitleBar -->
        <ui:TitleBar Grid.Row="0" Title="Port Defender — защита портов" ShowMinimize="False" ShowMaximize="False" ShowClose="True" />

        <!-- Заголовок -->
        <ui:Card Grid.Row="1" Margin="0,4,0,12" Padding="14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="40" Height="40" CornerRadius="8" Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Shield24" FontSize="20" Foreground="{ui:ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Port Defender" FontSize="16" FontWeight="SemiBold" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="Автоблокировка IP при флуде подключений (fail2ban для Windows)" FontSize="12" Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </ui:Card>

        <!-- Форма настроек -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <CheckBox x:Name="ChkEnabled" Content="Защита портов активна" IsChecked="True" Margin="0,0,0,12" FontWeight="SemiBold" />

                <TextBlock Text="Защищаемые порты (через запятую)" FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                <ui:TextBox x:Name="TxtProtectedPorts" PlaceholderText="Например: 3389, 22, 445" Margin="0,0,0,12" />

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Макс. подключений" FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                        <ui:TextBox x:Name="TxtMaxAttempts" PlaceholderText="10" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Окно (секунды)" FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                        <ui:TextBox x:Name="TxtWindowSeconds" PlaceholderText="60" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Длительность бана (минут, 0 = навсегда)" FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                <ui:TextBox x:Name="TxtBanDuration" PlaceholderText="15" Margin="0,0,0,12" />

                <CheckBox x:Name="ChkAutoEscalate" Content="Эскалация срока при повторных атаках" IsChecked="True" Margin="0,0,0,8" />
                <CheckBox x:Name="ChkTrustPrivate" Content="Доверять частным сетям (RFC 1918, не банить локальные адреса)" IsChecked="True" Margin="0,0,0,12" />

                <TextBlock Text="Белый список IP / подсетей (через запятую или с новой строки)" FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                <ui:TextBox x:Name="TxtWhitelist" PlaceholderText="Например: 192.168.1.10, 10.0.0.0/24" TextWrapping="Wrap" MinHeight="60" Margin="0,0,0,12" />

                <TextBlock x:Name="TxtStatus" Text="Загрузка конфигурации..." FontSize="12" Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <!-- Кнопки -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:Button Grid.Column="1" Appearance="Secondary" Content="Отмена" Click="OnCancelClick" Margin="0,0,8,0" MinWidth="100" />
            <ui:Button Grid.Column="2" Appearance="Primary" Content="Сохранить" Click="OnSaveClick" MinWidth="120" />
        </Grid>
    </Grid>
</ui:FluentWindow>
