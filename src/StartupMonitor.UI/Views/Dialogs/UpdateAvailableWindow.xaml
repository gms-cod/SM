<ui:FluentWindow
    x:Class="StartupMonitor.UI.Views.Dialogs.UpdateAvailableWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:services="clr-namespace:StartupMonitor.UI.Services"
    Title="{Binding UpdateDialogTitle, Source={x:Static services:LocalizationService.Instance}}"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource WindowBackgroundBrush}"
    ExtendsContentIntoTitleBar="True"
    ShowInTaskbar="False"
    Width="640" Height="540"
    MinHeight="460" MinWidth="520">

    <Grid Margin="20,0,20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TitleBar -->
        <ui:TitleBar Grid.Row="0" Title="{Binding UpdateDialogTitle, Source={x:Static services:LocalizationService.Instance}}"
                     ShowMinimize="False" ShowMaximize="False" ShowClose="True" />

        <!-- Заголовок релиза -->
        <Grid Grid.Row="1" Margin="4,4,4,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Background="#1E3A8A" Margin="0,0,14,0" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="24" Foreground="#60A5FA" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtNewVersion" Text="Startup Monitor v1.2.3"
                               FontSize="20" FontWeight="Bold" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                    <Border Background="#059669" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="NEW" FontSize="10" FontWeight="Bold" Foreground="White" />
                    </Border>
                </StackPanel>

                <TextBlock x:Name="TxtSubtitle" Text="Опубликовано: 09.10.2026 • Текущая версия: v1.2.2"
                           FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <!-- Блок списка изменений (Changelog) -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" 
                BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Padding="14,12" Margin="4,0,4,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{Binding UpdateChangelogLabel, Source={x:Static services:LocalizationService.Instance}}"
                           FontSize="13" FontWeight="SemiBold" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" Margin="0,0,0,8" />

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBox x:Name="TxtChangelog" IsReadOnly="True" TextWrapping="Wrap"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                             FontSize="12" Padding="0"
                             FontFamily="Segoe UI, Consolas" />
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Блок прогресса скачивания (скрыт по умолчанию) -->
        <StackPanel Grid.Row="3" x:Name="DownloadProgressPanel" Visibility="Collapsed" Margin="4,0,4,14">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtProgressStatus" Text="Загрузка обновления..."
                           FontSize="12" FontWeight="500" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock Grid.Column="1" x:Name="TxtProgressPercent" Text="0%"
                           FontSize="12" FontWeight="SemiBold" Foreground="{ui:ThemeResource SystemAccentColorPrimaryBrush}" />
            </Grid>
            <ProgressBar x:Name="ProgressBarDownload" Height="6" Minimum="0" Maximum="100" Value="0"
                         Foreground="{ui:ThemeResource SystemAccentColorPrimaryBrush}" />
        </StackPanel>

        <!-- Нижняя панель действий -->
        <Grid Grid.Row="4" Margin="4,2,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Пропустить эту версию -->
            <ui:Button Grid.Column="0" Appearance="Secondary"
                       Content="{Binding SkipVersionButton, Source={x:Static services:LocalizationService.Instance}}"
                       Click="OnSkipVersionClick" Padding="12,7" />

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <!-- Напомнить позже -->
                <ui:Button Appearance="Secondary"
                           Content="{Binding RemindLaterButton, Source={x:Static services:LocalizationService.Instance}}"
                           Click="OnRemindLaterClick" Margin="0,0,10,0" Padding="14,7" />

                <!-- Обновить сейчас -->
                <ui:Button x:Name="BtnUpdateAction" Appearance="Primary"
                           Content="{Binding UpdateNowButton, Source={x:Static services:LocalizationService.Instance}}"
                           Click="OnUpdateActionClick" Padding="18,7" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
