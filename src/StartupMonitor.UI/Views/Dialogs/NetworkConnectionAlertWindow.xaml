<Window
    x:Class="StartupMonitor.UI.Views.Dialogs.NetworkConnectionAlertWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{Binding NetAlertTitle, Source={StaticResource Loc}}"
    Width="490"
    MinWidth="320"
    MaxWidth="560"
    SizeToContent="Height"
    MinHeight="220"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    Topmost="True"
    ShowInTaskbar="False"
    ShowActivated="False"
    Focusable="False"
    ResizeMode="NoResize"
    WindowStartupLocation="Manual"
    Opacity="0">

    <!--
        Корневой контейнер с тенью и адаптивной разметкой:
        * Row 0 (*)    — общая прокручиваемая информация и ответ ИИ;
        * Row 1 (Auto) — FooterPanel: закрепленные снизу таймер, 5 кнопок действий и прогресс-бар.
        При малой рабочей области прокручивается вся информация, поэтому верхняя панель
        не вытесняет кнопки действий за нижний край окна.
        Нижняя кромка окна зафиксирована над панелью задач (Bottom-Anchoring),
        поэтому при росте карточки ИИ координаты кнопок на экране не меняются.
    -->
    <Border x:Name="RootBorder"
        Margin="12"
        CornerRadius="14"
        Background="{DynamicResource WindowBackgroundBrush}"
        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        Padding="16,14,16,12">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="24"
                ShadowDepth="4"
                Opacity="0.45"
                Color="Black" />
        </Border.Effect>

        <Grid Background="{DynamicResource WindowBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Общая область прокрутки ограничивает сведения и ИИ доступной высотой над кнопками. -->
            <ScrollViewer x:Name="ContentScrollViewer" Grid.Row="0"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False" Focusable="False">
                <StackPanel>
            <StackPanel x:Name="UpperPanel">
                <!-- Заголовок: иконка щита/сети, текст, кнопка закрытия -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                            Background="{ui:ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            Margin="0,0,10,0" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Shield24" FontSize="18"
                                       Foreground="{ui:ThemeResource AccentTextFillColorPrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Grid.Column="1" Text="{Binding NetAlertTitle, Source={StaticResource Loc}}"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                               VerticalAlignment="Center" TextWrapping="Wrap" />

                    <ui:Button x:Name="BtnClose" Grid.Column="2"
                               Appearance="Transparent"
                               Content="✕"
                               FontSize="12" FontWeight="Bold"
                               Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                               Padding="8,4" Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Focusable="False"
                               Click="OnCloseClick"
                               ToolTip="{Binding NetAlertCloseTip, Source={StaticResource Loc}}" />
                </Grid>

                <!-- Строка процесса: иконка приложения, имя, PID, путь -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                            Background="{ui:ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            Margin="0,0,10,0" VerticalAlignment="Top">
                        <ui:SymbolIcon Symbol="AppGeneric24" FontSize="18"
                                       Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtProcessName"
                                       FontSize="14" FontWeight="Bold"
                                       Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                                       Margin="0,0,8,0" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <Border Background="{ui:ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtProcessPid"
                                           FontSize="11"
                                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="TxtProcessPath"
                                   FontSize="11"
                                   Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>

                <!-- Строка адреса: флаг страны, IP:порт, протокол -->
                <Border Margin="0,0,0,10" Padding="10,8"
                        CornerRadius="8"
                        Background="{ui:ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="TxtCountryFlag" Grid.Column="0" Text="🌐"
                                   FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtRemoteEndpoint"
                                       FontFamily="Consolas, Segoe UI" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="TxtCountryName"
                                       FontSize="11"
                                       Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>

                        <Border Grid.Column="2" CornerRadius="4" Padding="8,3"
                                Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock x:Name="TxtProtocol" Text="TCP"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="{ui:ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Карточка вердикта ИИ: назначение, риски блокировки, рекомендация -->
            <Border x:Name="AiCardBorder" Margin="0,0,0,10" Padding="12,10"
                    CornerRadius="8"
                    Background="{ui:ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid>
                    <!-- Индикатор анализа программы нейросетью -->
                    <StackPanel x:Name="AiLoadingPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4" Visibility="Visible">
                        <ui:ProgressRing Width="18" Height="18" IsIndeterminate="True" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding NetAlertAiAnalyzing, Source={StaticResource Loc}}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Развёрнутый вердикт нейросети внутри AiScrollViewer с динамическим MaxHeight -->
                    <ScrollViewer x:Name="AiScrollViewer"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Focusable="False"
                                  Padding="0,0,4,0">
                        <StackPanel x:Name="AiContentPanel">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#0284C7" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding NetAlertAiVerdictBadge, Source={StaticResource Loc}}"
                                               FontSize="11" FontWeight="Bold" Foreground="White" />
                                </Border>
                                <TextBlock x:Name="TxtAiRecommendedAction" Grid.Column="1"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>

                            <!-- Назначение программы -->
                            <TextBlock Text="{Binding NetAlertAiPurposeLabel, Source={StaticResource Loc}}"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0,2,0,1" />
                            <TextBlock x:Name="TxtAiPurpose"
                                       FontSize="11" LineHeight="15"
                                       Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,6" />

                            <!-- Риски блокировки -->
                            <TextBlock Text="{Binding NetAlertAiRiskLabel, Source={StaticResource Loc}}"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="#F59E0B" Margin="0,0,0,1" />
                            <TextBlock x:Name="TxtAiBlockingRisk"
                                       FontSize="11" LineHeight="15"
                                       Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,6" />

                            <!-- Рекомендация ИИ -->
                            <TextBlock Text="{Binding NetAlertAiRecommendationLabel, Source={StaticResource Loc}}"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="#10B981" Margin="0,0,0,1" />
                            <TextBlock x:Name="TxtAiRecommendation"
                                       FontSize="11" LineHeight="15" FontWeight="SemiBold"
                                       Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Закреплённый снизу футер: таймер, кнопки действий и прогресс-бар -->
            <ScrollViewer x:Name="FooterScrollViewer" Grid.Row="1"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False" Focusable="False">
            <StackPanel x:Name="FooterPanel">
                <TextBlock x:Name="TxtCountdown"
                           FontSize="11"
                           Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                           Margin="0,0,0,6"
                           TextWrapping="Wrap" />

                <!-- 5 эргономичных кнопок действий в компактной сетке 2x2 + 1 -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 1. Белый список (Всегда разрешать) -->
                    <ui:Button x:Name="BtnWhitelist"
                               Grid.Row="0" Grid.Column="0"
                               Appearance="Primary"
                               Background="#0284C7" BorderBrush="#0369A1" Foreground="White"
                               Content="{Binding NetAlertBtnWhitelist, Source={StaticResource Loc}}"
                               HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                               Padding="8,7" Margin="0,0,4,6"
                               Focusable="False"
                               Click="OnWhitelistClick"
                               ToolTip="{Binding NetAlertWhitelistTip, Source={StaticResource Loc}}" />

                    <!-- 2. Чёрный список (Всегда блокировать) -->
                    <ui:Button x:Name="BtnBlockAlways"
                               Grid.Row="0" Grid.Column="1"
                               Appearance="Danger"
                               Background="#DC2626" BorderBrush="#B91C1C" Foreground="White"
                               Content="{Binding NetAlertBtnBlock, Source={StaticResource Loc}}"
                               HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                               Padding="8,7" Margin="4,0,0,6"
                               Focusable="False"
                               Click="OnBlockAlwaysClick"
                               ToolTip="{Binding NetAlertBlockTip, Source={StaticResource Loc}}" />

                    <!-- 3. Разрешить на текущую сессию -->
                    <ui:Button x:Name="BtnAllowSession"
                               Grid.Row="1" Grid.Column="0"
                               Appearance="Secondary"
                               Content="{Binding NetAlertBtnAllowSession, Source={StaticResource Loc}}"
                               HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                               Padding="8,7" Margin="0,0,4,6"
                               Focusable="False"
                               Click="OnAllowSessionClick"
                               ToolTip="{Binding NetAlertAllowSessionTip, Source={StaticResource Loc}}" />

                    <!-- 4. Запретить на текущую сессию -->
                    <ui:Button x:Name="BtnBlockSession"
                               Grid.Row="1" Grid.Column="1"
                               Appearance="Secondary"
                               Background="#D97706" BorderBrush="#B45309" Foreground="White"
                               Content="{Binding NetAlertBtnBlockSession, Source={StaticResource Loc}}"
                               HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                               Padding="8,7" Margin="4,0,0,6"
                               Focusable="False"
                               Click="OnBlockSessionClick"
                               ToolTip="{Binding NetAlertBlockSessionTip, Source={StaticResource Loc}}" />

                    <!-- 5. Разрешить удаленный порт (на всю ширину) -->
                    <ui:Button x:Name="BtnAllowPort"
                               Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                               Appearance="Secondary"
                               Content="{Binding NetAlertBtnAllowPort, Source={StaticResource Loc}}"
                               HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                               Padding="8,6"
                               Focusable="False"
                               Click="OnAllowPortClick"
                               ToolTip="{Binding NetAlertAllowPortTip, Source={StaticResource Loc}}" />
                </Grid>

                <!-- Тонкий ProgressBar обратного отсчета -->
                <ProgressBar x:Name="CountdownBar"
                             Height="4" Minimum="0" Maximum="30" Value="30"
                             Background="Transparent"
                             Foreground="{ui:ThemeResource SystemAccentColorPrimaryBrush}"
                             BorderThickness="0" />
            </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
