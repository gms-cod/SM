<ui:FluentWindow
    x:Class="StartupMonitor.UI.Views.Dialogs.ProcessConnectionsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:services="clr-namespace:StartupMonitor.UI.Services"
    Title="Сетевые соединения процесса"
    WindowStartupLocation="CenterOwner"
    Background="{ui:ThemeResource ApplicationBackgroundBrush}"
    ExtendsContentIntoTitleBar="True"
    ShowInTaskbar="False"
    Width="920" Height="620"
    MinHeight="450" MinWidth="700">

    <Grid Margin="16,0,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TitleBar -->
        <ui:TitleBar Grid.Row="0" Title="{Binding WindowTitle, RelativeSource={RelativeSource AncestorType=Window}}" ShowMinimize="False" ShowMaximize="True" ShowClose="True" />

        <!-- Инфо-карточка процесса -->
        <ui:Card Grid.Row="1" Margin="0,4,0,12" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Иконка приложения -->
                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Globe24" FontSize="20" Foreground="{ui:ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!-- Данные процесса -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TxtProcessName" Text="ProcessName.exe" FontSize="16" FontWeight="SemiBold" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" Margin="0,0,8,0" />
                        <Border Background="{ui:ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtProcessPid" Text="PID: 1234" FontSize="11" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="TxtExecutablePath" Text="C:\Path\to\Process.exe" FontSize="12" Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Статистика соединений -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{ui:ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,8,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Всего сокетов" FontSize="11" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="TxtTotalCount" Text="0" FontSize="14" FontWeight="Bold" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Background="{ui:ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,8,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Активные (EST)" FontSize="11" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="TxtEstablishedCount" Text="0" FontSize="14" FontWeight="Bold" Foreground="#107C41" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Background="{ui:ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="10,6">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Слушают (LIST)" FontSize="11" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="TxtListeningCount" Text="0" FontSize="14" FontWeight="Bold" Foreground="#0078D4" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ui:Card>

        <!-- Защитная карточка Port Defender -->
        <ui:Card Grid.Row="2" Margin="0,0,0,12" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Иконка щита -->
                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                    <ui:SymbolIcon x:Name="DefenderShieldIcon" Symbol="Shield24" FontSize="20" Foreground="{ui:ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!-- Статус защиты -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{ui:ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Shield24" FontSize="12" Foreground="{ui:ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBlock x:Name="TxtDefenderBadge" Text="Port Defender" FontSize="11" FontWeight="SemiBold" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="TxtDefenderStatus" Text="Port Defender: Защита портов активна" FontSize="13" FontWeight="SemiBold" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="TxtDefenderDetails" Text="Активных банов: 0" FontSize="12" Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Действия защиты -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button x:Name="BtnConfigureDefender" Appearance="Secondary" Content="Настроить Defender" Click="OnConfigureDefenderClick" Margin="0,0,8,0" />
                    <ui:Button x:Name="BtnClearBans" Appearance="Secondary" Content="Сбросить баны" Click="OnClearBansClick" />
                </StackPanel>
            </Grid>
        </ui:Card>

        <!-- Тулбар действий и поиска -->
        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Поиск по IP или порту -->
            <ui:TextBox x:Name="TxtSearch" Grid.Column="0" PlaceholderText="Поиск по IP-адресу или порту..."
                        TextChanged="OnSearchTextChanged" Margin="0,0,10,0" />

            <!-- Чекбокс автообновления -->
            <CheckBox x:Name="ChkAutoRefresh" Grid.Column="1" Content="Автообновление (2с)" IsChecked="True"
                      Checked="OnAutoRefreshChanged" Unchecked="OnAutoRefreshChanged" VerticalAlignment="Center" Margin="0,0,10,0" />

            <!-- Кнопка немедленного обновления -->
            <ui:Button x:Name="BtnRefresh" Grid.Column="2" Appearance="Secondary" Content="Обновить" Click="OnRefreshClick" />
        </Grid>

        <!-- Таблица сетевых соединений -->
        <Grid Grid.Row="4">
            <DataGrid x:Name="GridConnections"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      IsReadOnly="True"
                      GridLinesVisibility="None"
                      HeadersVisibility="Column"
                      BorderThickness="1"
                      BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                      Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                      RowHeight="36">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Копировать удалённый IP" Click="OnCopyRemoteIpClick" />
                        <MenuItem Header="Копировать адрес:порт" Click="OnCopyRemoteEndpointClick" />
                        <Separator />
                        <MenuItem Header="Открыть Whois (IPInfo.io)" Click="OnOpenWhoisClick" />
                        <MenuItem Header="Проверить в VirusTotal" Click="OnOpenVirusTotalClick" />
                        <Separator />
                        <MenuItem Header="Заблокировать удалённый IP">
                            <MenuItem Header="На 15 минут" Click="OnBlockIp15mClick" />
                            <MenuItem Header="На 1 час" Click="OnBlockIp1hClick" />
                            <MenuItem Header="На 24 часа" Click="OnBlockIp24hClick" />
                            <MenuItem Header="Навсегда" Click="OnBlockIpForeverClick" />
                        </MenuItem>
                        <MenuItem Header="Разблокировать IP" Click="OnUnblockIpClick" />
                        <Separator />
                        <MenuItem Header="Заблокировать локальный порт для этого процесса" Click="OnBlockPortClick" />
                        <MenuItem Header="Настроить Port Defender для порта..." Click="OnConfigureDefenderForPortClick" />
                    </ContextMenu>
                </DataGrid.ContextMenu>

                <DataGrid.Columns>
                    <!-- Протокол -->
                    <DataGridTemplateColumn Header="Протокол" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{ui:ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Protocol}" FontSize="11" FontWeight="SemiBold" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Локальный сокет -->
                    <DataGridTemplateColumn Header="Локальный адрес : Порт" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LocalEndPoint}" FontFamily="Consolas, Segoe UI" FontSize="12" VerticalAlignment="Center" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Стрелка направления -->
                    <DataGridTemplateColumn Header="" Width="30">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="→" FontSize="13" Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Удалённый сокет -->
                    <DataGridTemplateColumn Header="Удалённый адрес : Порт" Width="2.5*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RemoteEndPoint}" FontFamily="Consolas, Segoe UI" FontSize="12" VerticalAlignment="Center" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Состояние сокета -->
                    <DataGridTemplateColumn Header="Состояние" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="ESTABLISHED">
                                                    <Setter Property="Background" Value="#20107C41" />
                                                    <Setter Property="BorderBrush" Value="#40107C41" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="LISTENING">
                                                    <Setter Property="Background" Value="#200078D4" />
                                                    <Setter Property="BorderBrush" Value="#400078D4" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="TIME_WAIT">
                                                    <Setter Property="Background" Value="#20FFB900" />
                                                    <Setter Property="BorderBrush" Value="#40FFB900" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="CLOSE_WAIT">
                                                    <Setter Property="Background" Value="#20D83B01" />
                                                    <Setter Property="BorderBrush" Value="#40D83B01" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding State}" FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="ESTABLISHED">
                                                        <Setter Property="Foreground" Value="#107C41" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="LISTENING">
                                                        <Setter Property="Foreground" Value="#0078D4" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="TIME_WAIT">
                                                        <Setter Property="Foreground" Value="#FFB900" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="CLOSE_WAIT">
                                                        <Setter Property="Foreground" Value="#D83B01" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Сегмент сети (Интернет / Локальная) -->
                    <DataGridTemplateColumn Header="Сегмент" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#158B5CF6" />
                                            <Setter Property="BorderBrush" Value="#308B5CF6" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRemotePrivate}" Value="True">
                                                    <Setter Property="Background" Value="{ui:ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                                                    <Setter Property="BorderBrush" Value="{ui:ThemeResource CardStrokeColorDefaultBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="11">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Интернет" />
                                                <Setter Property="Foreground" Value="#8B5CF6" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRemotePrivate}" Value="True">
                                                        <Setter Property="Text" Value="Локальный" />
                                                        <Setter Property="Foreground" Value="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Статус брандмауэра -->
                    <DataGridTemplateColumn Header="Брандмауэр" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#20107C41" />
                                            <Setter Property="BorderBrush" Value="#40107C41" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FirewallBadge}" Value="🛡️ Защищён Defender">
                                                    <Setter Property="Background" Value="#200078D4" />
                                                    <Setter Property="BorderBrush" Value="#400078D4" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding FirewallBadge}" Value="🔴 В бане">
                                                    <Setter Property="Background" Value="#20D83B01" />
                                                    <Setter Property="BorderBrush" Value="#40D83B01" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding FirewallBadge}" Value="⛔ Заблокирован">
                                                    <Setter Property="Background" Value="#20606060" />
                                                    <Setter Property="BorderBrush" Value="#40606060" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding FirewallBadge}" FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#107C41" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding FirewallBadge}" Value="🛡️ Защищён Defender">
                                                        <Setter Property="Foreground" Value="#0078D4" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding FirewallBadge}" Value="🔴 В бане">
                                                        <Setter Property="Foreground" Value="#D83B01" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding FirewallBadge}" Value="⛔ Заблокирован">
                                                        <Setter Property="Foreground" Value="#606060" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Плейсхолдер пустого списка -->
            <StackPanel x:Name="PanelEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                <ui:SymbolIcon Symbol="Shield24" FontSize="36" Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                <TextBlock Text="У данного процесса нет активных сетевых соединений" FontSize="14" FontWeight="SemiBold" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="Процесс не открывал локальных сокетов и не связывался с сетью" FontSize="12" Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <!-- Нижняя панель закрытия -->
        <Grid Grid.Row="5" Margin="0,12,0,0">
            <TextBlock x:Name="TxtStatus" Text="Готово" FontSize="12" Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
            <ui:Button Appearance="Secondary" Content="Закрыть" HorizontalAlignment="Right" Click="OnCloseClick" />
        </Grid>
    </Grid>
</ui:FluentWindow>
